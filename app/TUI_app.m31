// The application loop: raw mode in, decoded events out, a widget redrawn
// through the diffing renderer, one write per frame. This is stage 3's
// remaining piece -- `lib/term.m31` is already complete and tested; this
// module is what JOINS it to `apps/tui`'s own renderer, and nothing else.
// See `apps/git/design.md`, "the application loop joining the two".
//
// API
// ---
//   TUI_app.Action                 Continue | Redraw | Quit -- what a Handler
//                                 answers after one event
//   interface TUI_app.Handler { Action handle(term.Event ev); }
//   TUI_app.Loop(...)              tick, colour depth, enter/leave sequences
//   loop.run(view, on_event)      raw mode, then read-dispatch-render until
//                                 `on_event` says stop
//   loop.run_with(view, on_event, on_tick, on_mouse)
//                                 the same, with a timer and routed mouse gestures
//   interface TUI_app.Ticker { Action tick(int elapsed_ms); }
//   interface TUI_app.MouseHandler { Action handle_mouse(TUI_mouse.Routed routed); }
//   loop.enter_sequence() / loop.leave_sequence()   the exact bytes written in / out
//   TUI_app.read_timeout_ms(...)  how long a read may wait; TUI_app.clamp_elapsed(...)
//   TUI_app.has_resized(a, b)     whether two window sizes differ -- pulled
//                                 out so it can be checked with no terminal
//
// --- why the view is a Widget, not a new interface ---------------------------
//
// `apps/tui`'s widget protocol is already exactly "draw yourself into a
// rectangle of a buffer" (`TUI_widget.Widget`), which is the whole of what a
// frame needs from a program's state. Inventing a second drawing interface
// here would just be that one, worse -- so `run` takes an ordinary `Widget`
// for the view, and the ONE new interface this module adds is for input,
// where nothing already fits: `Handler.handle`, called once per decoded
// event, in the same one-method-interface idiom every callback in this
// language uses (reference SS6.7) and `Widget` itself already is.
//
// --- what the loop owns, and what it does not --------------------------------
//
// `run` opens raw mode with `term.raw()`, which hands back a `Session` --
// see `lib/term.m31`'s own header for why its destructor is the whole safety
// story here, trap path included; this module adds nothing on top of it and
// is not allowed to need to. The loop reads with a timeout (`tick_ms`),
// which is also what resolves a lone Escape (`term.Reader.read`'s own
// comment) and what notices a resized window, since there is no resize
// EVENT -- `term.m31` leaves that to "call `size()` again", and this is the
// thing that calls it, once a tick.
//
// A `Handler` answers one `Action` per event; the loop itself decides WHEN a
// resize also needs a redraw, and whether a redraw is a `TUI_diff.full` (a
// resize, or the very first frame) or a `TUI_diff.diff` against the previous
// one. None of this is specific to any one program: it is exactly the loop
// `examples/keys.m31` hand-writes, pulled out here so nothing built on this
// library has to write it twice.

// --- the timer and the mouse (v0.3.0) ------------------------------------------
//
// Both are opt-in, and a `Loop()` with none of them set is exactly the loop it
// was: no mouse reporting is asked for, no timer runs, `run` is `run_with`
// given a handler that ignores both.
//
// **Timer.** `animate_ms > 0` makes the loop call `on_tick.tick(elapsed_ms)`
// about that often (a spinner's `did_advance`, a clock's seconds). It does not
// poll: the read's timeout is the smaller of `tick_ms` and the time left until
// the next tick, never under one millisecond (`read_timeout_ms`), so an idle
// animated program wakes exactly when a tick is due and sleeps in the kernel
// otherwise, and a stream of key or mouse reports cannot starve the timer,
// because it is checked after every read, not only after a timeout. The clock
// is the wall clock (`date.now_ns`): m31 has no monotonic one (docs/FRICTION.md
// section 22), so an `elapsed_ms` is clamped to `MAX_ELAPSED_MS` and a clock
// that went backwards counts as zero and the timer resynchronises, instead of
// a clock change making an animation leap or freeze.
//
// **Mouse.** `should_report_mouse` writes `term.MOUSE_ON` on entry (and
// `MOUSE_OFF` on the way out); `should_report_hover` adds motion with no button
// down; `should_report_paste` adds bracketed paste, so a paste arrives as one
// `Event.Paste` instead of keystrokes. With mouse reporting on, each
// `Event.Mouse` goes to `router` (`TUI_mouse.Router`), which turns it into
// gestures and finds the region of the LAST frame under the pointer; each routed
// gesture is handed to `on_mouse`, and the answers are folded (Quit wins, then
// Redraw). `on_event` does not see mouse events then. The view registers its
// regions on the same router, in `render`:
//
//     router.begin_frame(); router.add("files", files_area); ...
//
// **Leaving.** The leave sequence, mouse and paste modes off first, goes to
// `Session.on_exit` BEFORE the enter sequence is written, so there is no window
// in which the modes are on and nothing will turn them off. It runs from the
// Session's destructor: a normal return, an error return, and the program
// ending all take it. `term` restores only the termios settings if the process
// is trapped (a panic, `os.exit`) or killed by a signal, and does not write
// `on_exit`: the mouse and alternate screen then stay on until the shell resets
// them. That is a gap in `term`, recorded in docs/FRICTION.md section 23, not
// something this module can close.

import io;
import term;
import timer;
import core.TUI_buffer;
import app.TUI_diff;
import core.TUI_mouse;
import core.TUI_style;
import core.TUI_widget;

/// What a `Handler` answers after one event: whether the loop keeps going,
/// and whether the view needs to be drawn again before the next read. Not a
/// `bool`, or an `Option` of one, because "something changed" and "time to
/// stop" are independent facts and a handler should not have to smuggle
/// "stop" through a sentinel value of the other.
pub enum Action {
    /// Nothing worth a redraw happened: a key with no meaning here, a
    /// modifier report on its own, and so on.
    Continue;
    /// State changed; redraw before the next read.
    Redraw;
    /// Stop the loop. The screen is not cleared here -- `Loop.leave`, written
    /// through the `Session` that is already unwinding, is what does that.
    Quit;
}

/// A caller's event handler: what one decoded `term.Event` does to the
/// program's own state. Called once per event, never per byte -- the
/// decoding already happened in `term.Reader`.
pub interface Handler {
    Action handle(term.Event event);
}

/// A timer callback: called about every `Loop.animate_ms`, with the
/// milliseconds since it was last called (clamped, see `clamp_elapsed`).
pub interface Ticker {
    Action tick(int elapsed_ms);
}

/// A mouse callback: one routed gesture at a time (see `TUI_mouse`).
pub interface MouseHandler {
    Action handle_mouse(TUI_mouse.Routed routed);
}

/// The `Ticker` that does nothing, for a loop with no timer.
pub type NoTicker {
    pub int unused = 0;
}

pub Action NoTicker.tick(int elapsed_ms) {
    return Action.Continue;
}

/// The `MouseHandler` that does nothing, for a loop with no mouse.
pub type NoMouse {
    pub int unused = 0;
}

pub Action NoMouse.handle_mouse(TUI_mouse.Routed routed) {
    return Action.Continue;
}

/// The longest gap `Loop` hands a `Ticker`: a suspended process or a clock set
/// forward is not a second-long frame.
pub const int MAX_ELAPSED_MS = 1000;

/// The loop's own knobs. Every field has a default, so `Loop()` is a
/// reasonable full-screen program and everything else is named.
pub type Loop {
    /// How long `Reader.read` waits for a key before coming back around to
    /// check the window size and, with nothing to read, do nothing else.
    /// 250ms matches `examples/keys.m31`: quick enough that a resize is
    /// noticed with no key pressed, slow enough to cost nothing while idle.
    pub int tick_ms = 250;
    pub TUI_style.Depth depth = TUI_style.Depth.TrueColour;
    /// Written once, entering raw mode, before the first frame.
    pub str enter = term.ALT_SCREEN_ON + term.HIDE_CURSOR;
    /// Handed to `Session.on_exit`, so it is written on every path out of
    /// `run` -- a clean `Quit`, the input ending, a read failing, a trap --
    /// not only the first of those.
    pub str leave = term.SHOW_CURSOR + term.RESET + term.ALT_SCREEN_OFF;
    /// Ask the terminal for mouse reports and route them (see the header).
    pub bool should_report_mouse = false;
    /// Also report motion with no button down (needs `should_report_mouse`).
    pub bool should_report_hover = false;
    /// Ask for bracketed paste: a paste is one `Event.Paste`.
    pub bool should_report_paste = false;
    /// Call the `Ticker` about this often; 0 never does.
    pub int animate_ms = 0;
    /// Where mouse reports are routed. Share it with the view.
    pub TUI_mouse.Router router = TUI_mouse.Router();
    /// After an event, up to this many more that have ALREADY arrived are
    /// handled before the frame is drawn, so a burst of typing, a macro's
    /// replayed keys or a paste costs one frame, not one per event. 0 draws
    /// after every event, as the loop did before.
    pub int drain_events = 512;
    /// (Off by default, like every mode here: a program asks for it.)
    /// Ask the terminal whether it does synchronized output (DEC mode 2026,
    /// DECRQM) and, when it says yes, wrap every frame in it so a frame is
    /// never seen half drawn. A terminal that does not answer gets plain frames.
    pub bool should_sync = false;
    /// Let the renderer scroll a region of the terminal (`TUI_diff.diff_scrolled`)
    /// when that is shorter than rewriting it.
    pub bool should_scroll = false;
    /// Ask for focus reports (`\e[?1004h`); `has_focus` follows them.
    pub bool should_report_focus = false;
    /// Read-only state, kept by the loop: the terminal confirmed mode 2026.
    pub bool is_sync = false;
    /// Read-only: the terminal has focus (always true without focus reports).
    pub bool has_focus = true;
    /// Read-only: while a callback runs, whether more input is already waiting,
    /// so an animation can be skipped rather than started against a queue.
    pub bool is_input_queued = false;
    /// Read-only: frames written so far, the last frame's size in bytes, and
    /// how long it took (microseconds, drawing to the end of the write).
    pub int frame_count = 0;
    pub int last_frame_bytes = 0;
    pub int last_frame_us = 0;
    /// The real terminal cursor, set by the view while it draws: `x` < 0 hides it.
    /// Shared like `router`. Without it the cursor stays hidden, as before.
    pub Cursor cursor = Cursor();
    /// Set by the program (or by a focus-in report) to have the next frame written in
    /// full, not as a difference: the way to repair a screen something else wrote
    /// on. The loop clears it after that frame.
    pub bool should_repaint = false;
    /// The program sets `cursor` (and so its shape): put the shape back on the way out.
    pub bool should_manage_cursor = false;
}

/// The bytes written on entry: `enter`, then the modes asked for.
pub str Loop.enter_sequence() {
    str modes = "";
    if (should_report_mouse) {
        modes = modes + term.MOUSE_ON;
        if (should_report_hover) {
            modes = modes + TUI_mouse.HOVER_ON;
        }
    }
    if (should_report_paste) {
        modes = modes + term.PASTE_ON;
    }
    if (should_report_focus) {
        modes = modes + "\x1b[?1004h";
    }
    if (should_sync) {
        modes = modes + TUI_diff.SYNC_QUERY;
    }
    return enter + modes;
}

/// The bytes written on the way out: the modes off (the reverse of entry), then
/// `leave`.
pub str Loop.leave_sequence() {
    str modes = "";
    if (should_report_paste) {
        modes = modes + term.PASTE_OFF;
    }
    if (should_report_mouse) {
        if (should_report_hover) {
            modes = modes + TUI_mouse.HOVER_OFF;
        }
        modes = modes + term.MOUSE_OFF;
    }
    if (should_report_focus) {
        modes = modes + "\x1b[?1004l";
    }
    if (should_manage_cursor) {
        // the cursor's shape is the user's again
        modes = modes + "\x1b[0 q";
    }
    return modes + leave;
}

/// Raw mode, then read-dispatch-render until `on_event` answers `Quit`, the
/// input ends, or reading fails. Whichever ends it, the terminal is restored
/// before this returns: `session.on_exit(leave)` runs from the `Session`'s own
/// destructor, the one exit path this function cannot fail to take.
///
/// `Err(term.Error.NotATerminal)` when standard input is not a terminal, and
/// whatever `term.raw()` itself answers otherwise. Once raw mode is entered a
/// read or write failure ends the loop rather than being reported past this
/// call -- `examples/keys.m31`'s own choice, because a terminal that has
/// stopped answering has nothing left to say beyond "stopped".
pub Result<int, term.Error> Loop.run(TUI_widget.Widget view, Handler on_event) {
    return run_with(view, on_event, NoTicker(), NoMouse());
}

/// `run`, with a timer (`animate_ms`, `on_tick`) and routed mouse gestures
/// (`should_report_mouse`, `on_mouse`); see the header.
///
/// Each pass: wait for input (or the next tick), handle everything that has
/// already arrived (`drain_events`), give the timer its turn, and only then
/// draw -- once. So input is always handled before the next animation frame, and
/// a burst of keys costs one frame. `animate_ms` and `tick_ms` are read every
/// pass, so a callback may change them (an animation asks for 16 ms while it
/// runs and gives it back).
pub Result<int, term.Error> Loop.run_with(TUI_widget.Widget view, Handler on_event, Ticker on_tick, MouseHandler on_mouse) {
    if (!term.is_terminal(0)) {
        return Result<int, term.Error>.Err(term.Error.NotATerminal);
    }
    match (term.raw()) {
        case Err(term.Error error): {
            return Result<int, term.Error>.Err(error);
        }
        case Ok(term.Session session): {
            session.on_exit(leave_sequence());
            term.Writer writer = term.writer(io.stdout());
            writer.put(enter_sequence());
            term.Reader reader = term.reader();
            term.Size window_size = screen_size();
            // Two buffers for the whole run, swapped each frame: the one
            // just shown and the one being drawn. A fresh buffer per frame
            // is three lists grown a cell at a time -- twice the cost of
            // clearing one that already exists -- and nothing about a
            // frame needs the last one's memory gone.
            TUI_buffer.Buffer previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            TUI_buffer.Buffer next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
            Shown shown = Shown();
            view.render(previous, previous.area());
            present(writer, previous, previous, true, shown);
            bool is_running = true;
            int last_tick_ms = now_ms();
            while (is_running) {
                bool should_redraw = false;
                is_input_queued = false;
                match (reader.read(read_timeout_ms(tick_ms, animate_ms, now_ms() - last_tick_ms))) {
                    case Ok(term.Input inp): {
                        match (inp) {
                            case Got(term.Event event): {
                                // This event and every one already waiting, up to a
                                // budget, before anything is drawn. One event of
                                // look-ahead says whether input is queued behind
                                // the one being handled.
                                term.Event current = event;
                                int batch_start_ms = now_ms();
                                int handled = 0;
                                bool is_more = true;
                                bool was_cut = false;
                                while (is_more && is_running) {
                                    Option<term.Event> ahead = Option<term.Event>.None;
                                    bool is_cut = true;
                                    if (should_keep_draining(handled, drain_events) && now_ms() - batch_start_ms < BATCH_MS) {
                                        ahead = read_ahead(reader);
                                        is_cut = false;
                                    }
                                    // a batch cut short by its budget leaves input behind
                                    is_input_queued = ahead.is_some() || (is_cut && drain_events > 0);
                                    was_cut = is_cut && drain_events > 0;
                                    match (dispatch(current, on_event, on_mouse)) {
                                        case Continue: {
                                        }
                                        case Redraw: {
                                            should_redraw = true;
                                        }
                                        case Quit: {
                                            is_running = false;
                                        }
                                    }
                                    handled = handled + 1;
                                    match (ahead) {
                                        case Some(term.Event more): {
                                            current = more;
                                        }
                                        case None: {
                                            is_more = false;
                                        }
                                    }
                                }
                                is_input_queued = was_cut;
                            }
                            case Timeout: {
                            }
                            case End: {
                                is_running = false;
                            }
                        }
                    }
                    case Err(term.Error error): {
                        is_running = false;
                    }
                }
                if (is_running && animate_ms > 0) {
                    int current_ms = now_ms();
                    int elapsed_ms = current_ms - last_tick_ms;
                    if (elapsed_ms < 0) {
                        // The clock went backwards: start counting again.
                        last_tick_ms = current_ms;
                    } else if (elapsed_ms >= animate_ms) {
                        last_tick_ms = current_ms;
                        match (on_tick.tick(clamp_elapsed(elapsed_ms))) {
                            case Continue: {
                            }
                            case Redraw: {
                                should_redraw = true;
                            }
                            case Quit: {
                                is_running = false;
                            }
                        }
                    }
                }
                if (is_running) {
                    term.Size now = screen_size();
                    bool did_resize = has_resized(window_size, now);
                    window_size = now;
                    if (should_redraw || did_resize || should_repaint) {
                        int started_ns = timer.monotonic_ns();
                        if (did_resize) {
                            // A resize is the one time the buffers are
                            // replaced: the old pair is the wrong shape.
                            next = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                            previous = TUI_buffer.Buffer.sized(window_size.columns, window_size.rows);
                        } else {
                            next.clear();
                        }
                        view.render(next, next.area());
                        present(writer, previous, next, did_resize || should_repaint, shown);
                        should_repaint = false;
                        last_frame_us = (timer.monotonic_ns() - started_ns) / 1000;
                        TUI_buffer.Buffer shown_buffer = previous;
                        previous = next;
                        next = shown_buffer;
                    }
                }
            }
        }
    }
    return Result<int, term.Error>.Ok(0);
}

// Draw one frame: `next` against `previous` (or all of it), the cursor, and
// the synchronized-output markers, as ONE write. Nothing is written for a frame
// that changes nothing.
void Loop.present(term.Writer writer, TUI_buffer.Buffer previous, TUI_buffer.Buffer next, bool is_full, Shown shown) {
    bytes body = [];
    if (is_full) {
        body = TUI_diff.full(next, depth);
    } else if (should_scroll) {
        body = TUI_diff.diff_scrolled_in_place(previous, next, depth);
    } else {
        body = TUI_diff.diff(previous, next, depth);
    }
    bool is_cursor_wanted = cursor.x >= 0 && cursor.y >= 0;
    bool did_cursor_change = is_cursor_wanted != shown.is_visible || (is_cursor_wanted && (cursor.x != shown.x || cursor.y != shown.y || cursor.shape != shown.shape));
    if (body.size() == 0 && !did_cursor_change) {
        last_frame_bytes = 0;
        return;
    }
    bytes out = [];
    if (is_sync) {
        out.extend(TUI_diff.SYNC_BEGIN.to_bytes);
    }
    if (shown.is_visible && (body.size() > 0 || !is_cursor_wanted)) {
        // never see the cursor wander while the frame is drawn
        TUI_diff.hide_cursor(out);
        shown.is_visible = false;
    }
    out.extend(body);
    if (is_cursor_wanted) {
        if (cursor.shape != shown.shape) {
            TUI_style.push_csi(out);
            TUI_style.push_int(out, cursor.shape);
            out.push(' ');
            out.push('q');
            shown.shape = cursor.shape;
        }
        TUI_diff.move_to(out, cursor.x, cursor.y);
        if (!shown.is_visible) {
            TUI_diff.show_cursor(out);
            shown.is_visible = true;
        }
        shown.x = cursor.x;
        shown.y = cursor.y;
    }
    if (is_sync) {
        out.extend(TUI_diff.SYNC_END.to_bytes);
    }
    last_frame_bytes = out.size();
    frame_count = frame_count + 1;
    writer.put_bytes(out);
    flush(writer);
}

// One decoded event to the right callback: a mouse report to the router (when
// mouse reporting is on), everything else to `on_event`.
Action Loop.dispatch(term.Event event, Handler on_event, MouseHandler on_mouse) {
    match (event) {
        case Mouse(term.Mouse report): {
            if (should_report_mouse) {
                Action answer = Action.Continue;
                for (TUI_mouse.Routed routed in router.route(report, now_ms())) {
                    answer = fold(answer, on_mouse.handle_mouse(routed));
                }
                return answer;
            }
            return on_event.handle(event);
        }
        case Key(term.Key key): {
            return on_event.handle(event);
        }
        case Paste(str text): {
            return on_event.handle(event);
        }
        case Unknown(bytes raw): {
            int reply = TUI_diff.sync_reply(raw);
            if (reply >= 0) {
                // the answer to the mode 2026 question: the loop's own business
                is_sync = reply == 1 && should_sync;
                return Action.Continue;
            }
            if (should_report_focus && raw.size() == 3 && raw[0] == 27 && raw[1] == '[' && (raw[2] == 'I' || raw[2] == 'O')) {
                has_focus = raw[2] == 'I';
                if (has_focus) {
                    // the terminal may have been drawn on while it was away
                    should_repaint = true;
                }
                return Action.Redraw;
            }
            return on_event.handle(event);
        }
    }
}

/// Where the terminal's own cursor should be after a frame, and its shape:
/// 0 the terminal's default, 1 / 2 block (blinking / steady), 3 / 4 underline,
/// 5 / 6 bar (DECSCUSR). `x` < 0 means hidden.
pub type Cursor {
    pub int x = -1;
    pub int y = -1;
    pub int shape = 0;
}

/// What the loop has already told the terminal about the cursor.
type Shown {
    int x = -1;
    int y = -1;
    int shape = -1;
    bool is_visible = false;
}

/// How long one pass may keep handling already-arrived events before it
/// draws, whatever `drain_events` allows: a storm of input still gets frames.
const int BATCH_MS = 8;

// The next event if one has already arrived; never waits.
Option<term.Event> read_ahead(term.Reader reader) {
    match (reader.read(0)) {
        case Ok(term.Input inp): {
            match (inp) {
                case Got(term.Event event): {
                    return Option<term.Event>.Some(event);
                }
                case Timeout: {
                }
                case End: {
                }
            }
        }
        case Err(term.Error error): {
        }
    }
    return Option<term.Event>.None;
}

/// How long a read may wait, in milliseconds: `tick_ms`, or less when a timer
/// tick is due sooner (`animate_ms` > 0, `since_tick_ms` since the last one),
/// and never under 1, so a tick that is already late is a poll, not a hang.
pub int read_timeout_ms(int tick_ms, int animate_ms, int since_tick_ms) {
    int wait = tick_ms;
    if (animate_ms > 0) {
        int until_tick = animate_ms - since_tick_ms;
        if (until_tick < wait) {
            wait = until_tick;
        }
    }
    if (wait < 1) {
        return 1;
    }
    return wait;
}

/// Whether the loop may take one more already-arrived event before drawing:
/// fewer than `limit` so far, and a limit above 0.
pub bool should_keep_draining(int drained, int limit) {
    return limit > 0 && drained < limit;
}

/// An elapsed time made safe to hand on: a clock that went backwards is 0, and
/// a jump forward is cut to `MAX_ELAPSED_MS`.
pub int clamp_elapsed(int elapsed_ms) {
    if (elapsed_ms < 0) {
        return 0;
    }
    if (elapsed_ms > MAX_ELAPSED_MS) {
        return MAX_ELAPSED_MS;
    }
    return elapsed_ms;
}

int now_ms() {
    return timer.monotonic_ns() / 1000000;
}

/// Two answers as one: Quit wins, then Redraw, then Continue.
pub Action fold(Action first, Action second) {
    match (first) {
        case Quit: {
            return Action.Quit;
        }
        case Redraw: {
            match (second) {
                case Quit: {
                    return Action.Quit;
                }
                case Redraw: {
                    return Action.Redraw;
                }
                case Continue: {
                    return Action.Redraw;
                }
            }
        }
        case Continue: {
            return second;
        }
    }
}

/// The window's size, falling back to 80x24 when the terminal does not know
/// its own -- `examples/keys.m31`'s own fallback, for the same reason:
/// `term.size` answering 0x0 is not an error, and a frame has to be built
/// from SOME size.
pub term.Size screen_size() {
    match (term.size()) {
        case Ok(term.Size window_size): {
            if (window_size.rows > 0 && window_size.columns > 0) {
                return window_size;
            }
        }
        case Err(term.Error error): {
        }
    }
    return term.Size(24, 80);
}

/// Whether two readings of the window's size differ -- the loop's own resize
/// test, pulled out so it can be checked without a terminal at all.
pub bool has_resized(term.Size previous, term.Size current) {
    return previous.rows != current.rows || previous.columns != current.columns;
}

void flush(term.Writer writer) {
    // A `Writer`'s error is `io.Error`, not `term.Error`, and turning one
    // into the other would invent a mapping nobody asked for. Same answer
    // `Loop.run`'s own header gives for a failed read: there is nothing left
    // to do with a terminal that has stopped taking writes but stop.
    match (writer.flush()) {
        case Ok(int count): {
        }
        case Err(io.Error error): {
        }
    }
}
