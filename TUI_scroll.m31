// A scrolling window over content taller (or wider) than the room it is
// drawn in, and the bar that shows where it is.
//
// API
// ---
//   TUI_scroll.Viewport()                a scroll offset, and the clamping
//                                        math every scrollable widget needs
//   view.reveal(at, total, visible)     scroll so row `at` is on screen --
//                                        the rule `TUI_list_table.ListView` already
//                                        follows its selection with
//   view.scroll(delta, total, visible)  move by `delta`, clamped
//   TUI_scroll.Scrollbar(...)            a track and a proportional thumb
//   bar.render(buf, area, total, visible, offset)
//
// `apps/tui`'s two existing scrollers -- `ListView` and `Table` -- each carry
// this math inline, because when they were written it was the only place it
// was needed. `TUI_outline.Outline` and `TUI_diff_view.DiffView` both need the
// same thing over a tree flattened to rows rather than a flat list, so it is
// pulled out here rather than written a third and fourth time. `ListView` and
// `Table` are left as they are: their own `offset` field and `scrolled`
// method already work, and changing a widget nothing asked to change is not
// this library's business.

import TUI_buffer;
import TUI_geometry;
import TUI_style;

/// A scroll offset, and the arithmetic that keeps it inside its content.
/// `total` and `visible` are not fields -- they are whatever the content and
/// the rectangle are THIS render, and a `Viewport` is handed them fresh each
/// time rather than kept in sync with them, the same way `ListView.offset`
/// is a plain field its own `render` moves.
pub type Viewport {
    pub int offset = 0;
}

/// `offset`, pulled into `0 .. max(total - visible, 0)`.
pub int Viewport.clamped(int total, int visible) {
    int most = total - visible;
    if (most < 0) {
        most = 0;
    }
    int clamped_offset = offset;
    if (clamped_offset > most) {
        clamped_offset = most;
    }
    if (clamped_offset < 0) {
        clamped_offset = 0;
    }
    return clamped_offset;
}

/// Move by `delta` rows (negative scrolls back), clamped to the content.
pub void Viewport.scroll(int delta, int total, int visible) {
    offset = offset + delta;
    offset = clamped(total, visible);
}

/// Scroll the least amount that brings row `index` into a window `visible` rows
/// tall: nothing, if it already is. This is `TUI_list_table.ListView.scrolled`'s
/// own rule, generalised to anything that can name a row by its index into
/// `total`.
pub void Viewport.reveal(int index, int total, int visible) {
    if (visible <= 0) {
        return;
    }
    if (index < offset) {
        offset = index;
    }
    if (index >= offset + visible) {
        offset = index - visible + 1;
    }
    offset = clamped(total, visible);
}

/// Which way a `Scrollbar` runs.
pub enum Orient {
    Vertical;
    Horizontal;
}

/// A thin bar: a track the length of the rectangle, and a thumb sized and
/// placed in proportion to how much of `total` is visible and where.
///
/// `total <= 0` or an empty rectangle draws nothing; `total <= visible` --
/// everything already fits -- draws a thumb the whole length of the track,
/// which is what "there is nothing to scroll" looks like rather than a
/// special case a caller has to test for first.
pub type Scrollbar {
    pub Orient orient = Orient.Vertical;
    pub TUI_style.Style track_style = TUI_style.Style();
    pub TUI_style.Style thumb_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    pub str track_symbol = "\u{2502}";
    pub str thumb_symbol = "\u{2588}";
}

int Scrollbar.length(TUI_geometry.Rect area) {
    int extent = area.height;
    match (orient) {
        case Vertical: {
        }
        case Horizontal: {
            extent = area.width;
        }
    }
    return extent;
}

pub void Scrollbar.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area, int total, int visible, int offset) {
    if (area.is_empty() || total <= 0) {
        return;
    }
    int length = length(area);
    if (length <= 0) {
        return;
    }
    int visible_count = visible;
    if (visible_count <= 0) {
        visible_count = 1;
    }
    int thumb = length * visible_count / total;
    if (thumb < 1) {
        thumb = 1;
    }
    if (thumb > length) {
        thumb = length;
    }
    int span = total - visible_count;
    if (span < 0) {
        span = 0;
    }
    int track = length - thumb;
    int position = 0;
    if (span > 0) {
        position = track * offset / span;
    }
    if (position < 0) {
        position = 0;
    }
    if (position > track) {
        position = track;
    }
    int cell_index = 0;
    while (cell_index < length) {
        TUI_style.Style cell_style = track_style;
        str symbol = track_symbol;
        if (cell_index >= position && cell_index < position + thumb) {
            cell_style = thumb_style;
            symbol = thumb_symbol;
        }
        match (orient) {
            case Vertical: {
                buffer.set_str(area.x, area.y + cell_index, symbol, cell_style);
            }
            case Horizontal: {
                buffer.set_str(area.x + cell_index, area.y, symbol, cell_style);
            }
        }
        cell_index = cell_index + 1;
    }
}
