// A synced jump list: a flat, selectable index of whatever an outline
// currently shows. See `apps/git/design.md`'s corrected description -- this
// is "closer to a synced table of contents than a directory browser", and
// the two-way part is the point: selecting a row here scrolls the outline to
// it, and moving the outline's own cursor highlights the row here. Neither
// direction alone would be this primitive; a static index that only jumps
// one way is a `TUI_list_table.ListView` of labels, which already exists.
//
// API
// ---
//   TUI_jump_list.Entry(id, label, depth)   one row, matched to an outline node
//   TUI_jump_list.JumpList(entries)         the widget: selection, scroll, render
//   jump.sync_from(outline)           rebuild `entries` from the outline's
//                                     CURRENT flattened, visible rows
//   jump.follow(outline)              outline moved -> highlight the match here
//   jump.did_activate(outline) -> bool here selected -> move the outline there
//   jump.step(delta), jump.render(buf, area)
//
// --- why matching is by id, not by row number --------------------------------
//
// Folding a section in the outline changes every row number below the fold,
// but changes no `id`. `sync_from` copies the outline's rows (and their
// ids) fresh every time it is called -- after a toggle, after a reload -- and
// `follow`/`did_activate` always look a row up by `id`, never by position, which
// is what keeps the two lists in step with each other regardless of what is
// currently folded.

import TUI_buffer;
import TUI_geometry;
import TUI_outline;
import TUI_scroll;
import TUI_style;
import TUI_text;

/// One row of the jump list: an outline node's `id` and `label`, and how deep
/// it was nested, copied out of an `Outline` by `sync_from`.
pub type Entry {
    pub str id;
    pub str label;
    pub int depth = 0;
}

/// The widget: a flat list of `Entry`, with its own selection and scroll,
/// kept in step with an `Outline` through `sync_from`, `follow` and
/// `did_activate` rather than owning the tree itself.
pub type JumpList {
    pub List<Entry> entries;
    pub int selected = -1;
    pub TUI_scroll.Viewport view = TUI_scroll.Viewport();
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    pub int indent = 1;
}

/// An empty jump list, ready for `sync_from`.
pub static JumpList JumpList.empty() {
    return JumpList([]);
}

/// Rebuild `entries` from `outline`'s current, flattened, visible rows. A folded
/// section contributes only itself -- the jump list shrinks when the
/// document folds, which is what "synced" means.
pub void JumpList.sync_from(TUI_outline.Outline outline) {
    List<Entry> out = [];
    for (TUI_outline.Row row in outline.rows()) {
        out.push(Entry(row.node.id, row.node.label, depth: row.depth));
    }
    entries = out;
}

/// The outline half of the sync: move the highlight to whatever row the
/// outline's cursor is on now. Call this after any move, toggle or reload of
/// the outline.
pub void JumpList.follow(TUI_outline.Outline outline) {
    match (outline.current()) {
        case Some(TUI_outline.Row row): {
            did_select_id(row.node.id);
        }
        case None: {
        }
    }
}

/// The jump-list half of the sync: move the outline's cursor (and its own
/// scroll, through `Outline.render`) to the entry selected here. Answers
/// whether the selection named a row the outline currently shows.
pub bool JumpList.did_activate(TUI_outline.Outline outline) {
    if (selected < 0 || selected >= entries.size()) {
        return false;
    }
    return outline.did_select_id(entries[selected].id);
}

/// Select the entry with this `id`, if there is one. Answers whether one was
/// found.
pub bool JumpList.did_select_id(str id) {
    int index = 0;
    while (index < entries.size()) {
        if (entries[index].id == id) {
            selected = index;
            return true;
        }
        index = index + 1;
    }
    return false;
}

/// Move the selection by `delta`, stopping at the ends --
/// `TUI_list_table.ListView.step`'s own rule.
pub void JumpList.step(int delta) {
    int count = entries.size();
    if (count == 0) {
        selected = -1;
        return;
    }
    int target = selected + delta;
    if (selected < 0 && delta > 0) {
        target = 0;
    }
    if (target < 0) {
        target = 0;
    }
    if (target >= count) {
        target = count - 1;
    }
    selected = target;
}

pub void JumpList.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    if (selected >= entries.size()) {
        selected = entries.size() - 1;
    }
    if (selected >= 0) {
        view.reveal(selected, entries.size(), area.height);
    }
    view.offset = view.clamped(entries.size(), area.height);
    int off = view.offset;
    int line_index = 0;
    while (line_index < area.height) {
        int entry_index = off + line_index;
        if (entry_index >= entries.size()) {
            return;
        }
        Entry entry = entries[entry_index];
        int y = area.y + line_index;
        TUI_style.Style row_style = style;
        if (entry_index == selected) {
            row_style = row_style.merged(highlight_style);
            buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", row_style);
        }
        int x = area.x + entry.depth * indent;
        int room = area.right() - x;
        if (room > 0) {
            buffer.set_str(x, y, TUI_text.truncate(entry.label, room), row_style, max: room);
        }
        line_index = line_index + 1;
    }
}
