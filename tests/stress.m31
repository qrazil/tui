// The stress harness: what the renderer writes, replayed on terminals that differ.
//
//   bash tests/test.sh
//
// Our emulator-based tests agreed with the renderer and real terminals did not, so this
// harness asks the question the other way round. It draws random frames through the
// library's real output (`Loop.frame_bytes`: the diff, the scrolled diff, the full frame
// of a resize, the synchronized-output markers), applies the bytes to an emulator that
// behaves like one kind of real terminal, and after EVERY frame asserts that its screen
// is the screen a from-scratch repaint of the same frame gives on that same terminal.
// Where the terminal has no disagreement with the library (it wraps differently, it
// erases differently) the screen must also be exactly the buffer.
//
// The terminals (`TST_emulator.Screen`'s knobs):
//   ideal          no autowrap; grapheme segmentation; what the older tests used
//   pending-wrap   xterm: the cursor waits on the last column until the next printable
//   instant-wrap   the cursor wraps the moment the last column is written
//   no-autowrap    the last column is overwritten again and again
//   sum-codepoints Terminal.app: a cluster is drawn as the sum of its code points
//   vs16-ignored   a text emoji with U+FE0F is drawn one column (the base character)
//   vs16-widens    U+FE0F makes anything two columns
//   ambiguous-wide East Asian Ambiguous (box drawing, arrows, shapes, Greek) are two columns
//   private-wide   private use glyphs (Nerd Font icons) take two columns
//   new-emoji-narrow  emoji newer than the terminal's tables are one column
//   astral-narrow  pictographs of U+1F300.. are one column
//   jamo-add       conjoining Hangul jamo are two columns each
//   no-combining   a combining mark takes a cell of its own
//   no-bce         erase (EL) paints the default background, not the pen's
//   unclamped      CUF/CUB do not stop at the margin, CUF keeps a pending wrap
//   no-sync        mode 2026 is ignored and not answered
//   terminal-app   sum-codepoints + pending-wrap + no-sync + no-bce
//
// Two phases. The pair phase is exhaustive over small rows: every row of a pool as the
// old frame against every row as the new one, on a screen ten columns wide, which is
// the minimal reproducer of anything that breaks. The random phase draws long
// sequences of scenes (a text layer, a popup box with a list that grows and shrinks, a
// query that is typed and erased, resizes) at 40 x 12 and 61 x 16.

import os;
import random;
import text.unicode;
import app.TUI_app;
import app.TUI_diff;
import core.TUI_buffer;
import core.TUI_geometry;
import core.TUI_style;
import core.TUI_text;
import core.TUI_widget;
import core.TUI_width;
import tests.TST_emulator;

type Tally {
    int pass = 0;
    int fail = 0;
}

type Variant {
    str name = "";
    int wrap_mode = 0;
    int width_model = 1;
    int quirks = 0;
    bool is_erase_coloured = true;
    bool is_move_clamped = true;
    bool is_move_keeping_wrap = false;
    bool is_sync_ignored = false;
    bool is_autowrap_locked = false;
    /// The terminal ignores DECSTBM (so a scroll the renderer trusts does not happen).
    bool is_region_ignored = false;
    /// What cannot be made right without asking the terminal how wide it draws: reported, not failed.
    bool is_known_limit = false;
    /// The terminal agrees with the library on every width, so the screen must be the buffer.
    bool is_exact = true;
    int regional_width = 1;
    /// A terminal of `TST_emulator.preset` (the owner's: alacritty, rio, kitty, a terminal that switches on mode 2027, one that
    /// draws East Asian Ambiguous wide), with its own settings instead of the fields above.
    str preset = "";
    /// What the loop's calibration measured on this terminal (the default table: nothing measured).
    TUI_width.Table table = TUI_width.Table();
    /// Calibration switched mode 2027 on, so every screen of this terminal has it on.
    bool is_grapheme_on = false;
    /// What cannot be made right even with the calibration (none, so far).
    bool is_known_limit_calibrated = false;
}

List<Variant> variants() {
    List<Variant> out = [];
    out.push(Variant(name: "ideal"));
    out.push(Variant(name: "pending-wrap", wrap_mode: 1));
    out.push(Variant(name: "instant-wrap", wrap_mode: 2));
    out.push(Variant(name: "no-autowrap", wrap_mode: 3));
    out.push(Variant(name: "sum-codepoints", wrap_mode: 1, width_model: 0, is_exact: false));
    out.push(Variant(name: "vs16-ignored", wrap_mode: 1, quirks: TST_emulator.Q_VS16_IGNORED, is_exact: false));
    out.push(Variant(name: "vs16-widens", wrap_mode: 1, quirks: TST_emulator.Q_VS16_WIDENS, is_exact: false));
    out.push(Variant(name: "ambiguous-wide", wrap_mode: 1, quirks: TST_emulator.Q_AMBIGUOUS_WIDE, is_exact: false));
    out.push(Variant(name: "box-wide", wrap_mode: 1, quirks: TST_emulator.Q_BOX_WIDE, is_exact: false, is_known_limit: true));
    out.push(Variant(name: "private-wide", wrap_mode: 1, quirks: TST_emulator.Q_PRIVATE_USE_WIDE, is_exact: false));
    out.push(Variant(name: "new-emoji-narrow", wrap_mode: 1, quirks: TST_emulator.Q_NEW_EMOJI_NARROW, is_exact: false));
    out.push(Variant(name: "astral-narrow", wrap_mode: 1, quirks: TST_emulator.Q_ASTRAL_SYMBOL_NARROW, is_exact: false));
    out.push(Variant(name: "jamo-add", wrap_mode: 1, quirks: TST_emulator.Q_JAMO_ADD, is_exact: false));
    out.push(Variant(name: "no-combining", wrap_mode: 1, quirks: TST_emulator.Q_COMBINING_OWN_CELL, is_exact: false, is_known_limit: true));
    out.push(Variant(name: "regional-2", wrap_mode: 1, regional_width: 2, is_exact: false));
    out.push(Variant(name: "no-bce", wrap_mode: 1, is_erase_coloured: false));
    out.push(Variant(name: "unclamped", wrap_mode: 1, is_move_clamped: false, is_move_keeping_wrap: true));
    out.push(Variant(name: "no-sync", wrap_mode: 1, is_sync_ignored: true));
    out.push(Variant(name: "no-decstbm", wrap_mode: 1, is_region_ignored: true));
    out.push(Variant(name: "terminal-app", wrap_mode: 1, width_model: 0, is_erase_coloured: false, is_sync_ignored: true, is_exact: false));
    return out;
}

/// The owner's terminals and the ones the calibration is for, as `TST_emulator.preset` models them.
List<Variant> presets() {
    List<Variant> out = [];
    List<str> names = ["alacritty", "rio", "kitty", "mode-2027", "box-wide", "mute"];
    for (str name in names) {
        Variant variant = Variant(name: "preset " + name, preset: name, is_exact: false, is_known_limit: name == "box-wide");
        out.push(variant);
    }
    return out;
}

TST_emulator.Screen screen_for(Variant variant, int columns, int rows) {
    if (variant.preset != "") {
        TST_emulator.Screen made = TST_emulator.preset(variant.preset, columns, rows);
        if (variant.is_grapheme_on) {
            made.grapheme_status = 1;
        }
        return made;
    }
    TST_emulator.Screen screen = TST_emulator.Screen.sized(columns, rows);
    screen.wrap_mode = variant.wrap_mode;
    screen.width_model = variant.width_model;
    screen.quirks = variant.quirks;
    screen.is_erase_coloured = variant.is_erase_coloured;
    screen.is_move_clamped = variant.is_move_clamped;
    screen.is_move_keeping_wrap = variant.is_move_keeping_wrap;
    screen.is_sync_ignored = variant.is_sync_ignored;
    screen.is_autowrap_locked = variant.is_autowrap_locked;
    screen.is_region_ignored = variant.is_region_ignored;
    screen.regional_width = variant.regional_width;
    if (variant.is_grapheme_on) {
        screen.grapheme_status = 1;
    }
    return screen;
}

/// Does this variant, in the state it is in (asked or not), have a width disagreement nothing can repair?
bool is_limit(Variant variant) {
    if (variant.table.is_measured) {
        return variant.is_known_limit_calibrated;
    }
    return variant.is_known_limit;
}

/// Ask a terminal like `variant` what it measures, the way the loop does at start-up, and keep the answer
/// in the variant (and whether mode 2027 was switched on: the terminals the harness makes later have it on).
void calibrate(Variant variant) {
    TUI_app.Loop loop = TUI_app.Loop();
    TST_emulator.Screen screen = screen_for(variant, 80, 24);
    TST_emulator.Link link = TST_emulator.Link(screen);
    loop.calibrate_width(link, screen.rows);
    variant.table = loop.width_table;
    variant.is_grapheme_on = variant.table.is_grapheme_set || screen.is_grapheme_on();
}

/// The same terminals, not asked: the static policy of 0.13.0.
void uncalibrate(Variant variant) {
    variant.table = TUI_width.Table();
    variant.is_grapheme_on = false;
}

// --- the text pool: what a text user interface meets ------------------------------------

List<str> pool() {
    List<str> out = [];
    out.push("hello world");
    out.push("x");
    out.push("src/main.m31");
    out.push("    indented");
    out.push("\u{4E2D}\u{6587}\u{5B57}\u{7B26}");
    out.push("\u{3053}\u{3093}\u{306B}\u{3061}\u{306F}");
    out.push("\u{FF21}\u{FF22}\u{FF23}");
    out.push("\u{1F600}\u{1F680}");
    out.push("\u{2764}\u{FE0F}");
    out.push("\u{2714}\u{FE0F} ok");
    out.push("\u{2600}\u{FE0F}\u{26A0}\u{FE0F}");
    out.push("\u{2764}");
    out.push("\u{2705} \u{274C}");
    out.push("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}");
    out.push("\u{1F9D1}\u{200D}\u{1F4BB}");
    out.push("\u{1F1E9}\u{1F1EA}");
    out.push("\u{1F1E9}");
    out.push("1\u{FE0F}\u{20E3}");
    out.push("\u{1F44D}\u{1F3FD}");
    out.push("\u{270B}\u{1F3FD}");
    out.push("\u{D55C}\u{AE00}");
    out.push("\u{1112}\u{1161}\u{11AB}");
    out.push("e\u{301}");
    out.push("a\u{308}\u{301}");
    out.push("\u{E9}");
    out.push("\u{2500}\u{2502}\u{256D}\u{256E}\u{2570}\u{256F}");
    out.push("\u{25B8} \u{25CF} \u{2192} \u{2022}");
    out.push("\u{B1}\u{B0}\u{D7}");
    out.push("\u{03B1}\u{03B2}\u{0416}");
    out.push("\u{E0B0}\u{F115}");
