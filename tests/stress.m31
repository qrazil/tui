    return out;
}

// --- one scene: what the program means to show -------------------------------------------

type Scene {
    int width = 0;
    int height = 0;
    List<str> base = [];
    List<int> base_style = [];
    bool has_popup = true;
    int popup_x = 0;
    int popup_y = 0;
    int popup_w = 0;
    int popup_h = 0;
    str query = "";
    List<str> items = [];
    int selected = 0;
    int style_kind = 0;
    int cursor_x = -1;
    int cursor_y = -1;
}

TUI_style.Style style_of(int kind) {
    if (kind == 1) {
        return TUI_style.Style(foreground: TUI_style.Colour.Indexed(2), background: TUI_style.Colour.Indexed(4));
    }
    if (kind == 2) {
        return TUI_style.Style(attrs: TUI_style.BOLD);
    }
    if (kind == 3) {
        return TUI_style.Style(background: TUI_style.Colour.Rgb(40, 44, 52));
    }
    if (kind == 4) {
        return TUI_style.Style(foreground: TUI_style.Colour.Rgb(200, 100, 50), attrs: TUI_style.UNDERLINE);
    }
    if (kind == 5) {
        return TUI_style.Style(attrs: TUI_style.REVERSE);
    }
    return TUI_style.Style();
}

str some_line(random.Seeded dice, List<str> texts, int width) {
    int pieces = dice.integer(1, 6);
    List<str> parts = [];
    for (int index in 0 .. pieces) {
        parts.push(texts[dice.integer(0, texts.size() - 1)]);
        if (dice.integer(0, 2) == 0) {
            parts.push(" ");
        }
    }
    str line = parts.join("");
    int fit = dice.integer(0, 6);
    if (fit == 0) {
        // exactly the width of the row, or one short of it: the last column and the one before
        int target = width - dice.integer(0, 1);
        List<str> cut = [];
        int used = 0;
        for (str cluster in TUI_text.clusters(line)) {
            int cluster_width = TUI_text.width(cluster);
            if (used + cluster_width > target) {
                break;
            }
            cut.push(cluster);
            used = used + cluster_width;
        }
        return cut.join("") + " ".repeat(target - used);
    }
    if (fit == 1) {
        return line.repeat(width / 4 + 1);
    }
    return line;
}

Scene new_scene(random.Seeded dice, List<str> texts, int width, int height) {
    Scene scene = Scene(width: width, height: height);
    for (int y in 0 .. height) {
        scene.base.push(some_line(dice, texts, width));
        scene.base_style.push(dice.integer(0, 5));
    }
    scene.popup_x = dice.integer(0, width / 4);
    scene.popup_y = dice.integer(0, height / 4);
    scene.popup_w = dice.integer(width / 2, width - scene.popup_x);
    scene.popup_h = dice.integer(5, height - scene.popup_y);
    for (int index in 0 .. dice.integer(0, 14)) {
        scene.items.push(some_line(dice, texts, scene.popup_w));
    }
    return scene;
}

Scene copy_scene(Scene scene) {
    Scene out = Scene(width: scene.width, height: scene.height, has_popup: scene.has_popup, popup_x: scene.popup_x, popup_y: scene.popup_y, popup_w: scene.popup_w, popup_h: scene.popup_h, query: scene.query, selected: scene.selected, style_kind: scene.style_kind, cursor_x: scene.cursor_x, cursor_y: scene.cursor_y);
    for (str line in scene.base) {
        out.base.push(line);
    }
    for (int kind in scene.base_style) {
        out.base_style.push(kind);
    }
    for (str item in scene.items) {
        out.items.push(item);
    }
    return out;
}

/// The next scene: one small change, or a big one now and then.
Scene mutate(random.Seeded dice, List<str> texts, Scene scene) {
    Scene out = copy_scene(scene);
    int op = dice.integer(0, 11);
    if (op == 0) {
        int y = dice.integer(0, out.height - 1);
        out.base[y] = some_line(dice, texts, out.width);
        out.base_style[y] = dice.integer(0, 5);
    } else if (op == 1 || op == 2) {
        // type a character, or erase the last one
        if (op == 1 || out.query.size() == 0) {
            List<str> clusters = TUI_text.clusters(texts[dice.integer(0, texts.size() - 1)]);
            out.query = out.query + clusters[0];
        } else {
            List<str> clusters = TUI_text.clusters(out.query);
            clusters.pop();
            out.query = clusters.join("");
        }
        // the list narrows as the query grows
        List<str> kept = [];
        for (str item in out.items) {
            if (dice.integer(0, 3) != 0) {
                kept.push(item);
            }
        }
        out.items = kept;
    } else if (op == 3) {
        out.items = [];
        for (int index in 0 .. dice.integer(0, 16)) {
            out.items.push(some_line(dice, texts, out.popup_w));
        }
    } else if (op == 4) {
        out.selected = dice.integer(0, 14);
    } else if (op == 5) {
        out.style_kind = dice.integer(0, 5);
    } else if (op == 6) {
        out.has_popup = !out.has_popup;
    } else if (op == 7) {
        out.popup_x = dice.integer(0, out.width / 4);
        out.popup_y = dice.integer(0, out.height / 4);
        out.popup_w = dice.integer(out.width / 2, out.width - out.popup_x);
        out.popup_h = dice.integer(5, out.height - out.popup_y);
    } else if (op == 8) {
        // the text layer scrolls by a few rows (the scrolled diff's case)
        int by = dice.integer(1, 3);
        List<str> lines = [];
        List<int> kinds = [];
        for (int y in by .. out.height) {
            lines.push(out.base[y]);
            kinds.push(out.base_style[y]);
        }
        for (int index in 0 .. by) {
            lines.push(some_line(dice, texts, out.width));
            kinds.push(dice.integer(0, 5));
        }
        out.base = lines;
        out.base_style = kinds;
    } else if (op == 9) {
        for (int y in 0 .. out.height) {
            out.base[y] = some_line(dice, texts, out.width);
        }
    } else if (op == 10) {
        out.cursor_x = dice.integer(-1, out.width - 1);
        out.cursor_y = dice.integer(0, out.height - 1);
    } else {
        out.has_popup = false;
        int y = dice.integer(0, out.height - 1);
        out.base[y] = "";
    }
    return out;
}

void draw(Scene scene, TUI_buffer.Buffer buffer) {
    for (int y in 0 .. scene.height) {
        TUI_style.Style style = style_of(scene.base_style[y]);
        buffer.set_str(0, y, scene.base[y], style);
        if (scene.base_style[y] == 3) {
            // a styled tail: blanks in the row's own style, to the edge
            int used = TUI_text.width(scene.base[y]);
            if (used < scene.width) {
                buffer.fill(TUI_geometry.Rect(used, y, scene.width - used, 1), " ", style);
            }
        }
    }
    if (!scene.has_popup) {
        return;
    }
    TUI_style.Style plain = style_of(3);
    TUI_style.Style chosen = style_of(1);
    TUI_geometry.Rect box = TUI_geometry.Rect(scene.popup_x, scene.popup_y, scene.popup_w, scene.popup_h);
    buffer.fill(box, " ", plain);
    TUI_widget.Block block = TUI_widget.Block(title: " pick " + str(scene.items.size()) + " ", borders: TUI_widget.Borders.Rounded, style: plain, pad_x: 1);
    block.render(buffer, box);
    TUI_geometry.Rect inner = block.inner(box);
    if (inner.height < 3 || inner.width < 4) {
        return;
    }
    buffer.set_str(inner.x, inner.y, "> " + scene.query, plain, max: inner.width);
    buffer.fill(TUI_geometry.Rect(inner.x, inner.y + 1, inner.width, 1), "\u{2500}", plain);
    for (int row in 0 .. inner.height - 2) {
        if (row >= scene.items.size()) {
            break;
        }
        int y = inner.y + 2 + row;
        TUI_style.Style style = plain;
        if (row == scene.selected) {
            style = chosen;
            buffer.fill(TUI_geometry.Rect(inner.x, y, inner.width, 1), " ", chosen);
        }
        buffer.set_str(inner.x, y, scene.items[row], style, max: inner.width);
    }
}

TUI_buffer.Buffer buffer_of(Scene scene, TUI_width.Table table) {
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(scene.width, scene.height);
    buffer.table = table;
    draw(scene, buffer);
    return buffer;
}

// --- running frames through a terminal ---------------------------------------------------

type Run {
    int frames = 0;
    int bad = 0;
    str first = "";
    int bytes_written = 0;
    int full_bytes = 0;
    str detail = "";
}

/// A screen of another size that still shows what the old one did, as a resized window does.
TST_emulator.Screen resized_from(Variant variant, TST_emulator.Screen old, int columns, int rows) {
    TST_emulator.Screen screen = screen_for(variant, columns, rows);
    for (int y in 0 .. rows) {
        for (int x in 0 .. columns) {
            if (x < old.columns && y < old.rows) {
                screen.put_symbol(x, y, old.symbol_at(x, y));
            }
        }
    }
    return screen;
}

/// Replay the `scenes` on a terminal like `variant`; compare after every frame.
Run play(Variant variant, List<Scene> scenes, bool is_scroll, bool is_sync, TUI_style.Depth depth) {
    Run run = Run();
    TUI_app.Loop loop = TUI_app.Loop(should_scroll: is_scroll);
    loop.is_sync = is_sync;
    TUI_app.Shown shown = TUI_app.Shown();
    TST_emulator.Screen screen = screen_for(variant, scenes[0].width, scenes[0].height);
    TUI_buffer.Buffer previous = buffer_of(scenes[0], variant.table);
    loop.cursor.x = scenes[0].cursor_x;
    loop.cursor.y = scenes[0].cursor_y;
    screen.feed(loop.frame_bytes(previous, previous, true, shown));
    for (int index in 1 .. scenes.size()) {
        Scene scene = scenes[index];
        TUI_buffer.Buffer next = buffer_of(scene, variant.table);
        loop.cursor.x = scene.cursor_x;
        loop.cursor.y = scene.cursor_y;
        bool is_resized = scene.width != previous.area().width || scene.height != previous.area().height;
        bytes frame = [];
        if (is_resized) {
            screen = resized_from(variant, screen, scene.width, scene.height);
            frame = loop.frame_bytes(next, next, true, shown);
        } else {
            frame = loop.frame_bytes(previous, next, false, shown);
        }
        run.frames = run.frames + 1;
        run.bytes_written = run.bytes_written + frame.size();
        screen.feed(frame);
        // a terminal that holds the screen during a synchronized update has shown it by now
        str why = verdict(variant, screen, next, scene);
        if (why != "" && run.bad == 0) {
            str note = "";
            if (is_resized) {
                note = " resize";
            }
            run.first = "frame " + str(index) + note + ": " + why;
            TST_emulator.Screen fresh = screen_for(variant, scene.width, scene.height);
            fresh.feed(TUI_app.Loop().frame_bytes(next, next, true, TUI_app.Shown()));
            str cells = "";
            for (int y in 0 .. scene.height) {
                if (screen.row_text(y) != fresh.row_text(y)) {
                    List<str> got = [];
                    List<str> want = [];
                    for (int x in 0 .. scene.width) {
                        got.push(screen.symbol_at(x, y));
                        want.push(fresh.symbol_at(x, y));
                    }
                    cells = cells + "prev row text: " + pair_name(previous.row_text(y)) + "\nnext row text: " + pair_name(next.row_text(y)) + "\n";
                    cells = cells + "row " + str(y) + " screen: " + got.join("|") + "\nrow " + str(y) + " repaint: " + want.join("|") + "\n";
                }
            }
            run.detail = cells + "previous:\n" + previous.to_str() + "\nnext:\n" + next.to_str() + "\nscreen:\n" + screen.to_str() + "\nbytes: " + TUI_diff.show(frame);
        }
        if (why != "") {
            run.bad = run.bad + 1;
        }
        previous = next;
    }
    return run;
}

/// "" when the screen is right, else what is wrong with it.
str verdict(Variant variant, TST_emulator.Screen screen, TUI_buffer.Buffer next, Scene scene) {
    if (screen.unknown.size() > 0) {
        return "the terminal did not understand " + screen.unknown[0];
    }
    if (screen.is_sync && !variant.is_sync_ignored) {
        return "a synchronized update was left open";
    }
    TST_emulator.Screen fresh = screen_for(variant, scene.width, scene.height);
    TUI_app.Loop reference = TUI_app.Loop();
    fresh.feed(reference.frame_bytes(next, next, true, TUI_app.Shown()));
    str why = screen.differs_from_screen(fresh);
    if (why != "") {
        return "differs from a repaint: " + why;
    }
    if (variant.is_exact) {
        str other = screen.differs_from(next);
        if (other != "") {
            return "differs from the buffer: " + other;
        }
    }
    return "";
}

// --- the pair phase: every small row against every other ---------------------------------

const int PAIR_WIDTH = 10;

List<str> rows_pool() {
    List<str> out = [];
    out.push("");
    out.push("          ");
    out.push("abcdefghij");
    out.push("abcdefghi");
    out.push("abc");
    out.push("\u{4E2D}\u{4E2D}\u{4E2D}\u{4E2D}\u{4E2D}");
    out.push("a\u{4E2D}b\u{4E2D}c");
    out.push("abcdefghi\u{4E2D}");
    out.push("abcdefgh\u{4E2D}");
    out.push("\u{1F600}\u{1F600}\u{1F600}\u{1F600}\u{1F600}");
    out.push("a\u{1F600}");
    out.push("abcdefgh\u{1F600}");
    out.push("\u{2764}\u{FE0F}abc");
    out.push("abc\u{2764}\u{FE0F}");
    out.push("a\u{2764}\u{FE0F}\u{2764}\u{FE0F}b");
    out.push("abcdefgh\u{2764}\u{FE0F}");
    out.push("abcdefghi\u{2764}\u{FE0F}");
    out.push("\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}x");
    out.push("xxxxxxxx\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}");
    out.push("\u{1F1E9}\u{1F1EA}abc");
    out.push("\u{1F1E9}abc");
    out.push("1\u{FE0F}\u{20E3}2\u{FE0F}\u{20E3}");
    out.push("\u{1F44D}\u{1F3FD}a");
    out.push("\u{D55C}\u{AE00}\u{D55C}\u{AE00}");
    out.push("\u{1112}\u{1161}\u{11AB}ab");
    out.push("e\u{301}e\u{301}e\u{301}");
    out.push("a\u{308}\u{301}b");
    out.push("\u{2500}\u{2502}\u{256D}\u{256E}\u{2500}\u{2502}");
    out.push("\u{25B8} \u{25CF} \u{2192} z");
    out.push("\u{E0B0}\u{E0B0}ab");
    out.push("\u{1FAE8}ab");
    out.push("\u{1FAE8}\u{1FA77}\u{1FAE8}");
    out.push("a\tb");
    out.push("a\u{1}b\u{1B}[2J");
    out.push("\u{E2A}\u{E27}\u{E31}\u{E2A}\u{E14}\u{E35}");
    out.push("\u{928}\u{92E}\u{938}\u{94D}\u{924}\u{947}");
    out.push("\u{645}\u{631}\u{62D}\u{628}\u{627}");
    out.push("a\u{200B}b");
    out.push("\u{2028}z");
    return out;
}

/// One row on a ten column, one row screen; `kind` 0 plain, 1 with a coloured background all
/// along the row (blanks included), 2 coloured text on a plain tail.
TUI_buffer.Buffer pair_buffer(str text, int kind, TUI_width.Table table) {
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(PAIR_WIDTH, 2);
    buffer.table = table;
    TUI_style.Style style = TUI_style.Style();
    if (kind == 1) {
        style = style_of(3);
        buffer.fill(TUI_geometry.Rect(0, 0, PAIR_WIDTH, 1), " ", style);
    } else if (kind == 2) {
        style = style_of(1);
    }
    buffer.set_str(0, 0, text, style);
    buffer.set_str(0, 1, "end", TUI_style.Style());
    return buffer;
}

str pair_name(str text) {
    return TUI_diff.show(text.to_bytes());
}

void pair_phase(Tally tally, List<Variant> all) {
    List<str> rows = rows_pool();
    TUI_style.Depth depth = TUI_style.Depth.Ansi256;
    for (Variant variant in all) {
        int bad = 0;
        List<str> examples = [];
        for (str old_text in rows) {
            for (str new_text in rows) {
                for (int kind in 0 .. 3) {
                    TUI_buffer.Buffer before = pair_buffer(old_text, kind, variant.table);
                    TUI_buffer.Buffer after = pair_buffer(new_text, (kind + 1) % 3, variant.table);
                    TUI_app.Loop loop = TUI_app.Loop();
                    TST_emulator.Screen screen = screen_for(variant, PAIR_WIDTH, 2);
                    screen.feed(loop.frame_bytes(before, before, true, TUI_app.Shown()));
                    screen.feed(loop.frame_bytes(before, after, false, TUI_app.Shown()));
                    str why = verdict(variant, screen, after, Scene(width: PAIR_WIDTH, height: 2));
                    if (why != "") {
                        bad = bad + 1;
                        if (examples.size() < 3) {
                            examples.push("[" + pair_name(old_text) + "] -> [" + pair_name(new_text) + "] style " + str(kind) + ": " + why);
                        }
                    }
                }
            }
        }
        if (bad == 0) {
            tally.pass = tally.pass + 1;
            print("ok   pairs: " + variant.name);
        } else {
            str mark = "FAIL";
            if (is_limit(variant)) {
                mark = "known";
            } else {
                tally.fail = tally.fail + 1;
            }
            print(mark + " pairs: " + variant.name + ": " + str(bad) + " of " + str(rows.size() * rows.size() * 3) + " pairs");
            for (str example in examples) {
                print("     " + example);
            }
        }
    }
}

// --- the random phase ------------------------------------------------------------------

void random_phase(Tally tally, List<Variant> all, int sequences, int frames) {
    List<str> texts = pool();
    TUI_style.Depth depth = TUI_style.Depth.Ansi256;
    // the same scenes for every terminal
    List<List<Scene>> plans = [];
    random.Seeded dice = random.seeded(20261020);
    for (int sequence in 0 .. sequences) {
        int width = 40;
        int height = 12;
        if (sequence % 2 == 1) {
            width = 61;
            height = 16;
        }
        List<Scene> plan = [];
        Scene scene = new_scene(dice, texts, width, height);
        plan.push(scene);
        for (int frame in 0 .. frames) {
            if (dice.integer(0, 14) == 0) {
                // a resize: a few columns and rows more or fewer
                Scene resized = new_scene(dice, texts, scene.width + dice.integer(-5, 5), scene.height + dice.integer(-3, 3));
                scene = resized;
            } else {
                scene = mutate(dice, texts, scene);
            }
            plan.push(scene);
        }
        plans.push(plan);
    }
    for (Variant variant in all) {
        int modes = 1;
        if (variant.name == "ideal" || variant.name == "pending-wrap" || variant.name == "sum-codepoints" || variant.name == "terminal-app" || variant.name == "no-decstbm") {
            // the scrolled diff and the synchronized markers, on the terminals that matter most
            modes = 3;
        }
        for (int mode in 0 .. modes) {
            bool is_scroll = mode == 1;
            bool is_sync = mode == 2;
            str label = "random: " + variant.name;
            if (is_scroll) {
                label = label + " +scroll";
            }
            if (is_sync) {
                label = label + " +sync";
            }
            int bad = 0;
            int total = 0;
            int bytes_total = 0;
            str first = "";
            for (List<Scene> plan in plans) {
                Run run = play(variant, plan, is_scroll, is_sync, depth);
                total = total + run.frames;
                bad = bad + run.bad;
                bytes_total = bytes_total + run.bytes_written;
                if (run.bad > 0 && first == "") {
                    first = run.first;
                    if (os.env("STRESS_EXPLAIN").or("") == variant.name) {
                        print(run.detail);
                    }
                }
            }
            if (bad == 0) {
                tally.pass = tally.pass + 1;
                print("ok   " + label + ": " + str(total) + " frames");
            } else {
                str mark = "FAIL";
                if (is_limit(variant) || (is_scroll && variant.is_region_ignored)) {
                    mark = "known";
                } else {
                    tally.fail = tally.fail + 1;
                }
                print(mark + " " + label + ": " + str(bad) + " of " + str(total) + " frames wrong");
                print("     first: " + first);
            }
        }
    }
}

// --- the finder: the sequence of the report ---------------------------------------------

/// Open a picker over text, type p, o, m (the list narrows from many rows to few), erase the m:
/// the scene sequence of m3's fuzzy finder, with entries of different lengths, wide characters,
/// emoji and a path longer than the box.
List<Scene> finder_plan(int width, int height, bool has_preview) {
    List<str> entries = [];
    for (int index in 0 .. 60) {
        str name = "src/ui/module_" + str(index) + ".m31";
        if (index % 7 == 0) {
            name = "docs/pom_" + str(index) + "/" + "deep/".repeat(index % 5 + 1) + "a_path_longer_than_the_box_" + str(index) + ".xml";
        } else if (index % 11 == 0) {
            name = "\u{4E2D}\u{6587}/pom_\u{6F22}\u{5B57}_" + str(index) + ".md";
        } else if (index % 13 == 0) {
            name = "notes/\u{1F680}_pom_\u{26A0}\u{FE0F}_" + str(index) + ".md";
        } else if (index % 5 == 0) {
            name = "pom.xml " + str(index);
        } else if (index % 3 == 0) {
            name = "po_" + str(index);
        }
        entries.push(name);
    }
    random.Seeded dice = random.seeded(7);
    List<str> texts = pool();
    Scene scene = new_scene(dice, texts, width, height);
    scene.has_popup = true;
    scene.popup_x = 2;
    scene.popup_y = 1;
    scene.popup_w = width - 4;
    scene.popup_h = height - 2;
    scene.selected = 0;
    List<Scene> plan = [];
    List<str> queries = ["", "p", "po", "pom", "po", "p", "", "p", "pom"];
    for (str query in queries) {
        Scene frame = copy_scene(scene);
        frame.query = query;
        frame.items = [];
        for (str entry in entries) {
            int at = 0;
            bool is_match = true;
            for (str letter in TUI_text.clusters(query)) {
                match (entry.substr(at, entry.size()).index_of(letter)) {
                    case Some(int found): {
                        at = at + found + letter.size();
                    }
                    case None: {
                        is_match = false;
                    }
                }
                if (!is_match) {
                    break;
                }
            }
            if (is_match) {
                frame.items.push(entry);
            }
        }
        plan.push(frame);
    }
    return plan;
}

/// Every variant's finder bytes (plain and scrolled, both sizes), in the order of `all`: what `finder_report` compares.
List<int> finder_phase(Tally tally, List<Variant> all) {
    TUI_style.Depth depth = TUI_style.Depth.Ansi256;
    List<int> totals = [];
    for (Variant variant in all) {
        int variant_bytes = 0;
        for (int mode in 0 .. 2) {
            bool is_scroll = mode == 1;
            int bad = 0;
            int bytes_total = 0;
            str first = "";
            for (int size in 0 .. 2) {
                int width = 80;
                int height = 24;
                if (size == 1) {
                    width = 120;
                    height = 30;
                }
                Run run = play(variant, finder_plan(width, height, true), is_scroll, true, depth);
                bad = bad + run.bad;
                bytes_total = bytes_total + run.bytes_written;
                if (run.bad > 0 && first == "") {
                    first = run.first;
                }
            }
            variant_bytes = variant_bytes + bytes_total;
            str label = "finder: " + variant.name;
            if (is_scroll) {
                label = label + " +scroll";
            }
            if (bad == 0) {
                tally.pass = tally.pass + 1;
                print("ok   " + label + ": " + str(bytes_total) + " bytes");
            } else {
                str mark = "FAIL";
                if (is_limit(variant) || (is_scroll && variant.is_region_ignored)) {
                    mark = "known";
                } else {
                    tally.fail = tally.fail + 1;
                }
                print(mark + " " + label + ": " + str(bad) + " frames wrong");
                print("     first: " + first);
            }
        }
        totals.push(variant_bytes);
    }
    return totals;
}

/// What the calibration saved on the finder sequence, per terminal: the bytes the static policy writes, the
/// bytes with the terminal measured. A terminal that agrees with the library's tables must not write more.
void finder_report(Tally tally, List<Variant> all, List<int> static_bytes, List<int> measured_bytes) {
    for (int index in 0 .. all.size()) {
        Variant variant = all[index];
        int before = static_bytes[index];
        int after = measured_bytes[index];
        str saved = "";
        if (before > 0) {
            saved = " (" + str((before - after) * 100 / before) + " % less)";
        }
        if (variant.is_exact || variant.preset == "alacritty" || variant.preset == "rio" || variant.preset == "kitty" || variant.preset == "mode-2027" || variant.preset == "mute") {
            if (after <= before) {
                tally.pass = tally.pass + 1;
                print("ok   finder bytes: " + variant.name + ": " + str(before) + " static, " + str(after) + " measured" + saved);
            } else {
                tally.fail = tally.fail + 1;
                print("FAIL finder bytes: " + variant.name + ": " + str(before) + " static, " + str(after) + " measured (more)");
            }
        } else {
            print("     finder bytes: " + variant.name + ": " + str(before) + " static, " + str(after) + " measured" + saved);
        }
    }
}

/// What the calibration found on each terminal.
void calibration_report(List<Variant> all) {
    for (Variant variant in all) {
        TUI_width.Table table = variant.table;
        List<str> parts = [];
        for (int class_id in 0 .. TUI_width.CLASS_COUNT) {
            str decision = table.decision(class_id);
            if (decision != "certain") {
                parts.push(TUI_width.class_name(class_id) + " " + decision);
            }
        }
        str odd = "every class certain";
        if (parts.size() > 0) {
            odd = parts.join("; ");
        }
        print("     " + variant.name + ": " + table.outcome + ", mode 2027 " + str(table.is_grapheme_mode) + ", ascii lines " + str(table.is_ascii_lines) + ": " + odd);
    }
}

Tally tally = Tally();
List<Variant> all = variants();
for (Variant preset in presets()) {
    all.push(preset);
}
print("== the static policy (the terminal is not asked, as in 0.13.0) " + "=".repeat(20));
for (Variant variant in all) {
    uncalibrate(variant);
}
print("== pairs, static " + "=".repeat(60));
pair_phase(tally, all);
print("== finder, static " + "=".repeat(60));
List<int> static_bytes = finder_phase(tally, all);
print("== the width calibration (what the loop measures at start-up) " + "=".repeat(20));
for (Variant variant in all) {
    calibrate(variant);
}
calibration_report(all);
print("== pairs, calibrated " + "=".repeat(60));
pair_phase(tally, all);
print("== finder, calibrated " + "=".repeat(60));
List<int> measured_bytes = finder_phase(tally, all);
print("== finder bytes " + "=".repeat(60));
finder_report(tally, all, static_bytes, measured_bytes);
print("== random, calibrated " + "=".repeat(60));
random_phase(tally, all, 12, 40);
print("");
print("-- " + str(tally.pass) + " passed, " + str(tally.fail) + " failed");
if (tally.fail > 0) {
    os.exit(1);
}
