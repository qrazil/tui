// The 0.10.0 terminal features: synchronized output, the clipboard, hyperlinks,
// the keyboard protocols, focus reports and the width of emoji.
//
//   bash tests/test.sh
//
// Nothing here needs a terminal. The bytes the library writes are applied to
// `TST_emulator.Screen`, a small terminal emulator, and the screen is what is
// checked: the terminal is the oracle, not the encoder's own idea of what it
// meant. Where a feature is a pure encoder or decoder it is also checked byte
// for byte. Like the other corpora: a `check` line prints `ok` or `FAIL`, and
// what is printed is compared against tests/terminal.out.

import encoding.base64;
import io;
import os;
import random;
import term;
import text.unicode;
import app.TUI_app;
import core.TUI_buffer;
import core.TUI_geometry;
import core.TUI_keys;
import app.TUI_diff;
import core.TUI_osc;
import core.TUI_style;
import core.TUI_mouse;
import core.TUI_text;
import core.TUI_widget;
import tests.TST_emulator;

type Tally {
    int pass = 0;
    int fail = 0;
}

void check(Tally tally, str name, str got, str want) {
    if (got == want) {
        tally.pass = tally.pass + 1;
        print("ok   " + name);
        return;
    }
    tally.fail = tally.fail + 1;
    print("FAIL " + name);
    print("     got  [" + got + "]");
    print("     want [" + want + "]");
}

void check_int(Tally tally, str name, int got, int want) {
    check(tally, name, str(got), str(want));
}

void ok(Tally tally, str name, bool is_condition_true) {
    check(tally, name, str(is_condition_true), "true");
}

void head(str text) {
    print("");
    print("== " + text + " " + "=".repeat(60 - text.size()));
}

/// A buffer with `text` on row 0 and `other` on row 2, 12 columns by 3 rows.
TUI_buffer.Buffer scene(str text, str other) {
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(12, 3);
    buffer.set_str(0, 0, text, TUI_style.Style());
    buffer.set_str(0, 2, other, TUI_style.Style());
    return buffer;
}

/// The bytes from `start` up to (not including) `stop`.
bytes slice(bytes data, int start, int stop) {
    bytes out = [];
    for (int index in start .. stop) {
        out.push(data[index]);
    }
    return out;
}

// --- 1. synchronized output (DEC mode 2026) -----------------------------------

void sync_tests(Tally tally) {
    head("synchronized output");
    TUI_style.Depth depth = TUI_style.Depth.Ansi16;
    TUI_buffer.Buffer before = scene("old top", "old bottom");
    TUI_buffer.Buffer after = scene("new top", "new bottom");
    bytes body = TUI_diff.diff(before, after, depth);
    // the loop's frame: plain by default, wrapped once the terminal said yes
    TUI_app.Loop loop = TUI_app.Loop();
    bytes plain = loop.compose_frame(body, TUI_app.Shown());
    check(tally, "not confirmed: the frame is the renderer's bytes, nothing around them", TUI_diff.show(plain), TUI_diff.show(body));
    loop.is_sync = true;
    bytes wrapped = loop.compose_frame(body, TUI_app.Shown());
    check(tally, "confirmed: begin, the same bytes, end", TUI_diff.show(wrapped), "\\e[?2026h" + TUI_diff.show(body) + "\\e[?2026l");
    check(tally, "TUI_diff.synchronized is the same wrapping", TUI_diff.show(TUI_diff.synchronized(body)), TUI_diff.show(wrapped));
    check_int(tally, "an empty frame is not wrapped", TUI_diff.synchronized([]).size(), 0);
    check_int(tally, "a frame that changes nothing writes nothing, confirmed or not", loop.compose_frame([], TUI_app.Shown()).size(), 0);
    // the terminal as oracle: a screen that is shown half a frame
    int middle = body.size() / 2;
    while (middle < body.size() && body[middle] != 27) {
        middle = middle + 1;
    }
    TST_emulator.Screen unsynced = TST_emulator.Screen.sized(12, 3);
    unsynced.show(before);
    unsynced.feed(slice(body, 0, middle));
    ok(tally, "oracle: without the markers, half a frame is on show (a torn screen)", unsynced.differs_from(before) != "" && unsynced.differs_from(after) != "");
    unsynced.feed(slice(body, middle, body.size()));
    check(tally, "oracle: and the rest completes it", unsynced.differs_from(after), "");
    TST_emulator.Screen screen = TST_emulator.Screen.sized(12, 3);
    screen.show(before);
    int cut = wrapped.size() - 8 - (body.size() - middle);
    screen.feed(slice(wrapped, 0, cut));
    check(tally, "oracle: inside a synchronized update the viewer still sees the old frame", screen.differs_from(before), "");
    ok(tally, "oracle: and the terminal is holding", screen.is_sync);
    screen.feed(slice(wrapped, cut, wrapped.size() - 8));
    check(tally, "oracle: even with the whole body written", screen.differs_from(before), "");
    screen.feed(slice(wrapped, wrapped.size() - 8, wrapped.size()));
    check(tally, "oracle: the end marker shows the new frame, whole", screen.differs_from(after), "");
    check_int(tally, "oracle: one update ended", screen.sync_count, 1);
    ok(tally, "oracle: no sequence the emulator did not understand", screen.unknown.size() == 0);
    // a terminal killed in the middle of a frame is not left holding its screen
    TUI_app.Loop asked = TUI_app.Loop(should_sync: true);
    ok(tally, "leave: with sync asked, the first thing written on the way out ends it", asked.leave_sequence().starts_with("\x1b[?2026l"));
    ok(tally, "enter: with sync asked, the question is written after the modes", asked.enter_sequence().ends_with("\x1b[?2026$p"));
    TST_emulator.Screen held = TST_emulator.Screen.sized(12, 3);
    held.feed("\x1b[?2026h".to_bytes());
    held.feed(asked.leave_sequence().to_bytes());
    ok(tally, "oracle: the leave sequence releases a screen held by a killed frame", !held.is_sync);
    // defaults keep today's bytes
    TUI_app.Loop today = TUI_app.Loop();
    check(tally, "default enter sequence", TUI_diff.show(today.enter_sequence().to_bytes()), "\\e[?1049h\\e[?25l\\e[?7l");
    check(tally, "default leave sequence", TUI_diff.show(today.leave_sequence().to_bytes()), "\\e[?7h\\e[?25h\\e[0m\\e[?1049l");
}

// --- 2. the clipboard (OSC 52) -------------------------------------------------

/// What base64 `data` says, as text; "<bad base64>" when it is not.
str decoded(str data) {
    match (base64.decode(data)) {
        case Ok(bytes raw): {
            match (raw.utf8()) {
                case Some(str text): {
                    return text;
                }
                case None: {
                    return "<not utf-8>";
                }
            }
        }
        case Err(base64.Error error): {
            return "<bad base64>";
        }
    }
}

/// What the clipboard holds after a terminal is fed `sequence`.
str copied(bytes sequence) {
    TST_emulator.Screen screen = TST_emulator.Screen.sized(4, 1);
    screen.feed(sequence);
    return decoded(screen.clipboard_data);
}

void clipboard_tests(Tally tally) {
    head("clipboard (OSC 52)");
    check(tally, "the bytes, byte for byte", TUI_diff.show(TUI_osc.clipboard_sequence("hi")), "\\e]52;c;aGk=\\x07");
    check(tally, "another target", TUI_diff.show(TUI_osc.clipboard_sequence("hi", target: "p")), "\\e]52;p;aGk=\\x07");
    check_int(tally, "no text, nothing", TUI_osc.clipboard_sequence("").size(), 0);
    check_int(tally, "a target that is not a clipboard, nothing", TUI_osc.clipboard_sequence("hi", target: "x").size(), 0);
    check_int(tally, "a target of two letters, nothing", TUI_osc.clipboard_sequence("hi", target: "cc").size(), 0);
    check_int(tally, "a limit of 0, nothing", TUI_osc.clipboard_sequence("hi", target: "c", limit: 0).size(), 0);
    ok(tally, "the default limit keeps base64 under xterm's 100000", TUI_osc.CLIPBOARD_LIMIT / 3 * 4 + 4 <= 100000);
    bytes huge = TUI_osc.clipboard_sequence("a".repeat(200000));
    ok(tally, "a 200000-byte text is cut so the whole sequence stays under 100000 bytes", huge.size() <= 100000 && huge.size() > 90000);
    // text is cut before it is encoded, and never inside a character or a cluster
    check_int(tally, "fit: all of it", TUI_osc.clipboard_fit("hello", 100), 5);
    check_int(tally, "fit: ascii cut at the limit", TUI_osc.clipboard_fit("hello", 3), 3);
    check_int(tally, "fit: e-acute is 2 bytes, a cut of 2 keeps the h only", TUI_osc.clipboard_fit("h\u{E9}llo", 2), 1);
    check_int(tally, "fit: a cut of 3 keeps h and e-acute", TUI_osc.clipboard_fit("h\u{E9}llo", 3), 3);
    str family = "\u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467}";
    check_int(tally, "fit: a family is one cluster, 18 bytes: a cut inside it keeps none of it", TUI_osc.clipboard_fit("ab" + family, 10), 2);
    check_int(tally, "fit: and a cut after it keeps all of it", TUI_osc.clipboard_fit("ab" + family, 20), 20);
    TST_emulator.Screen screen = TST_emulator.Screen.sized(10, 2);
    screen.feed(TUI_osc.clipboard_sequence("h\u{E9}llo w\u{F6}rld", target: "c", limit: 4));
    check(tally, "oracle: the terminal gets the cut text, valid UTF-8", decoded(screen.clipboard_data), "h\u{E9}l");
    check(tally, "oracle: for the clipboard asked", screen.clipboard_target, "c");
    check_int(tally, "oracle: one write", screen.clipboard_writes, 1);
    ok(tally, "oracle: nothing else", screen.unknown.size() == 0);
    // what is in the text cannot become a sequence
    TST_emulator.Screen hostile = TST_emulator.Screen.sized(10, 2);
    hostile.feed(TUI_osc.clipboard_sequence("a\x07\x1b]52;c;ZXZpbA==\x07\x1b[2Jb"));
    check_int(tally, "oracle: ESC, BEL and a second OSC inside the text are data: one write", hostile.clipboard_writes, 1);
    check(tally, "oracle: and arrive as they were", decoded(hostile.clipboard_data), "a\x07\x1b]52;c;ZXZpbA==\x07\x1b[2Jb");
    ok(tally, "oracle: nothing was cleared, nothing unknown", hostile.unknown.size() == 0 && hostile.row_text(0) == "          ");
    // the loop: a queue, an off switch, a cap
    TUI_app.Loop loop = TUI_app.Loop();
    check_int(tally, "loop: nothing queued at first", loop.take_output().size(), 0);
    check_int(tally, "loop: copy answers the bytes it sent", loop.copy("hello"), 5);
    bytes queued = loop.take_output();
    check(tally, "loop: the queue holds the sequence", TUI_diff.show(queued), "\\e]52;c;aGVsbG8=\\x07");
    check_int(tally, "loop: taking forgets", loop.take_output().size(), 0);
    loop.copy("one");
    loop.copy("two");
    TST_emulator.Screen two = TST_emulator.Screen.sized(10, 2);
    two.feed(loop.take_output());
    check_int(tally, "loop: two copies are two writes, in order", two.clipboard_writes, 2);
    check(tally, "loop: the last one wins", decoded(two.clipboard_data), "two");
    loop.is_copy_allowed = false;
    check_int(tally, "loop: with the switch off, copy sends 0", loop.copy("secret"), 0);
    check_int(tally, "loop: and queues nothing", loop.take_output().size(), 0);
    loop.is_copy_allowed = true;
    loop.copy_limit = 3;
    check_int(tally, "loop: a limit of 3 sends 3 of 5", loop.copy("hello"), 3);
    check(tally, "loop: the terminal gets the cut", copied(loop.take_output()), "hel");
    loop.copy_limit = 0;
    check_int(tally, "loop: a limit of 0 sends nothing", loop.copy("hello"), 0);
    loop.queue_output("\x1b[?25h".to_bytes());
    check(tally, "loop: queue_output is written as it is", TUI_diff.show(loop.take_output()), "\\e[?25h");
    // defaults keep today's bytes
    ok(tally, "default enter and leave have no clipboard in them", !(TUI_app.Loop().enter_sequence() + TUI_app.Loop().leave_sequence()).contains("]52"));
}

// --- 3. hyperlinks (OSC 8) in the cell model ---------------------------------------

/// Apply `diff(before, after)` to a screen that shows `before`; what differs from
/// `after` afterwards ("" when nothing does, links included).
str replayed(TUI_buffer.Buffer before, TUI_buffer.Buffer after) {
    TST_emulator.Screen screen = TST_emulator.Screen.sized(before.area().width, before.area().height);
    screen.show(before);
    screen.feed(TUI_diff.diff(before, after, TUI_style.Depth.TrueColour));
    if (screen.unknown.size() > 0) {
        return "unknown sequence " + screen.unknown[0];
    }
    if (screen.link != "") {
        return "a link was left open: " + screen.link;
    }
    return screen.differs_from(after);
}

/// `full(buffer)` on a blank screen; what differs from `buffer` afterwards.
str painted(TUI_buffer.Buffer buffer) {
    TST_emulator.Screen screen = TST_emulator.Screen.sized(buffer.area().width, buffer.area().height);
    screen.feed(TUI_diff.full(buffer, TUI_style.Depth.TrueColour));
    if (screen.unknown.size() > 0) {
        return "unknown sequence " + screen.unknown[0];
    }
    if (screen.link != "") {
        return "a link was left open: " + screen.link;
    }
    return screen.differs_from(buffer);
}

void hyperlink_tests(Tally tally) {
    head("hyperlinks (OSC 8)");
    TUI_style.Style plain = TUI_style.Style();
    // the encoders
    check(tally, "uri: plain stays", TUI_osc.hyperlink_uri("https://example.com/a?b=c;d#e"), "https://example.com/a?b=c;d#e");
    check(tally, "uri: a space, ESC, BEL and a newline are percent-encoded", TUI_osc.hyperlink_uri("file:///a b\x1b\x07\n"), "file:///a%20b%1B%07%0A");
    check(tally, "uri: non-ASCII is percent-encoded byte by byte", TUI_osc.hyperlink_uri("http://x/\u{E9}"), "http://x/%C3%A9");
    check(tally, "uri: empty is no link", TUI_osc.hyperlink_uri(""), "");
    check(tally, "uri: over-long is no link", TUI_osc.hyperlink_uri("http://x/" + "a".repeat(2100)), "");
    check(tally, "uri: just short enough stays", str(TUI_osc.hyperlink_uri("a".repeat(2083)).size()), "2083");
    check(tally, "open: id from the uri, ST at the end", TUI_diff.show(TUI_osc.hyperlink_open("http://a").to_bytes()), "\\e]8;id=" + str(TUI_osc.hyperlink_id("http://a")) + ";http://a\\e\\");
    check(tally, "open: the same uri gives the same id", str(TUI_osc.hyperlink_id("http://a")), str(TUI_osc.hyperlink_id("http://a")));
    ok(tally, "open: another uri another id", TUI_osc.hyperlink_id("http://a") != TUI_osc.hyperlink_id("http://b"));
    check(tally, "open: no link, no bytes", TUI_osc.hyperlink_open(""), "");
    check(tally, "close", TUI_diff.show(TUI_osc.HYPERLINK_CLOSE.to_bytes), "\\e]8;;\\e\\");
    // the cell model
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(20, 3);
    ok(tally, "a new buffer has no links", !buffer.has_links());
    buffer.set_str(0, 0, "see the docs now", plain);
    buffer.link(TUI_geometry.Rect(8, 0, 4, 1), "https://m31.dev/docs");
    ok(tally, "link() makes it so", buffer.has_links());
    check(tally, "the cells inside have the link", buffer.link_at(9, 0), "https://m31.dev/docs");
    check(tally, "the cells outside do not", buffer.link_at(7, 0) + buffer.link_at(12, 0), "");
    check(tally, "get() carries it", buffer.get(8, 0).link, "https://m31.dev/docs");
    check(tally, "the text is untouched", buffer.row_text(0), "see the docs now    ");
    buffer.set_str(9, 0, "O", plain);
    check(tally, "writing over a linked cell takes its link off", buffer.link_at(9, 0), "");
    check(tally, "and only that cell's", buffer.link_at(8, 0) + "|" + buffer.link_at(10, 0), "https://m31.dev/docs|https://m31.dev/docs");
    buffer.link(TUI_geometry.Rect(0, 0, 20, 1), "");
    ok(tally, "link(rect, \"\") removes links", buffer.link_at(8, 0) == "" && buffer.link_at(10, 0) == "");
    buffer.link(TUI_geometry.Rect(0, 1, 5, 1), "javascript:alert(1)\x1b");
    check(tally, "an unsafe uri is made safe, not refused", buffer.link_at(0, 1), "javascript:alert(1)%1B");
    buffer.link(TUI_geometry.Rect(-5, -5, 100, 100), "http://all");
    check(tally, "a rect past the edge is clipped", buffer.link_at(19, 2), "http://all");
    buffer.clear();
    ok(tally, "clear() drops every link", !buffer.has_links());
    ok(tally, "and the cells are plain", buffer.link_at(3, 1) == "");
    // set_link_str, Span, Cell
    TUI_buffer.Buffer spans = TUI_buffer.Buffer.sized(20, 1);
    check_int(tally, "set_link_str answers the columns", spans.set_link_str(2, 0, "docs", plain, "http://d"), 4);
    check(tally, "set_link_str: linked", spans.link_at(2, 0) + spans.link_at(5, 0), "http://dhttp://d");
    check(tally, "set_link_str: not beyond", spans.link_at(1, 0) + spans.link_at(6, 0), "");
    TUI_buffer.Buffer line = TUI_buffer.Buffer.sized(20, 1);
    TUI_widget.Line([TUI_widget.Span("see "), TUI_widget.Span("docs", link: "http://d"), TUI_widget.Span(".")]).render(line, line.area());
    check(tally, "a Span with a link: its columns", line.link_at(4, 0) + line.link_at(7, 0), "http://dhttp://d");
    check(tally, "a Span with a link: not the spans around it", line.link_at(3, 0) + line.link_at(8, 0), "");
    TUI_buffer.Buffer cells = TUI_buffer.Buffer.sized(4, 1);
    cells.set(1, 0, TUI_buffer.Cell("x", link: "http://c"));
    check(tally, "set(Cell with a link)", cells.link_at(1, 0), "http://c");
    cells.set(1, 0, TUI_buffer.Cell("y"));
    check(tally, "set(Cell without) drops it", cells.link_at(1, 0), "");
    ok(tally, "a cell differs by its link", !TUI_buffer.Cell("x", link: "a").eq(TUI_buffer.Cell("x")));
    // frames
    TUI_buffer.Buffer frame = TUI_buffer.Buffer.sized(20, 2);
    frame.set_str(0, 0, "see docs here", plain);
    frame.link(TUI_geometry.Rect(4, 0, 4, 1), "http://d");
    bytes bytes_full = TUI_diff.full(frame, TUI_style.Depth.Ansi16);
    check(tally, "full: the link is open around its cells only, and closed", TUI_diff.show(bytes_full), "\\e[0m\\e[2J\\e[?7l\\e[1;1Hsee \\e]8;id=" + str(TUI_osc.hyperlink_id("http://d")) + ";http://d\\e\\docs\\e]8;;\\e\\ here       \\e[2;1H\\e[K");
    check(tally, "full: the terminal agrees", painted(frame), "");
    TUI_buffer.Buffer none = TUI_buffer.Buffer.sized(20, 2);
    none.set_str(0, 0, "see docs here", plain);
    ok(tally, "a frame with no links has no OSC in it", !TUI_diff.show(TUI_diff.full(none, TUI_style.Depth.Ansi16)).contains("]8;"));
    ok(tally, "nor does its diff", !TUI_diff.show(TUI_diff.diff(none, frame_without_link(), TUI_style.Depth.Ansi16)).contains("]8;"));
    ok(tally, "link on, nothing else changed: the frame still has something to write", TUI_diff.diff(none, frame, TUI_style.Depth.Ansi16).size() > 0);
    check(tally, "diff: a link appears", replayed(none, frame), "");
    check(tally, "diff: a link goes away", replayed(frame, none), "");
    TUI_buffer.Buffer other = TUI_buffer.Buffer.sized(20, 2);
    other.set_str(0, 0, "see docs here", plain);
    other.link(TUI_geometry.Rect(4, 0, 4, 1), "http://other");
    check(tally, "diff: the same text with another link is redrawn", replayed(frame, other), "");
    ok(tally, "diff: and the bytes say so", TUI_diff.show(TUI_diff.diff(frame, other, TUI_style.Depth.Ansi16)).contains("http://other"));
    check_int(tally, "diff: identical frames, links and all, write nothing", TUI_diff.diff(frame, frame, TUI_style.Depth.Ansi16).size(), 0);
    TUI_buffer.Buffer longer = TUI_buffer.Buffer.sized(20, 2);
    longer.set_str(0, 0, "see docs here", plain);
    longer.link(TUI_geometry.Rect(4, 0, 9, 1), "http://d");
    check(tally, "diff: a link that grows", replayed(frame, longer), "");
    TUI_buffer.Buffer erased = TUI_buffer.Buffer.sized(30, 1);
    erased.set_link_str(0, 0, "docs", plain, "http://d");
    check(tally, "full: a link is closed before the erase to the end of the row", TUI_diff.show(TUI_diff.full(erased, TUI_style.Depth.Ansi16)), "\\e[0m\\e[2J\\e[?7l\\e[1;1H\\e]8;id=" + str(TUI_osc.hyperlink_id("http://d")) + ";http://d\\e\\docs\\e]8;;\\e\\\\e[K");
    // a link on blanks to the end of the row is not erased away
    TUI_buffer.Buffer tail = TUI_buffer.Buffer.sized(20, 1);
    tail.link(TUI_geometry.Rect(2, 0, 18, 1), "http://tail");
    check(tally, "full: linked blanks are written, not erased", painted(tail), "");
    check(tally, "diff: linked blanks are written, not erased", replayed(TUI_buffer.Buffer.sized(20, 1), tail), "");
    // wide characters inside a link, and a link wrapped over two rows
    TUI_buffer.Buffer wide = TUI_buffer.Buffer.sized(12, 2);
    wide.set_str(0, 0, "a\u{1F600}b\u{4E2D}c", plain);
    wide.link(TUI_geometry.Rect(1, 0, 5, 1), "http://wide");
    wide.set_str(0, 1, "wrapped", plain);
    wide.link(TUI_geometry.Rect(0, 1, 7, 1), "http://wide");
    check(tally, "wide cells in a link and a link over two rows: full", painted(wide), "");
    check(tally, "wide cells in a link and a link over two rows: diff", replayed(TUI_buffer.Buffer.sized(12, 2), wide), "");
    int first = TUI_diff.show(TUI_diff.full(wide, TUI_style.Depth.Ansi16)).split("id=").size();
    check_int(tally, "the two runs of one uri share one id (two opens, one id)", first, 3);
    // the cursor walks across unchanged cells only when they are the open link
    TUI_buffer.Buffer gap_before = TUI_buffer.Buffer.sized(30, 1);
    gap_before.set_str(0, 0, "ab cd ef", plain);
    TUI_buffer.Buffer gap_after = TUI_buffer.Buffer.sized(30, 1);
    gap_after.set_str(0, 0, "AB cd EF", plain);
    gap_before.link(TUI_geometry.Rect(2, 0, 3, 1), "http://gap");
    gap_after.link(TUI_geometry.Rect(2, 0, 3, 1), "http://gap");
    check(tally, "diff: a linked gap between two changes", replayed(gap_before, gap_after), "");
    gap_before.link(TUI_geometry.Rect(2, 0, 3, 1), "");
    gap_after.link(TUI_geometry.Rect(2, 0, 1, 1), "http://gap");
    check(tally, "diff: a gap that is partly linked", replayed(gap_before, gap_after), "");
    // scrolling keeps links
    TUI_buffer.Buffer rows = TUI_buffer.Buffer.sized(8, 6);
    for (int row in 0 .. 6) {
        rows.set_str(0, row, "row " + str(row), plain);
    }
    rows.link(TUI_geometry.Rect(0, 3, 5, 1), "http://row3");
    check(tally, "scrolled(): the link moves with its row", rows.scrolled(0, 5, 2).link_at(0, 1), "http://row3");
    check(tally, "scrolled(): the row that opened up has none", rows.scrolled(0, 5, 2).link_at(0, 5), "");
    TUI_buffer.Buffer moving = rows.copy();
    moving.scroll_rows(0, 5, -1);
    check(tally, "scroll_rows(): in place, the other way", moving.link_at(0, 4), "http://row3");
    check(tally, "copy() keeps links", rows.copy().link_at(0, 3), "http://row3");
    // a thousand random frames, replayed on the emulator
    random.Seeded dice = random.seeded(31);
    List<str> uris = ["", "", "http://a", "http://b/c?d;e", "file:///x%20y"];
    int bad = 0;
    str first_bad = "";
    TUI_buffer.Buffer before = TUI_buffer.Buffer.sized(24, 4);
    for (int round in 0 .. 400) {
        TUI_buffer.Buffer after = TUI_buffer.Buffer.sized(24, 4);
        for (int row in 0 .. 4) {
            int column = 0;
            while (column < 22) {
                int length = dice.integer(1, 7);
                int kind = dice.integer(0, 5);
                str text = "ab cd ef gh";
                if (kind == 0) {
                    text = "\u{1F600}x\u{4E2D}";
                } else if (kind == 1) {
                    text = "       ";
                }
                int bold = dice.integer(0, 3);
                TUI_style.Style style = TUI_style.Style();
                if (bold == 0) {
                    style = TUI_style.Style(attrs: TUI_style.BOLD);
                }
                int used = after.set_str(column, row, text, style, max: length);
                str uri = uris[dice.integer(0, uris.size() - 1)];
                after.link(TUI_geometry.Rect(column, row, used, 1), uri);
                column = column + length + dice.integer(0, 3);
            }
        }
        // half the rounds keep most of the old frame, so the gaps between changes are unchanged cells
        if (dice.integer(0, 2) == 0) {
            for (int row in 0 .. 4) {
                if (dice.integer(0, 3) != 0) {
                    for (int column in 0 .. 24) {
                        after.set(column, row, before.get(column, row));
                    }
                }
            }
        }
        str problem = replayed(before, after);
        if (problem != "") {
            bad = bad + 1;
            if (first_bad == "") {
                first_bad = "round " + str(round) + ": " + problem;
            }
        }
        before = after;
    }
    check(tally, "400 random frames with links, replayed on the emulator: every one right " + first_bad, str(bad), "0");
}

TUI_buffer.Buffer frame_without_link() {
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(20, 2);
    buffer.set_str(0, 0, "see docs HERE", TUI_style.Style());
    return buffer;
}

// --- 4. the keyboard protocols (kitty, modifyOtherKeys) ------------------------------

/// A `Handler` that writes down what it was given.
type Recorder {
    List<str> seen = [];
}

TUI_app.Action Recorder.handle(term.Event event) {
    seen.push(event.to_str());
    return TUI_app.Action.Continue;
}

/// What `loop` makes of every event the terminal said since it was last read.
void pump(TST_emulator.Screen terminal, TUI_app.Loop loop, Recorder recorder) {
    for (term.Event event in term.decode(terminal.take_replies())) {
        loop.dispatch(event, recorder, TUI_app.NoMouse());
    }
    terminal.feed(loop.take_output());
}

/// What the program reads when the terminal is asked to press (`code`, `mods`).
str pressed(TST_emulator.Screen terminal, TUI_app.Loop loop, int code, int mods) {
    Recorder recorder = Recorder();
    for (term.Event event in term.decode(terminal.press(code, mods))) {
        loop.dispatch(event, recorder, TUI_app.NoMouse());
    }
    return recorder.seen.join(" ");
}

/// A loop starting up against `terminal`: the enter sequence written, the answers read.
Recorder start(TST_emulator.Screen terminal, TUI_app.Loop loop) {
    Recorder recorder = Recorder();
    terminal.feed(loop.enter_sequence().to_bytes());
    loop.start_keys();
    pump(terminal, loop, recorder);
    return recorder;
}

void key_tests(Tally tally) {
    head("keyboard protocols");
    // what the decoder in term does with the bytes (the premises)
    check(tally, "premise: byte 9 is Tab, so Ctrl-i cannot be told from it", term.decode("\x09".to_bytes())[0].to_str(), "tab");
    check(tally, "premise: kitty Ctrl-i is a key of its own", term.decode("\x1b[105;5u".to_bytes())[0].to_str(), "ctrl+i");
    check(tally, "premise: kitty Escape", term.decode("\x1b[27u".to_bytes())[0].to_str(), "escape");
    check(tally, "premise: kitty Alt-a", term.decode("\x1b[97;3u".to_bytes())[0].to_str(), "alt+a");
    check(tally, "premise: the modifyOtherKeys report is not decoded by term", term.decode("\x1b[27;5;105~".to_bytes())[0].to_str(), "unknown[1b5b32373b353b3130357e]");
    // the encoders and decoders
    check_int(tally, "reply: kitty, no flags", TUI_keys.reply_kind("\x1b[?0u".to_bytes()), TUI_keys.REPLY_KITTY);
    check_int(tally, "reply: kitty, flags 31", TUI_keys.reply_kind("\x1b[?31u".to_bytes()), TUI_keys.REPLY_KITTY);
    check_int(tally, "reply: device attributes", TUI_keys.reply_kind("\x1b[?62;22c".to_bytes()), TUI_keys.REPLY_ATTRIBUTES);
    check_int(tally, "reply: device attributes of a VT100", TUI_keys.reply_kind("\x1b[?1;2c".to_bytes()), TUI_keys.REPLY_ATTRIBUTES);
    check_int(tally, "reply: the mode 2026 answer is neither", TUI_keys.reply_kind("\x1b[?2026;2$y".to_bytes()), TUI_keys.REPLY_NONE);
    check_int(tally, "reply: a key is neither", TUI_keys.reply_kind("\x1b[105;5u".to_bytes()), TUI_keys.REPLY_NONE);
    check_int(tally, "reply: the query itself is neither", TUI_keys.reply_kind("\x1b[?u".to_bytes()), TUI_keys.REPLY_NONE);
    check_int(tally, "reply: focus is neither", TUI_keys.reply_kind("\x1b[I".to_bytes()), TUI_keys.REPLY_NONE);
    check_int(tally, "reply: junk with a final u is neither", TUI_keys.reply_kind("\x1b[?1;;u".to_bytes()), TUI_keys.REPLY_NONE);
    check_int(tally, "reply: text is neither", TUI_keys.reply_kind("abc".to_bytes()), TUI_keys.REPLY_NONE);
    check(tally, "modifyOtherKeys: Ctrl-i", mok("\x1b[27;5;105~"), "ctrl+i");
    check(tally, "modifyOtherKeys: Shift-Tab", mok("\x1b[27;2;9~"), "shift+tab");
    check(tally, "modifyOtherKeys: Ctrl-Tab", mok("\x1b[27;5;9~"), "ctrl+tab");
    check(tally, "modifyOtherKeys: Alt-Escape", mok("\x1b[27;3;27~"), "alt+escape");
    check(tally, "modifyOtherKeys: Ctrl-Enter", mok("\x1b[27;5;13~"), "ctrl+enter");
    check(tally, "modifyOtherKeys: Ctrl-Backspace", mok("\x1b[27;5;127~"), "ctrl+backspace");
    check(tally, "modifyOtherKeys: Ctrl-Shift-A", mok("\x1b[27;6;65~"), "ctrl+shift+A");
    check(tally, "modifyOtherKeys: Ctrl-Alt-e-acute", mok("\x1b[27;7;233~"), "ctrl+alt+\u{E9}");
    check(tally, "modifyOtherKeys: Ctrl-space", mok("\x1b[27;5;32~"), "ctrl+space");
    check(tally, "modifyOtherKeys: a code that is no character", mok("\x1b[27;5;55296~"), "none");
    check(tally, "modifyOtherKeys: a code past the last plane", mok("\x1b[27;5;99999999~"), "none");
    check(tally, "modifyOtherKeys: modifier 0", mok("\x1b[27;0;105~"), "none");
    check(tally, "modifyOtherKeys: two numbers", mok("\x1b[27;5~"), "none");
    check(tally, "modifyOtherKeys: another key", mok("\x1b[5;5~"), "none");
    check(tally, "modifyOtherKeys: not a CSI", mok("27;5;105~"), "none");
    check(tally, "modifyOtherKeys: trailing junk", mok("\x1b[27;5;105x~"), "none");
    check(tally, "normalized: Shift-Tab is BackTab", TUI_keys.normalized(term.Key(term.Code.Tab, term.SHIFT)).to_str(), "back-tab");
    check(tally, "normalized: Ctrl-Shift-Tab is Ctrl BackTab", TUI_keys.normalized(term.Key(term.Code.Tab, term.SHIFT + term.CTRL)).to_str(), "ctrl+back-tab");
    check(tally, "normalized: Tab stays", TUI_keys.normalized(term.Key(term.Code.Tab, 0)).to_str(), "tab");
    check(tally, "normalized: Shift-a stays", TUI_keys.normalized(term.Key(term.Code.Char(97), term.SHIFT)).to_str(), "shift+a");
    // a terminal with neither protocol: asked, it answers the attributes only
    TST_emulator.Screen classic = TST_emulator.Screen.sized(10, 2);
    TUI_app.Loop asking = TUI_app.Loop(should_disambiguate_keys: true);
    ok(tally, "enter: asked, the kitty question and then the attributes question", asking.enter_sequence().ends_with("\x1b[?u\x1b[c"));
    Recorder quiet = start(classic, asking);
    check_int(tally, "classic terminal: it was asked both questions", classic.queries, 2);
    check_int(tally, "classic terminal: the protocol is the classic one", asking.key_protocol, TUI_keys.KEYS_CLASSIC);
    check_int(tally, "classic terminal: nothing was sent that it would have to ignore", classic.ignored.size() + classic.kitty_stack.size(), 0);
    check(tally, "classic terminal: the answers were the loop's, not the program's", quiet.seen.join(","), "");
    check(tally, "classic terminal: Ctrl-i is Tab", pressed(classic, asking, 'i', term.CTRL), "tab");
    check(tally, "classic terminal: Tab is Tab", pressed(classic, asking, 9, 0), "tab");
    check(tally, "classic terminal: Escape", pressed(classic, asking, 27, 0), "escape");
    check(tally, "classic terminal: Alt-a", pressed(classic, asking, 'a', term.ALT), "alt+a");
    check(tally, "classic terminal: Ctrl-Shift-a is Ctrl-a", pressed(classic, asking, 'a', term.CTRL + term.SHIFT), "ctrl+a");
    check(tally, "classic terminal: Shift-Tab", pressed(classic, asking, 9, term.SHIFT), "back-tab");
    check(tally, "classic terminal: leaving writes nothing for the keys", asking.keys_off_sequence(), "");
    // a kitty terminal
    TST_emulator.Screen kitty = TST_emulator.Screen.sized(10, 2);
    kitty.has_kitty = true;
    kitty.sync_status = 2;
    TUI_app.Loop kitty_loop = TUI_app.Loop(should_disambiguate_keys: true, should_sync: true);
    Recorder kitty_seen = start(kitty, kitty_loop);
    check_int(tally, "kitty terminal: the protocol is on", kitty_loop.key_protocol, TUI_keys.KEYS_KITTY);
    check(tally, "kitty terminal: flag 1 is pushed, once", str(kitty.kitty_stack.size()) + ":" + str(kitty.kitty_stack[0]), "1:1");
    ok(tally, "kitty terminal: the sync answer came in the same exchange", kitty_loop.is_sync);
    check(tally, "kitty terminal: the program saw none of the answers", kitty_seen.seen.join(","), "");
    check(tally, "kitty terminal: Ctrl-i is not Tab", pressed(kitty, kitty_loop, 'i', term.CTRL), "ctrl+i");
    check(tally, "kitty terminal: Tab is Tab", pressed(kitty, kitty_loop, 9, 0), "tab");
    check(tally, "kitty terminal: Ctrl-m is not Enter", pressed(kitty, kitty_loop, 'm', term.CTRL), "ctrl+m");
    check(tally, "kitty terminal: Enter is Enter", pressed(kitty, kitty_loop, 13, 0), "enter");
    check(tally, "kitty terminal: Escape is a key, not a prefix", pressed(kitty, kitty_loop, 27, 0), "escape");
    check(tally, "kitty terminal: Alt-Escape", pressed(kitty, kitty_loop, 27, term.ALT), "alt+escape");
    check(tally, "kitty terminal: Alt-a", pressed(kitty, kitty_loop, 'a', term.ALT), "alt+a");
    check(tally, "kitty terminal: Ctrl-Shift-a keeps both", pressed(kitty, kitty_loop, 'a', term.CTRL + term.SHIFT), "ctrl+shift+a");
    check(tally, "kitty terminal: Shift-Tab is BackTab", pressed(kitty, kitty_loop, 9, term.SHIFT), "back-tab");
    check(tally, "kitty terminal: Ctrl-Enter", pressed(kitty, kitty_loop, 13, term.CTRL), "ctrl+enter");
    check(tally, "kitty terminal: a letter is a letter", pressed(kitty, kitty_loop, 'x', 0), "x");
    check(tally, "kitty terminal: a capital is a capital", pressed(kitty, kitty_loop, 'X', term.SHIFT), "X");
    ok(tally, "kitty terminal: the pop comes first, so before the alternate screen goes", kitty_loop.leave_sequence().starts_with("\x1b[<u") && kitty_loop.leave_sequence().ends_with("\x1b[?1049l"));
    kitty.feed(kitty_loop.leave_sequence().to_bytes());
    check_int(tally, "kitty terminal: leaving puts the flags back", kitty.kitty_stack.size(), 0);
    ok(tally, "kitty terminal: and nothing it did not know", kitty.unknown.size() == 0 && kitty.ignored.size() == 0);
    // xterm: no kitty answer, modifyOtherKeys as the fallback
    TST_emulator.Screen xterm = TST_emulator.Screen.sized(10, 2);
    xterm.has_modify_other = true;
    TUI_app.Loop xterm_loop = TUI_app.Loop(should_disambiguate_keys: true, should_try_modify_other_keys: true);
    start(xterm, xterm_loop);
    check_int(tally, "xterm: the protocol is modifyOtherKeys", xterm_loop.key_protocol, TUI_keys.KEYS_MODIFY_OTHER);
    check_int(tally, "xterm: level 2", xterm.modify_other_keys, 2);
    check(tally, "xterm: Ctrl-i is not Tab", pressed(xterm, xterm_loop, 'i', term.CTRL), "ctrl+i");
    check(tally, "xterm: Tab is Tab", pressed(xterm, xterm_loop, 9, 0), "tab");
    check(tally, "xterm: Escape", pressed(xterm, xterm_loop, 27, 0), "escape");
    check(tally, "xterm: Alt-Escape", pressed(xterm, xterm_loop, 27, term.ALT), "alt+escape");
    check(tally, "xterm: Shift-Tab is BackTab", pressed(xterm, xterm_loop, 9, term.SHIFT), "back-tab");
    check(tally, "xterm: Ctrl-Shift-a", pressed(xterm, xterm_loop, 'a', term.CTRL + term.SHIFT), "ctrl+shift+a");
    xterm.feed(xterm_loop.leave_sequence().to_bytes());
    check_int(tally, "xterm: leaving turns it off", xterm.modify_other_keys, 0);
    // the same terminal, fallback not asked for: nothing is sent
    TST_emulator.Screen xterm_plain = TST_emulator.Screen.sized(10, 2);
    xterm_plain.has_modify_other = true;
    TUI_app.Loop plain_loop = TUI_app.Loop(should_disambiguate_keys: true);
    start(xterm_plain, plain_loop);
    check_int(tally, "no fallback asked: the classic protocol", plain_loop.key_protocol, TUI_keys.KEYS_CLASSIC);
    check_int(tally, "no fallback asked: modifyOtherKeys is not touched", xterm_plain.modify_other_keys, 0);
    check(tally, "no fallback asked: Ctrl-i is Tab again", pressed(xterm_plain, plain_loop, 'i', term.CTRL), "tab");
    // modifyOtherKeys by itself: written on entry, nothing asked
    TST_emulator.Screen alone = TST_emulator.Screen.sized(10, 2);
    alone.has_modify_other = true;
    TUI_app.Loop alone_loop = TUI_app.Loop(should_try_modify_other_keys: true);
    ok(tally, "modifyOtherKeys alone: on in the enter sequence", alone_loop.enter_sequence().ends_with("\x1b[>4;2m"));
    ok(tally, "modifyOtherKeys alone: no question in it", !alone_loop.enter_sequence().contains("\x1b[c"));
    start(alone, alone_loop);
    check_int(tally, "modifyOtherKeys alone: the terminal has it on", alone.modify_other_keys, 2);
    check(tally, "modifyOtherKeys alone: Ctrl-i", pressed(alone, alone_loop, 'i', term.CTRL), "ctrl+i");
    check_int(tally, "modifyOtherKeys alone: nothing was asked", alone.queries, 0);
    // a program that asked for nothing is not touched
    TST_emulator.Screen bystander = TST_emulator.Screen.sized(10, 2);
    TUI_app.Loop unasked = TUI_app.Loop();
    Recorder own = Recorder();
    for (term.Event event in term.decode("\x1b[?62;22c\x1b[?0u".to_bytes())) {
        unasked.dispatch(event, own, TUI_app.NoMouse());
    }
    check(tally, "unasked: the program's own answers reach it", own.seen.join(" "), "unknown[1b5b3f36323b323263] unknown[1b5b3f3075]");
    check_int(tally, "unasked: nothing queued", unasked.take_output().size(), 0);
    check_int(tally, "unasked: the classic protocol", unasked.key_protocol, TUI_keys.KEYS_CLASSIC);
    check(tally, "unasked: Ctrl-i is Tab, Shift-Tab is BackTab, as always", pressed(bystander, unasked, 'i', term.CTRL) + " " + pressed(bystander, unasked, 9, term.SHIFT), "tab back-tab");
    // a late kitty answer to a loop that gave up waiting does not turn anything on
    TUI_app.Loop late = TUI_app.Loop(should_disambiguate_keys: true);
    late.start_keys();
    Recorder late_seen = Recorder();
    late.dispatch(term.decode("\x1b[?62;22c".to_bytes())[0], late_seen, TUI_app.NoMouse());
    late.dispatch(term.decode("\x1b[?0u".to_bytes())[0], late_seen, TUI_app.NoMouse());
    check_int(tally, "late kitty answer after the attributes: still classic", late.key_protocol, TUI_keys.KEYS_CLASSIC);
    check_int(tally, "late kitty answer: nothing queued", late.take_output().size(), 0);
}

/// `modify_other_key` of `text`, as the key's name or "none".
str mok(str text) {
    match (TUI_keys.modify_other_key(text.to_bytes())) {
        case Some(term.Key key): {
            return key.to_str();
        }
        case None: {
            return "none";
        }
    }
}

// --- 5. focus reports (mode 1004) ------------------------------------------------------

void focus_tests(Tally tally) {
    head("focus reports");
    check_int(tally, "report: focus in", TUI_app.focus_report("\x1b[I".to_bytes()), 1);
    check_int(tally, "report: focus out", TUI_app.focus_report("\x1b[O".to_bytes()), 0);
    check_int(tally, "report: an arrow is not one", TUI_app.focus_report("\x1b[A".to_bytes()), -1);
    check_int(tally, "report: a longer sequence is not one", TUI_app.focus_report("\x1b[1;5I".to_bytes()), -1);
    check_int(tally, "report: text is not one", TUI_app.focus_report("abc".to_bytes()), -1);
    check_int(tally, "report: nothing is not one", TUI_app.focus_report([]), -1);
    TUI_app.Loop loop = TUI_app.Loop(should_report_focus: true);
    TST_emulator.Screen terminal = TST_emulator.Screen.sized(10, 2);
    check_int(tally, "oracle: before the loop starts nothing is reported", terminal.focus(true).size(), 0);
    terminal.feed(loop.enter_sequence().to_bytes());
    ok(tally, "oracle: the enter sequence turns focus reporting on", terminal.is_focus_reporting);
    Recorder recorder = Recorder();
    for (term.Event event in term.decode(terminal.focus(false))) {
        loop.dispatch(event, recorder, TUI_app.NoMouse());
    }
    ok(tally, "focus out: the loop knows", !loop.has_focus);
    check_int(tally, "focus out: counted", loop.focus_changes, 1);
    ok(tally, "focus out: no repaint", !loop.should_repaint);
    check(tally, "focus out: the program's handler is not bothered", recorder.seen.join(","), "");
    for (term.Event event in term.decode(terminal.focus(true))) {
        loop.dispatch(event, recorder, TUI_app.NoMouse());
    }
    ok(tally, "focus in: the loop knows", loop.has_focus);
    check_int(tally, "focus in: counted", loop.focus_changes, 2);
    ok(tally, "focus in: the next frame is written in full", loop.should_repaint);
    terminal.feed(loop.leave_sequence().to_bytes());
    ok(tally, "oracle: the leave sequence turns it off", !terminal.is_focus_reporting);
    ok(tally, "oracle: and a terminal not reporting says nothing", terminal.focus(true).size() == 0);
    // something wrote on the screen while it was away: a full frame is what repairs it
    TUI_buffer.Buffer shown = scene("old top", "old bottom");
    TST_emulator.Screen away = TST_emulator.Screen.sized(12, 3);
    away.show(shown);
    away.feed("\x1b[1;3HXXXXXX\x1b[3;1HYYYY".to_bytes());
    ok(tally, "oracle: the screen was drawn on", away.differs_from(shown) != "");
    ok(tally, "oracle: a diff against what was believed to be shown writes nothing", TUI_diff.diff(shown, shown, TUI_style.Depth.Ansi16).size() == 0);
    away.feed(TUI_diff.full(shown, TUI_style.Depth.Ansi16));
    check(tally, "oracle: the full frame repairs it", away.differs_from(shown), "");
    // the switch, and a program that did not ask
    TUI_app.Loop calm = TUI_app.Loop(should_report_focus: true, should_repaint_on_focus: false);
    calm.dispatch(term.decode("\x1b[I".to_bytes())[0], Recorder(), TUI_app.NoMouse());
    ok(tally, "should_repaint_on_focus off: focus in repaints nothing", !calm.should_repaint);
    check_int(tally, "should_repaint_on_focus off: but is counted", calm.focus_changes, 1);
    TUI_app.Loop unasked = TUI_app.Loop();
    Recorder own = Recorder();
    unasked.dispatch(term.decode("\x1b[O".to_bytes())[0], own, TUI_app.NoMouse());
    check(tally, "not asked: the report is the program's", own.seen.join(","), "unknown[1b5b4f]");
    ok(tally, "not asked: has_focus stays true", unasked.has_focus);
    check_int(tally, "not asked: not counted", unasked.focus_changes, 0);
    ok(tally, "defaults: no focus mode in the enter or leave bytes", !(TUI_app.Loop().enter_sequence() + TUI_app.Loop().leave_sequence()).contains("1004"));
}

// --- 6. emoji sequences: widths against an independent table ------------------------------

int hex_value(str digits) {
    int value = 0;
    for (int index in 0 .. digits.size()) {
        int code = digits.byte_at(index);
        int digit = code - '0';
        if (code >= 'A' && code <= 'F') {
            digit = code - 'A' + 10;
        }
        value = value * 16 + digit;
    }
    return value;
}

/// Code points written in hex and separated by spaces, as text.
str from_hex(str codes) {
    List<int> chars = [];
    for (str piece in codes.split(" ")) {
        chars.push(hex_value(piece));
    }
    return str.from_chars(chars);
}

/// How many columns `text` takes when it is written to a buffer (one cell run).
int drawn(str text) {
    TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(12, 1);
    return buffer.set_str(0, 0, text, TUI_style.Style());
}

void width_table_tests(Tally tally) {
    head("emoji sequences: widths against Unicode's table");
    match (io.read("tests/emoji_sequences.txt")) {
        case Ok(str body): {
            int total = 0;
            int bad = 0;
            int stdlib_gaps = 0;
            int disagreements = 0;
            int modifier_disagreements = 0;
            str first_bad = "";
            for (str line in body.split("\n")) {
                if (line.size() == 0 || line.starts_with("#")) {
                    continue;
                }
                List<str> halves = line.split(";");
                str text = from_hex(halves[0]);
                total = total + 1;
                if (unicode.width(text) != 2) {
                    stdlib_gaps = stdlib_gaps + 1;
                }
                if (halves[1] != "2") {
                    disagreements = disagreements + 1;
                    if (halves[0].contains("1F3F")) {
                        modifier_disagreements = modifier_disagreements + 1;
                    }
                }
                TUI_buffer.Buffer buffer = TUI_buffer.Buffer.sized(8, 1);
                int used = buffer.set_str(0, 0, text, TUI_style.Style());
                if (unicode.graphemes(text).size() != 1 || TUI_text.width(text) != 2 || used != 2 || buffer.width_at(0, 0) != 2 || buffer.width_at(1, 0) != 0 || buffer.symbol_at(0, 0) != text) {
                    bad = bad + 1;
                    if (first_bad == "") {
                        first_bad = line;
                    }
                }
            }
            check_int(tally, "the table has every fully-qualified sequence of Unicode 15.1", total, 3773);
            check(tally, "each is one cell of two columns, one cluster, written whole " + first_bad, str(bad), "0");
            check_int(tally, "the standard library alone measures 45 of them as one column", stdlib_gaps, 45);
            check_int(tally, "python-wcwidth, the second opinion, agrees with it on those 45", disagreements, 45);
            check_int(tally, "all 45 are an emoji modifier after a base that is text-presentation by default", modifier_disagreements, 45);
        }
        case Err(io.Error error): {
            check(tally, "tests/emoji_sequences.txt can be read", "no", "yes");
        }
    }
    // what is not in that table, with what is expected and why
    check_int(tally, "a skin tone after a raised hand: two columns", drawn(from_hex("261D 1F3FD")), 2);
    check_int(tally, "text width agrees", TUI_text.width("ab" + from_hex("261D 1F3FD") + "cd"), 6);
    check_int(tally, "a skin tone after a base with emoji presentation: two", drawn(from_hex("1F44D 1F3FD")), 2);
    check_int(tally, "a lone variation selector draws nothing", drawn(from_hex("FE0F")), 0);
    check_int(tally, "nor does a lone text selector", drawn(from_hex("FE0E")), 0);
    check_int(tally, "text width agrees on both", TUI_text.width(from_hex("FE0F")) + TUI_text.width(from_hex("FE0E")), 0);
    check_int(tally, "a keycap without the selector (not fully qualified) is one column", drawn(from_hex("31 20E3")), 1);
    check_int(tally, "a flag is two", drawn(from_hex("1F1E9 1F1EA")), 2);
    check_int(tally, "a regional indicator alone is one (East Asian Width: neutral; terminals differ)", drawn(from_hex("1F1E9")), 1);
    check_int(tally, "a combining accent is no column of its own", drawn("e" + from_hex("301")), 1);
    check_int(tally, "a ZWJ family is two", drawn(from_hex("1F468 200D 1F469 200D 1F467")), 2);
    check_int(tally, "wrapping does not split a skin tone off its hand", TUI_text.wrap("ab " + from_hex("261D 1F3FD") + from_hex("261D 1F3FD"), 5).size(), 2);
}

/// Is the cluster one terminals disagree on?
bool is_uncertain(str codes) {
    str text = from_hex(codes);
    return TUI_text.is_uncertain_cluster(text, TUI_text.cluster_columns(text));
}

/// One uncertain cluster (as hex) with a name.
type Kind {
    str name;
    str codes;
}

List<Kind> kinds() {
    return [Kind("family", "1F468 200D 1F469 200D 1F467"), Kind("flag", "1F1E9 1F1EA"), Kind("keycap", "31 FE0F 20E3"), Kind("skin tone on a text base", "261D 1F3FD"), Kind("skin tone", "1F44D 1F3FD"), Kind("lone regional indicator", "1F1E9"), Kind("letter with a variation selector", "61 FE0F"), Kind("ZWJ sequence that is not an emoji", "2764 200D 1F525"), Kind("England", "1F3F4 E0067 E0062 E0065 E006E E0067 E007F"), Kind("text selector on a wide emoji", "231A FE0E"), Kind("couple with heart", "1F469 200D 2764 FE0F 200D 1F468"), Kind("hands of two skin tones", "1F9D1 1F3FB 200D 1F91D 200D 1F9D1 1F3FF")];
}

/// How the cells after `kind` look on a terminal of `model` (see `TST_emulator.Screen.width_model`)
/// after the frame is drawn, before and after it changed: "" when every cell past the cluster is right.
str repaired(Kind kind, int model, int regional, bool is_to_cluster, bool is_diff) {
    str suffix = "CDEFGHIJKLMNOP";
    TUI_buffer.Buffer with_cluster = TUI_buffer.Buffer.sized(20, 1);
    with_cluster.set_str(0, 0, "AB" + from_hex(kind.codes) + suffix, TUI_style.Style());
    int width = TUI_text.cluster_columns(from_hex(kind.codes));
    TUI_buffer.Buffer plain = TUI_buffer.Buffer.sized(20, 1);
    plain.set_str(0, 0, "AB" + "xy".substr(0, width) + suffix, TUI_style.Style());
    TUI_buffer.Buffer from = plain;
    TUI_buffer.Buffer target = with_cluster;
    if (!is_to_cluster) {
        from = with_cluster;
        target = plain;
    }
    TST_emulator.Screen screen = TST_emulator.Screen.sized(20, 1);
    screen.width_model = model;
    screen.regional_width = regional;
    TUI_style.Depth depth = TUI_style.Depth.Ansi16;
    if (is_diff) {
        screen.feed(TUI_diff.full(from, depth));
        screen.feed(TUI_diff.diff(from, target, depth));
    } else {
        screen.feed(TUI_diff.full(target, depth));
    }
    for (int x in 2 + width .. 20) {
        if (screen.symbol_at(x, 0) != target.symbol_at(x, 0)) {
            return "column " + str(x) + " shows [" + screen.symbol_at(x, 0) + "] and should show [" + target.symbol_at(x, 0) + "]";
        }
    }
    return "";
}

void uncertainty_tests(Tally tally) {
    head("clusters of uncertain width");
    ok(tally, "uncertain: a family", is_uncertain("1F468 200D 1F469 200D 1F467"));
    ok(tally, "uncertain: a flag", is_uncertain("1F1E9 1F1EA"));
    ok(tally, "uncertain: a keycap", is_uncertain("31 FE0F 20E3"));
    ok(tally, "uncertain: a skin tone on a text-presentation base (was not)", is_uncertain("261D 1F3FD"));
    ok(tally, "uncertain: a skin tone", is_uncertain("1F44D 1F3FD"));
    ok(tally, "uncertain: a regional indicator alone (was not)", is_uncertain("1F1E9"));
    ok(tally, "uncertain: a letter and a variation selector (was not)", is_uncertain("61 FE0F"));
    ok(tally, "uncertain: a joined sequence that is one column wide (was not)", is_uncertain("2764 200D 1F525"));
    ok(tally, "uncertain: a tag sequence", is_uncertain("1F3F4 E0067 E0062 E0065 E006E E0067 E007F"));
    ok(tally, "uncertain: a text selector on a wide emoji", is_uncertain("231A FE0E"));
    ok(tally, "uncertain: a plain emoji (its table may be older than ours)", is_uncertain("1F600"));
    ok(tally, "uncertain: a plain wide emoji with a high code point", is_uncertain("1FAE0"));
    ok(tally, "certain: a CJK character", !is_uncertain("4E2D"));
    ok(tally, "uncertain: a letter with a combining accent", is_uncertain("65 301"));
    ok(tally, "certain: a precomposed letter with an accent", !is_uncertain("E9"));
    ok(tally, "certain: ASCII, a CJK ideograph, a kana, a Hangul syllable, a box", !is_uncertain("41") && !is_uncertain("4E2D") && !is_uncertain("3042") && !is_uncertain("D55C") && !is_uncertain("2502"));
    ok(tally, "uncertain: an arrow, a Nerd Font glyph, a Cyrillic letter, halfwidth katakana", is_uncertain("2192") && is_uncertain("E0B0") && is_uncertain("416") && is_uncertain("FF76"));
    ok(tally, "uncertain, by the old rule: three Hangul jamo are two columns and several code points", is_uncertain("1100 1161 11A8"));
    ok(tally, "certain: ASCII", !is_uncertain("41"));
    ok(tally, "certain: a box-drawing character", !is_uncertain("2500"));
    ok(tally, "uncertain: a Devanagari conjunct (terminals add up its signs)", is_uncertain("915 94D 937"));
    ok(tally, "uncertain: a Devanagari syllable with a spacing mark", is_uncertain("915 93F"));
    check_int(tally, "reach: a family of five code points", TUI_text.uncertain_reach(from_hex("1F468 200D 1F469 200D 1F467"), 2), 8);
    check_int(tally, "reach: a flag", TUI_text.uncertain_reach(from_hex("1F1E9 1F1EA"), 2), 2);
    check_int(tally, "reach: a regional indicator alone is at least 2", TUI_text.uncertain_reach(from_hex("1F1E9"), 1), 2);
    check_int(tally, "reach: England, seven code points", TUI_text.uncertain_reach(from_hex("1F3F4 E0067 E0062 E0065 E006E E0067 E007F"), 2), 12);
    check_int(tally, "reach: never more than 16 columns", TUI_text.uncertain_reach(from_hex("1F468 200D 1F469 200D 1F467 200D 1F466 200D 1F468 200D 1F469 200D 1F467 200D 1F466"), 2), 14);
    // the terminal as oracle: a terminal that adds up code points and ones that segment them
    List<str> names = ["adds up code points", "segments, regional indicator 1", "segments, regional indicator 2", "adds up, regional indicator 2"];
    List<int> models = [0, 1, 1, 0];
    List<int> regionals = [1, 1, 2, 2];
    for (int which in 0 .. names.size()) {
        int failures = 0;
        str first = "";
        for (Kind kind in kinds()) {
            for (int variant in 0 .. 3) {
                str problem = "";
                if (variant == 0) {
                    problem = repaired(kind, models[which], regionals[which], true, true);
                } else if (variant == 1) {
                    problem = repaired(kind, models[which], regionals[which], false, true);
                } else {
                    problem = repaired(kind, models[which], regionals[which], true, false);
                }
                if (problem != "") {
                    failures = failures + 1;
                    if (first == "") {
                        first = kind.name + " (variant " + str(variant) + "): " + problem;
                    }
                }
            }
        }
        check(tally, "oracle, a terminal that " + names[which] + ": every cell past 12 clusters is right, drawn in, drawn out, drawn in full " + first, str(failures), "0");
    }
}

str action_name(TUI_app.Action action) {
    match (action) {
        case Continue: {
            return "continue";
        }
        case Redraw: {
            return "redraw";
        }
        case Quit: {
            return "quit";
        }
    }
}

void reply_tests(Tally tally) {
    head("the loop's own answers redraw the view");
    TUI_app.Loop loop = TUI_app.Loop(should_sync: true, should_disambiguate_keys: true);
    loop.start_keys();
    Recorder recorder = Recorder();
    check(tally, "the mode 2026 answer: redraw, so a view that shows is_sync is right", action_name(loop.dispatch(term.decode("\x1b[?2026;2$y".to_bytes())[0], recorder, TUI_app.NoMouse())), "redraw");
    ok(tally, "and it was taken", loop.is_sync);
    check(tally, "the kitty answer: redraw", action_name(loop.dispatch(term.decode("\x1b[?0u".to_bytes())[0], recorder, TUI_app.NoMouse())), "redraw");
    check(tally, "the attributes answer: redraw", action_name(loop.dispatch(term.decode("\x1b[?62;22c".to_bytes())[0], recorder, TUI_app.NoMouse())), "redraw");
    check(tally, "none of them reached the program", recorder.seen.join(","), "");
    check(tally, "a key is the program's, and its answer is its own", action_name(loop.dispatch(term.decode("x".to_bytes())[0], recorder, TUI_app.NoMouse())), "continue");
}

// --- 7. the input descriptor (what a viewer fed from a pipe needs) -----------------------

void input_tests(Tally tally) {
    head("input descriptor");
    check_int(tally, "default: standard input", TUI_app.Loop().input_fd, 0);
    check_int(tally, "default, input a terminal: 0", TUI_app.pick_input_fd(0, true, true), 0);
    check_int(tally, "default, input not a terminal: still 0 (the loop then says NotATerminal, as it did)", TUI_app.pick_input_fd(0, false, true), 0);
    check_int(tally, "auto, both terminals: standard input", TUI_app.pick_input_fd(TUI_app.INPUT_AUTO, true, true), 0);
    check_int(tally, "auto, input piped: the terminal that standard output is", TUI_app.pick_input_fd(TUI_app.INPUT_AUTO, false, true), 1);
    check_int(tally, "auto, neither: none", TUI_app.pick_input_fd(TUI_app.INPUT_AUTO, false, false), -1);
    check_int(tally, "auto, only input a terminal: standard input", TUI_app.pick_input_fd(TUI_app.INPUT_AUTO, true, false), 0);
    check_int(tally, "another descriptor is that one", TUI_app.pick_input_fd(7, false, false), 7);
}

// --- 8. the after-frame hook and the raw mouse (0.11.0) ----------------------------------

/// An `AfterFrame` that writes down what it was asked and answers a fixed sequence.
type Painter {
    bytes answer = [];
    int calls = 0;
    bool was_full = false;
    str corner = "";
}

bytes Painter.after_frame(TUI_buffer.Buffer frame, bool is_full) {
    calls = calls + 1;
    was_full = is_full;
    corner = frame.symbol_at(0, 0);
    return answer;
}

/// A `MouseHandler` that counts the gestures it was given.
type Counter {
    int gestures = 0;
}

TUI_app.Action Counter.handle_mouse(TUI_mouse.Routed routed) {
    gestures = gestures + 1;
    return TUI_app.Action.Continue;
}

/// Where `needle` first occurs in `text`, -1 when it does not.
int position(str text, str needle) {
    int last = text.size() - needle.size();
    for (int from_byte in 0 .. last + 1) {
        bool is_match = true;
        for (int offset in 0 .. needle.size()) {
            if (text.byte_at(from_byte + offset) != needle.byte_at(offset)) {
                is_match = false;
                break;
            }
        }
        if (is_match) {
            return from_byte;
        }
    }
    return -1;
}

/// Cursor-to-(x, y), then `text` scaled by OSC 66, as a program would write it.
bytes scaled_at(int x, int y, str text) {
    bytes out = [];
    TUI_diff.move_to(out, x, y);
    out.extend(("\x1b]66;s=2;" + text + "\x1b\\").to_bytes());
    return out;
}

void after_frame_tests(Tally tally) {
    head("after-frame hook");
    TUI_style.Depth depth = TUI_style.Depth.Ansi16;
    TUI_buffer.Buffer before = scene("old top", "old bottom");
    TUI_buffer.Buffer after = scene("new top", "new bottom");
    bytes body = TUI_diff.diff(before, after, depth);
    bytes everything = TUI_diff.full(after, depth);
    // no hook: the bytes of 0.10.0, whatever the loop is doing around them
    TUI_app.Loop none = TUI_app.Loop(depth: depth);
    check(tally, "no hook: a diff frame is compose_frame of the diff", TUI_diff.show(none.frame_bytes(before, after, false, TUI_app.Shown())), TUI_diff.show(none.compose_frame(body, TUI_app.Shown())));
    check(tally, "no hook: a full frame is compose_frame of the full redraw", TUI_diff.show(none.frame_bytes(before, after, true, TUI_app.Shown())), TUI_diff.show(none.compose_frame(everything, TUI_app.Shown())));
    check(tally, "no hook: compose_frame_with an empty extra is compose_frame", TUI_diff.show(none.compose_frame_with(body, [], TUI_app.Shown())), TUI_diff.show(none.compose_frame(body, TUI_app.Shown())));
    TUI_app.Loop wanted = TUI_app.Loop(depth: depth, is_sync: true);
    wanted.cursor.x = 3;
    wanted.cursor.y = 1;
    check(tally, "no hook, with sync and a cursor: still compose_frame", TUI_diff.show(wanted.frame_bytes(before, after, false, TUI_app.Shown())), TUI_diff.show(wanted.compose_frame(body, TUI_app.Shown())));
    check_int(tally, "no hook: a frame that changes nothing writes nothing", none.frame_bytes(after, after, false, TUI_app.Shown()).size(), 0);
    // a hook: its bytes follow the cells, in the same bytes
    Painter painter = Painter();
    painter.answer = scaled_at(2, 1, "hi");
    TUI_app.Loop hooked = TUI_app.Loop(depth: depth);
    hooked.after_frame = Option<TUI_app.AfterFrame>.Some(painter);
    bytes frame = hooked.frame_bytes(before, after, false, TUI_app.Shown());
    check(tally, "hook: the diff, then the hook's bytes", TUI_diff.show(frame), TUI_diff.show(body) + TUI_diff.show(painter.answer));
    check_int(tally, "hook: asked once for the frame", painter.calls, 1);
    ok(tally, "hook: told it was not a full frame", !painter.was_full);
    check(tally, "hook: given the buffer the frame shows", painter.corner, "n");
    hooked.frame_bytes(before, after, true, TUI_app.Shown());
    ok(tally, "hook: told when the frame is a full one", painter.was_full);
    check_int(tally, "hook: asked again, once", painter.calls, 2);
    // a frame with no changed cell is written for the hook's bytes
    check(tally, "hook, no cell changed: the hook's bytes alone", TUI_diff.show(hooked.frame_bytes(after, after, false, TUI_app.Shown())), TUI_diff.show(painter.answer));
    painter.answer = [];
    check_int(tally, "hook answering nothing, no cell changed: nothing is written", hooked.frame_bytes(after, after, false, TUI_app.Shown()).size(), 0);
    check(tally, "hook answering nothing: the bytes are the frame's own", TUI_diff.show(hooked.frame_bytes(before, after, false, TUI_app.Shown())), TUI_diff.show(body));
    // inside the synchronized update, and before the cursor is put back
    painter.answer = scaled_at(2, 1, "hi");
    hooked.is_sync = true;
    hooked.cursor.x = 3;
    hooked.cursor.y = 1;
    str shown_frame = TUI_diff.show(hooked.frame_bytes(before, after, false, TUI_app.Shown()));
    str sent = TUI_diff.show(painter.answer);
    ok(tally, "hook with sync: begins with the marker and ends with its end", shown_frame.starts_with("\\e[?2026h") && shown_frame.ends_with("\\e[?2026l"));
    ok(tally, "hook with sync: the hook's bytes are inside it", shown_frame.contains(sent));
    int at_hook = position(shown_frame, sent);
    int at_cursor = position(shown_frame, "\\e[2;4H");
    ok(tally, "hook with a cursor: the cursor is put back after the hook's bytes", at_hook >= 0 && at_cursor > at_hook);
    // the terminal as oracle: cells and the sequence arrive in one feed
    TUI_app.Loop live = TUI_app.Loop(depth: depth);
    Painter text = Painter();
    text.answer = scaled_at(0, 1, "big");
    live.after_frame = Option<TUI_app.AfterFrame>.Some(text);
    TST_emulator.Screen screen = TST_emulator.Screen.sized(12, 3);
    live.cursor.x = 4;
    live.cursor.y = 2;
    screen.show(before);
    screen.feed(live.frame_bytes(before, after, false, TUI_app.Shown()));
    check(tally, "oracle: the cells are drawn", screen.differs_from(after), "");
    check(tally, "oracle: the OSC 66 reached the terminal with them", screen.unknown.join(","), "OSC 66;s=2;big");
    check_int(tally, "oracle: and the cursor the view asked for is put back after the hook moved it", screen.cursor_y * 100 + screen.cursor_x, 204);
}

void raw_mouse_tests(Tally tally) {
    head("raw mouse");
    TUI_app.Loop routed = TUI_app.Loop(should_report_mouse: true);
    TUI_app.Loop raw = TUI_app.Loop(should_report_raw_mouse: true);
    check(tally, "raw: the same mode bytes on entry as routed", TUI_diff.show(raw.enter_sequence().to_bytes()), TUI_diff.show(routed.enter_sequence().to_bytes()));
    check(tally, "raw: the same mode bytes on the way out", TUI_diff.show(raw.leave_sequence().to_bytes()), TUI_diff.show(routed.leave_sequence().to_bytes()));
    ok(tally, "raw: mouse reporting is in the enter sequence", raw.enter_sequence().contains(term.MOUSE_ON));
    ok(tally, "raw: and taken off in the leave sequence", raw.leave_sequence().contains(term.MOUSE_OFF));
    TUI_app.Loop hover = TUI_app.Loop(should_report_raw_mouse: true, should_report_hover: true);
    ok(tally, "raw with hover: motion is asked for", hover.enter_sequence().contains(TUI_mouse.HOVER_ON) && hover.leave_sequence().contains(TUI_mouse.HOVER_OFF));
    ok(tally, "off by default: no mouse mode in the default sequences", !(TUI_app.Loop().enter_sequence() + TUI_app.Loop().leave_sequence()).contains(term.MOUSE_ON));
    TST_emulator.Screen terminal = TST_emulator.Screen.sized(12, 3);
    terminal.feed(raw.enter_sequence().to_bytes());
    terminal.feed(raw.leave_sequence().to_bytes());
    ok(tally, "oracle: enter and leave leave nothing the emulator did not understand", terminal.unknown.size() == 0);
    // dispatch: a report is an event for the program, and the router is not involved
    term.Event press = term.decode("\x1b[<0;5;2M".to_bytes())[0];
    Recorder seen = Recorder();
    Counter gestures = Counter();
    raw.dispatch(press, seen, gestures);
    check_int(tally, "raw: the report reaches on_event", seen.seen.size(), 1);
    check_int(tally, "raw: no gesture is routed", gestures.gestures, 0);
    Recorder none = Recorder();
    routed.dispatch(press, none, gestures);
    check_int(tally, "routed: on_event does not see the report (unchanged)", none.seen.size(), 0);
    ok(tally, "routed: the gesture goes to on_mouse (unchanged)", gestures.gestures > 0);
    Recorder off = Recorder();
    TUI_app.Loop().dispatch(press, off, Counter());
    check_int(tally, "neither asked: a report is on_event's, as before", off.seen.size(), 1);
    Recorder both = Recorder();
    Counter routing = Counter();
    TUI_app.Loop(should_report_mouse: true, should_report_raw_mouse: true).dispatch(press, both, routing);
    check_int(tally, "both asked: routing wins, on_event sees nothing", both.seen.size(), 0);
}

// --- 9. the escape wait (0.12.0); the pty test of what it does is tests/escape.m31 ----------

void escape_wait_tests(Tally tally) {
    head("escape wait");
    check_int(tally, "default: no escape wait of its own (the loop reads as it did)", TUI_app.Loop().escape_wait_ms, 0);
    check_int(tally, "set: it is what was asked", TUI_app.Loop(escape_wait_ms: 40).escape_wait_ms, 40);
    check_int(tally, "the read timeout is the ticker's alone: a timer still shortens it", TUI_app.read_timeout_ms(250, 5, 0), 5);
    check_int(tally, "and still never under one", TUI_app.read_timeout_ms(250, 5, 90), 1);
}

Tally score = Tally();
sync_tests(score);
clipboard_tests(score);
hyperlink_tests(score);
key_tests(score);
focus_tests(score);
width_table_tests(score);
uncertainty_tests(score);
reply_tests(score);
input_tests(score);
after_frame_tests(score);
raw_mouse_tests(score);
escape_wait_tests(score);
print("");
print("-- " + str(score.pass) + " passed, " + str(score.fail) + " failed");
if (score.fail > 0) {
    os.exit(1);
}
