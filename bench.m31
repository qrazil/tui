// How long a frame takes, and how many bytes it is.
//
//   bash apps/tui/check.sh          (runs this last)
//
// The budget is one frame in 16.6 ms, which is sixty frames a second. A
// terminal program redraws on a keystroke rather than on a clock, so the
// real target is "faster than the person notices", but 60 Hz is the number
// everyone compares against and it is the one printed below.
//
// Four measurements, on a 200x50 grid -- a full-screen terminal:
//
//   draw     laying a screenful of widgets into the buffer
//   full     `tuidiff.full`: every cell, as escape bytes
//   diff-1   `tuidiff.diff` after one cell changed
//   diff-0   `tuidiff.diff` with nothing changed -- the cost of the scan
//
// Times are the mean of many runs, because a single run of anything this
// fast measures the clock.

import date;
import tuibuf;
import tuidiff;
import tuidiffview;
import tuigeom;
import tuilists;
import tuioutline;
import tuistyle;
import tuitext;
import tuiwidget;

const int W = 200;
const int H = 50;

/// Lay a plausible screen into `b`: a title bar, a file list, a table and a
/// paragraph, all inside blocks.
void paint(tuibuf.Buffer b, int tick, List<str> names, List<List<str>> rows) {
    List<tuigeom.Rect> band = tuigeom.rows(b.area(), [tuigeom.Constraint.Length(3), tuigeom.Constraint.Fill(1), tuigeom.Constraint.Length(1)]);
    tuiwidget.Block top = tuiwidget.Block(title: " frame " + str(tick) + " ", borders: tuiwidget.Borders.Double, title_align: tuitext.Align.Center);
    top.render(b, band[0]);
    tuiwidget.Paragraph("a terminal user interface, drawn into a buffer of grapheme clusters", align: tuitext.Align.Center).render(b, top.inner(band[0]));
    List<tuigeom.Rect> mid = tuigeom.cols(band[1], [tuigeom.Constraint.Length(24), tuigeom.Constraint.Percentage(40), tuigeom.Constraint.Fill(1)]);
    tuiwidget.Block left = tuiwidget.Block(title: "files", borders: tuiwidget.Borders.Rounded);
    left.render(b, mid[0]);
    tuilists.ListView(names, selected: tick % 60, highlight_symbol: "\u{25B8} ").render(b, left.inner(mid[0]));
    tuiwidget.Block table = tuiwidget.Block(title: "table", pad_x: 1);
    table.render(b, mid[1]);
    tuilists.Table(["#", "name", "size", "when"], rows, [tuigeom.Constraint.Length(4), tuigeom.Constraint.Fill(1), tuigeom.Constraint.Length(8), tuigeom.Constraint.Length(9)], selected: tick % 60, highlight_symbol: "\u{25B8} ").render(b, table.inner(mid[1]));
    tuiwidget.Block right = tuiwidget.Block(title: "detail", pad_x: 1);
    right.render(b, mid[2]);
    tuiwidget.Paragraph("The quick brown fox jumps over the lazy dog. \u{6F22}\u{5B57}\u{6F22}\u{5B57}\u{6F22}\u{5B57}. Wrapping this paragraph is the part of the work that has to look at every grapheme cluster, so it is the part that decides whether a frame is fast. ".repeat(6)).render(b, right.inner(mid[2]));
    b.fill(band[2], " ", tuistyle.Style(fg: tuistyle.Colour.Indexed(0), bg: tuistyle.Colour.Indexed(7)));
    b.set_str(band[2].x + 1, band[2].y, "q quit   j/k move   ? help", tuistyle.Style(fg: tuistyle.Colour.Indexed(0), bg: tuistyle.Colour.Indexed(7)));
}

/// Nanoseconds, as milliseconds with three decimals, without floats.
str ms(int ns) {
    int us = ns / 1000;
    return str(us / 1000) + "." + pad3(us % 1000) + " ms";
}

str pad3(int v) {
    str s = str(v);
    while (s.size() < 3) {
        s = "0" + s;
    }
    return s;
}

void report(str name, int total_ns, int runs, int size) {
    str line = name;
    while (line.size() < 8) {
        line = line + " ";
    }
    print(line + ms(total_ns / runs) + "   " + str(size) + " bytes   (" + str(runs) + " runs)");
}

int budget = 16666666;
print("a " + str(W) + "x" + str(H) + " frame, " + str(W * H) + " cells");
print("the 60-frames-a-second budget is " + ms(budget));
print("");
// The data the screen shows, built once: what is being measured is the
// library's work per frame, not the program's own bookkeeping.
List<str> names = [];
List<List<str>> rows = [];
for (int n in 0 .. 60) {
    names.push("item-" + str(n) + ".txt");
    rows.push([str(n), "row " + str(n) + " of the table", str(n * 37 % 1000) + " B", "today"]);
}
tuibuf.Buffer front = tuibuf.Buffer.sized(W, H);
tuibuf.Buffer back = tuibuf.Buffer.sized(W, H);
tuistyle.Depth depth = tuistyle.Depth.Ansi256;
// Warm up, so the first measurement is not the first touch of the heap.
paint(back, 0, names, rows);
paint(front, 0, names, rows);
int runs = 200;
int t0 = date.now_ns();
int k = 0;
while (k < runs) {
    back.clear();
    paint(back, k, names, rows);
    k = k + 1;
}
int t1 = date.now_ns();
report("draw", t1 - t0, runs, 0);
back.clear();
paint(back, 1, names, rows);
int full_bytes = tuidiff.full(back, depth).size();
t0 = date.now_ns();
k = 0;
while (k < runs) {
    tuidiff.full(back, depth);
    k = k + 1;
}
t1 = date.now_ns();
report("full", t1 - t0, runs, full_bytes);
// One cell changed, which is what a cursor moving looks like.
front.clear();
paint(front, 1, names, rows);
back.clear();
paint(back, 1, names, rows);
back.set_str(100, 25, "\u{2588}", tuistyle.Style(fg: tuistyle.Colour.Indexed(9)));
int one_bytes = tuidiff.diff(front, back, depth).size();
t0 = date.now_ns();
k = 0;
while (k < runs) {
    tuidiff.diff(front, back, depth);
    k = k + 1;
}
t1 = date.now_ns();
report("diff-1", t1 - t0, runs, one_bytes);
back.clear();
paint(back, 1, names, rows);
int zero_bytes = tuidiff.diff(front, back, depth).size();
t0 = date.now_ns();
k = 0;
while (k < runs) {
    tuidiff.diff(front, back, depth);
    k = k + 1;
}
t1 = date.now_ns();
report("diff-0", t1 - t0, runs, zero_bytes);
// And the honest number a program actually pays per keystroke: paint the
// next frame and diff it against the last one.
front.clear();
paint(front, 0, names, rows);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    back.clear();
    paint(back, k, names, rows);
    tuidiff.diff(front, back, depth);
    k = k + 1;
}
t1 = date.now_ns();
report("frame", t1 - t0, runs, 0);
// --- the shapes a real client hits that the screen above does not -----------
//
// A git client's log is a tall outline -- hundreds of commits, each unfolding
// into files -- and one keystroke on it is a cursor move, a "what is under
// the cursor" and a redraw. A diff is a flat run of thousands of lines with
// the same three operations. Neither is a 50-row screen, and both used to be
// paid for per visible row of the WHOLE document rather than per row on
// screen, which is what these four numbers watch.
print("");
print("a 5,200-row outline (200 sections of 25), 2,000-line diff, 72-column wrap");
List<tuioutline.Node> roots = [];
for (int s in 0 .. 200) {
    List<tuioutline.Node> kids = [];
    for (int c in 0 .. 25) {
        kids.push(tuioutline.Node.leaf("s" + str(s) + ":" + str(c), "M  path/to/some/file-" + str(c) + ".txt  +12 -3"));
    }
    roots.push(tuioutline.Node.section("s" + str(s), str(s) + "  a commit subject line of ordinary length", kids));
}
tuioutline.Outline o = tuioutline.Outline(roots);
tuigeom.Rect screen = tuigeom.Rect(0, 0, W, H);
o.cursor = 2600;
o.render(back, screen);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    o.move(1);
    o.current();
    o.render(back, screen);
    k = k + 1;
}
t1 = date.now_ns();
report("outline", t1 - t0, runs, 0);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    o.select_id("s199:24");
    k = k + 1;
}
t1 = date.now_ns();
report("select", t1 - t0, runs, 0);
List<tuidiffview.Hunk> hunks = [];
for (int h in 0 .. 40) {
    List<tuidiffview.Line> ls = [];
    for (int l in 0 .. 50) {
        if (l % 3 == 0) {
            ls.push(tuidiffview.Line.added("    added line " + str(l) + " of hunk " + str(h)));
        } else if (l % 3 == 1) {
            ls.push(tuidiffview.Line.removed("    removed line " + str(l) + " of hunk " + str(h)));
        } else {
            ls.push(tuidiffview.Line.context("    context line " + str(l) + " of hunk " + str(h)));
        }
    }
    hunks.push(tuidiffview.Hunk("@@ -" + str(h * 50) + ",50 +" + str(h * 50) + ",50 @@", ls));
}
tuidiffview.DiffView dv = tuidiffview.DiffView(hunks);
dv.cursor = 1000;
dv.render(back, screen);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    dv.move(1);
    dv.at();
    dv.render(back, screen);
    k = k + 1;
}
t1 = date.now_ns();
report("diffview", t1 - t0, runs, 0);
str prose = "The quick brown fox jumps over the lazy dog, and a commit message of ordinary length is wrapped to seventy-two columns every time the outline is rebuilt. ".repeat(12);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    tuitext.wrap(prose, 72);
    k = k + 1;
}
t1 = date.now_ns();
report("wrap", t1 - t0, runs, prose.size());
// What `tuiapp.Loop` pays before a frame is even drawn: a fresh buffer, or
// the same one cleared.
t0 = date.now_ns();
k = 0;
while (k < runs) {
    tuibuf.Buffer.sized(W, H);
    k = k + 1;
}
t1 = date.now_ns();
report("alloc", t1 - t0, runs, 0);
t0 = date.now_ns();
k = 0;
while (k < runs) {
    back.clear();
    k = k + 1;
}
t1 = date.now_ns();
report("clear", t1 - t0, runs, 0);
