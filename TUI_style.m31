// Colours, attributes, and the bytes a terminal wants for them.
//
// API
// ---
//   TUI_style.Colour           Default | Indexed(index) | Rgb(red, green, blue)
//   TUI_style.Style            foreground, background, attrs -- constructed with named arguments
//   TUI_style.Depth            Ansi16 | Ansi256 | TrueColour
//   TUI_style.BOLD .. STRIKE   the attribute bits
//   style.pack()              a whole style as one `int`, which is what a
//                             `Buffer` stores and what the diff compares
//   TUI_style.sgr(out, from, to, depth)   the escape that turns one packed
//                             style into another, appended to `out`
//   TUI_style.Theme            a named palette of `Style`s, by role
//
// **A style is one `int`.** A buffer of 200x50 holds ten thousand cells, and
// a `Style` object per cell would be thirty thousand refcounted allocations
// per frame: one for the style and one for each of its two colours. So the
// public type is a struct, the stored form is a packed integer, and `pack`
// and `unpack` are the door between them. The packing is:
//
//     bits  0..24   foreground colour code
//     bits 25..49   background colour code
//     bits 50..55   attribute bits
//
// and a colour code is
//
//     0                      the terminal's default
//     1 + n                  palette entry n, 0..255
//     0x1000000 | 0xRRGGBB   a 24-bit colour
//
// Twenty-five bits each, six for the attributes, fifty-six in all: it fits
// in an `int` with room left, and the sign bit is never reached, so a packed
// style is always positive and `==` on two of them is the whole comparison
// the renderer needs.

/// Bold.
pub const int BOLD = 1;
/// Faint.
pub const int DIM = 2;
/// Italic.
pub const int ITALIC = 4;
/// Underlined.
pub const int UNDERLINE = 8;
/// Foreground and background swapped.
pub const int REVERSE = 16;
/// Struck through.
pub const int STRIKE = 32;
/// Every attribute bit, for masking.
pub const int ATTR_ALL = 63;
const int COL_BITS = 25;
const int COL_MASK = 0x1FF_FFFF;
const int COL_RGB = 0x100_0000;
const int ATTR_SHIFT = 50;

/// A colour, in the three forms a terminal understands.
///
/// `Indexed` is the 256-entry xterm palette, whose first sixteen entries are
/// the colours a 16-colour terminal has. `Rgb` is 24-bit. Either is written
/// out in whatever the `Depth` allows, converting down to the nearest entry
/// of the smaller palette -- so a program picks the colour it means and the
/// terminal decides what it gets.
pub enum Colour {
    Default;
    Indexed(int);
    Rgb(int, int, int);
}

/// The colour as its packed code. **Traps** on an index outside 0..255 or a
/// component outside 0..255: a palette entry the terminal has no name for is
/// the program's mistake, not the user's.
pub int Colour.code() {
    match (this) {
        case Default: {
            return 0;
        }
        case Indexed(int index): {
            if (index < 0 || index > 255) {
                trap("TUI_style.Colour.Indexed: a palette index is 0..255");
            }
            return 1 + index;
        }
        case Rgb(int red, int green, int blue): {
            if (red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255) {
                trap("TUI_style.Colour.Rgb: each component is 0..255");
            }
            return COL_RGB | red * 65536 | green * 256 | blue;
        }
    }
}

/// The colour a packed code names. The inverse of `code`.
pub static Colour Colour.from_code(int colour_code) {
    if (colour_code == 0) {
        return Colour.Default;
    }
    if (colour_code < COL_RGB) {
        return Colour.Indexed(colour_code - 1);
    }
    int rgb_value = colour_code & 0xFF_FFFF;
    return Colour.Rgb(rgb_value / 65536, rgb_value / 256 % 256, rgb_value % 256);
}

pub bool Colour.eq(Colour other) {
    return code() == other.code();
}

pub str Colour.to_str() {
    match (this) {
        case Default: {
            return "default";
        }
        case Indexed(int index): {
            return "index " + str(index);
        }
        case Rgb(int red, int green, int blue): {
            return "rgb " + str(red) + "," + str(green) + "," + str(blue);
        }
    }
}

/// How a cell is drawn: two colours and a set of attribute bits.
///
/// Every field has a default, so every field is named at construction and
/// `Style()` is the terminal's own idea of plain text:
///
/// ```
/// TUI_style.Style(foreground: TUI_style.Colour.Indexed(3), attrs: TUI_style.BOLD)
/// ```
pub type Style {
    pub Colour foreground = Colour.Default;
    pub Colour background = Colour.Default;
    pub int attrs = 0;
}

/// The plain style: both colours the terminal's own, no attributes.
pub static Style Style.plain() {
    return Style();
}

/// The style as one `int`, the form a `Buffer` stores.
pub int Style.pack() {
    return foreground.code() | background.code() << COL_BITS | (attrs & ATTR_ALL) << ATTR_SHIFT;
}

/// The style a packed `int` holds. The inverse of `pack`.
pub static Style Style.unpack(int packed) {
    return Style(foreground: Colour.from_code(packed & COL_MASK), background: Colour.from_code(packed >> COL_BITS & COL_MASK), attrs: packed >> ATTR_SHIFT & ATTR_ALL);
}

pub bool Style.eq(Style other) {
    return pack() == other.pack();
}

/// This style with `colour` as the foreground. A new `Style`; nothing is changed.
pub Style Style.with_foreground(Colour colour) {
    return Style(foreground: colour, background: background, attrs: attrs);
}

/// This style with `colour` as the background.
pub Style Style.with_background(Colour colour) {
    return Style(foreground: foreground, background: colour, attrs: attrs);
}

/// This style with `bits` added to its attributes.
pub Style Style.with_attrs(int bits) {
    return Style(foreground: foreground, background: background, attrs: attrs | bits & ATTR_ALL);
}

/// `over` laid on top of this one: each of `over`'s colours wins unless it
/// is `Default`, and their attributes are combined. This is what a widget
/// does with a highlight style.
pub Style Style.merged(Style over) {
    Colour merged_foreground = foreground;
    Colour merged_background = background;
    if (over.foreground.code() != 0) {
        merged_foreground = over.foreground;
    }
    if (over.background.code() != 0) {
        merged_background = over.background;
    }
    return Style(foreground: merged_foreground, background: merged_background, attrs: attrs | over.attrs);
}

pub str Style.to_str() {
    return "fg " + foreground.to_str() + ", bg " + background.to_str() + ", attrs " + str(attrs);
}

/// How many colours the terminal has. Stage 3 detects this; until then a
/// program says which it wants and the diff writes accordingly.
pub enum Depth {
    /// The original eight, and their bright forms: SGR 30-37 and 90-97.
    Ansi16;
    /// The xterm palette: SGR 38;5;n.
    Ansi256;
    /// 24-bit: SGR 38;2;r;g;b.
    TrueColour;
}

// --- the escape sequences ---------------------------------------------------

/// Append the decimal digits of `value` to `out`, without building a `str`.
///
/// `str(v).to_bytes()` is two allocations per number, and a frame writes a
/// few thousand numbers. This writes into the frame's own buffer.
pub void push_int(bytes out, int value) {
    if (value < 0) {
        out.push('-');
        push_int(out, -value);
        return;
    }
    if (value >= 10) {
        push_int(out, value / 10);
    }
    out.push(48 + value % 10);
}

/// Append `\x1b[` to `out`.
pub void push_csi(bytes out) {
    out.push(27);
    out.push('[');
}

/// The escape sequence that turns a terminal showing style `from` into one
/// showing style `to`, appended to `out`. Nothing at all when they are equal.
///
/// Only what changed is written: attributes that went away as their own
/// "off" codes rather than a reset, and a colour only when it is a different
/// colour. `from` is the pen the terminal is holding; at the start of a frame
/// that is `RESET_STYLE`, which is what `\x1b[0m` leaves behind.
pub void sgr(bytes out, int from, int target, Depth depth) {
    if (from == target) {
        return;
    }
    int old_attrs = from >> ATTR_SHIFT & ATTR_ALL;
    int new_attrs = target >> ATTR_SHIFT & ATTR_ALL;
    int turned_off = old_attrs & ~new_attrs;
    int turned_on = new_attrs & ~old_attrs;
    int old_foreground = from & COL_MASK;
    int new_foreground = target & COL_MASK;
    int old_background = from >> COL_BITS & COL_MASK;
    int new_background = target >> COL_BITS & COL_MASK;
    // Every difference below writes at least one parameter, so this is
    // exactly "would there be any": nothing is written for two styles that
    // differ only in bits `pack` never sets.
    if (turned_off == 0 && turned_on == 0 && old_foreground == new_foreground && old_background == new_background) {
        return;
    }
    // The parameters go straight into the frame's own bytes, `;`-separated
    // as they come, rather than into a list that is then copied out: a
    // frame with colour in it changes the pen hundreds of times.
    Sgr codes = Sgr(out);
    push_csi(out);
    // SGR 22 turns off bold AND dim together, so whichever of the two
    // survives has to be written again after it.
    if ((turned_off & (BOLD | DIM)) != 0) {
        codes.code(22);
        if ((new_attrs & BOLD) != 0) {
            codes.code(1);
        }
        if ((new_attrs & DIM) != 0) {
            codes.code(2);
        }
        turned_on = turned_on & ~(BOLD | DIM);
    }
    if ((turned_off & ITALIC) != 0) {
        codes.code(23);
    }
    if ((turned_off & UNDERLINE) != 0) {
        codes.code(24);
    }
    if ((turned_off & REVERSE) != 0) {
        codes.code(27);
    }
    if ((turned_off & STRIKE) != 0) {
        codes.code(29);
    }
    if ((turned_on & BOLD) != 0) {
        codes.code(1);
    }
    if ((turned_on & DIM) != 0) {
        codes.code(2);
    }
    if ((turned_on & ITALIC) != 0) {
        codes.code(3);
    }
    if ((turned_on & UNDERLINE) != 0) {
        codes.code(4);
    }
    if ((turned_on & REVERSE) != 0) {
        codes.code(7);
    }
    if ((turned_on & STRIKE) != 0) {
        codes.code(9);
    }
    if (old_foreground != new_foreground) {
        colour_codes(codes, new_foreground, depth, false);
    }
    if (old_background != new_background) {
        colour_codes(codes, new_background, depth, true);
    }
    out.push('m');
}

/// The parameters of one SGR sequence, written as they are decided: the
/// first bare, every later one after a `;`.
type Sgr {
    bytes out;
    bool first = true;
}

void Sgr.code(int value) {
    if (!first) {
        out.push(';');
    }
    first = false;
    push_int(out, value);
}

/// `\x1b[0m`, the sequence that puts the terminal back to `RESET_STYLE`.
pub void push_reset(bytes out) {
    push_csi(out);
    out.push('0');
    out.push('m');
}

/// The packed style a terminal is in after `\x1b[0m`: both colours its own,
/// no attributes. A full redraw starts from here.
pub const int RESET_STYLE = 0;

/// The SGR parameters for colour code `colour_code`, at this depth, on the foreground
/// or on the background.
void colour_codes(Sgr codes, int colour_code, Depth depth, bool back) {
    int base = 30;
    if (back) {
        base = 40;
    }
    if (colour_code == 0) {
        codes.code(base + 9);
        return;
    }
    if (colour_code >= COL_RGB) {
        int rgb_value = colour_code & 0xFF_FFFF;
        match (depth) {
            case TrueColour: {
                codes.code(base + 8);
                codes.code(2);
                codes.code(rgb_value / 65536);
                codes.code(rgb_value / 256 % 256);
                codes.code(rgb_value % 256);
            }
            case Ansi256: {
                codes.code(base + 8);
                codes.code(5);
                codes.code(rgb_to_256(rgb_value));
            }
            case Ansi16: {
                push_basic(codes, rgb_to_16(rgb_value), base);
            }
        }
        return;
    }
    int palette_index = colour_code - 1;
    match (depth) {
        case TrueColour: {
            if (palette_index < 16) {
                push_basic(codes, palette_index, base);
            } else {
                codes.code(base + 8);
                codes.code(5);
                codes.code(palette_index);
            }
        }
        case Ansi256: {
            if (palette_index < 16) {
                push_basic(codes, palette_index, base);
            } else {
                codes.code(base + 8);
                codes.code(5);
                codes.code(palette_index);
            }
        }
        case Ansi16: {
            if (palette_index < 16) {
                push_basic(codes, palette_index, base);
            } else {
                push_basic(codes, rgb_to_16(palette_rgb(palette_index)), base);
            }
        }
    }
}

/// One of the sixteen, as SGR 30-37 or 90-97 (100-107 on a background).
void push_basic(Sgr codes, int basic_index, int base) {
    if (basic_index < 8) {
        codes.code(base + basic_index);
    } else {
        codes.code(base + 52 + basic_index);
    }
}

// The xterm palette. Sixteen named colours, then a 6x6x6 cube on the levels
// below, then twenty-four greys. Every terminal emulator agrees on these
// numbers; they are the ones xterm's `256colres.pl` generates.
const Array<int> ANSI16 = [0x000000, 0x800000, 0x008000, 0x808000, 0x000080, 0x800080, 0x008080, 0xC0C0C0, 0x808080, 0xFF0000, 0x00FF00, 0xFFFF00, 0x0000FF, 0xFF00FF, 0x00FFFF, 0xFFFFFF];
const Array<int> CUBE = [0, 95, 135, 175, 215, 255];

/// The 24-bit colour palette entry `palette_index` stands for.
pub int palette_rgb(int palette_index) {
    if (palette_index < 0 || palette_index > 255) {
        trap("TUI_style.palette_rgb: a palette index is 0..255");
    }
    if (palette_index < 16) {
        return ANSI16[palette_index];
    }
    if (palette_index < 232) {
        int cube_offset = palette_index - 16;
        return CUBE[cube_offset / 36] * 65536 | CUBE[cube_offset / 6 % 6] * 256 | CUBE[cube_offset % 6];
    }
    int grey_level = 8 + (palette_index - 232) * 10;
    return grey_level * 65536 | grey_level * 256 | grey_level;
}

/// The palette entry closest to a 24-bit colour: the nearer of the cube
/// entry and the grey ramp entry, by squared distance in RGB.
pub int rgb_to_256(int rgb_value) {
    int red = rgb_value / 65536;
    int green = rgb_value / 256 % 256;
    int blue = rgb_value % 256;
    int cube_entry = 16 + cube_level(red) * 36 + cube_level(green) * 6 + cube_level(blue);
    int cube_distance = dist(palette_rgb(cube_entry), red, green, blue);
    int grey_entry = grey_index(red, green, blue);
    int grey_distance = dist(palette_rgb(grey_entry), red, green, blue);
    if (grey_distance < cube_distance) {
        return grey_entry;
    }
    return cube_entry;
}

/// The one of the sixteen closest to a 24-bit colour.
pub int rgb_to_16(int rgb_value) {
    int red = rgb_value / 65536;
    int green = rgb_value / 256 % 256;
    int blue = rgb_value % 256;
    int best = 0;
    int best_distance = dist(ANSI16[0], red, green, blue);
    for (int i in 1 .. 16) {
        int distance = dist(ANSI16[i], red, green, blue);
        if (distance < best_distance) {
            best_distance = distance;
            best = i;
        }
    }
    return best;
}

int cube_level(int component) {
    int index = 0;
    int best = 0;
    int best_distance = 1000;
    while (index < 6) {
        int distance = CUBE[index] - component;
        if (distance < 0) {
            distance = -distance;
        }
        if (distance < best_distance) {
            best_distance = distance;
            best = index;
        }
        index = index + 1;
    }
    return best;
}

int grey_index(int red, int green, int blue) {
    int avg = (red + green + blue) / 3;
    if (avg < 8) {
        return 232;
    }
    if (avg > 238) {
        return 255;
    }
    return 232 + (avg - 8) / 10;
}

int dist(int rgb_value, int red, int green, int blue) {
    int red_delta = rgb_value / 65536 - red;
    int green_delta = rgb_value / 256 % 256 - green;
    int blue_delta = rgb_value % 256 - blue;
    return red_delta * red_delta + green_delta * green_delta + blue_delta * blue_delta;
}

// --- the styling layer: a named palette --------------------------------------
//
// Stage 1 gave every widget its own `Style` fields, each with its own
// hard-coded default -- `Block`'s border, `ListView`'s highlight. That is
// fine for one screen; a program that wants to re-skin itself, or offer a
// light and a dark theme, needs one place holding every role a widget might
// draw in, so that changing the palette is changing one value rather than
// every call site that constructed a `Style` by hand.
//
// `Theme` is that place: a plain struct of `Style` fields, one per role, each
// with a sensible default so `Theme()` is a working plain theme exactly as
// `Style()` is a working plain style. A widget that wants theming takes a
// `Theme` (or a field of one) the same way it already takes a `Style` --
// there is no registry and no lookup by name, because a struct field
// reached at compile time is what this language's interfaces already give
// for free, and a `Map<str, Style>` would only add a way to look up a role
// that does not exist.

/// A named palette of styles for a program's own UI: one role per field, so
/// re-skinning the whole thing is replacing one `Theme` value rather than
/// hunting down every `Style(...)` a widget was built with.
///
/// The roles are the ones `apps/git/design.md` names widgets needing --
/// a title, a dimmed line, an accent, a selection, an error, and the two a
/// diff colours its added and removed lines with -- plus `normal` and
/// `border` for everything else. A program with roles of its own embeds this
/// or writes a bigger struct; nothing here stops it.
pub type Theme {
    /// Plain text, on the terminal's own background.
    pub Style normal = Style();
    /// De-emphasised text -- a timestamp, a hint, a line the cursor is not on.
    pub Style dim = Style(attrs: DIM);
    /// A heading or a panel title.
    pub Style title = Style(attrs: BOLD);
    /// Drawn attention: the active tab, a highlighted match.
    pub Style accent = Style(foreground: Colour.Indexed(33));
    /// What the cursor is on, when the row is not also `selected`.
    pub Style highlight = Style(attrs: REVERSE);
    /// The chosen row of a list, an outline, a jump list.
    pub Style selected = Style(attrs: REVERSE | BOLD);
    /// A problem: a failed command, a conflict.
    pub Style error = Style(foreground: Colour.Indexed(9));
    /// A line a diff view added.
    pub Style added = Style(foreground: Colour.Indexed(2));
    /// A line a diff view removed.
    pub Style removed = Style(foreground: Colour.Indexed(1));
    /// A block's border and rule characters.
    pub Style border = Style();
}

/// The plain theme: every role its own bare default, the same values a
/// widget used before `Theme` existed.
pub static Theme Theme.plain() {
    return Theme();
}
