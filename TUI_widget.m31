// The widget protocol, and the two widgets everything else is drawn inside.
//
// API
// ---
//   interface TUI_widget.Widget { void render(Buffer buffer, Rect area); }
//   TUI_widget.Block(...)      borders, a title and padding; `block.inner(area)`
//   TUI_widget.Paragraph(text) wrapped, aligned, scrollable text
//   TUI_widget.Span(text, style)   a run of text in one style
//   TUI_widget.Line(spans)     spans drawn left to right on one row -- a Widget
//
// --- the protocol is one method ---------------------------------------------
//
// ```
// interface Widget {
//     void render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area);
// }
// ```
//
// That is the whole of it, and it is a one-method interface, so **anything**
// satisfies it: a struct with fields, the name of a plain function, or a
// lambda written at the call site (reference §6.7). A program's own widget
// needs no registration, no base type and no declaration that it is one --
// it needs a `render` method with that signature. `apps/tui/tests.m31` writes
// one of each of the three to prove it.
//
// A widget is **not** told where it is on the screen by a field; it is
// handed the rectangle. So the same value can be drawn twice in two places,
// and a container widget is a widget that cuts its rectangle up with
// `TUI_geometry` and hands the parts on.
//
// --- composing ---------------------------------------------------------------
//
// There is no `.block(...)` on every widget, the way ratatui has. A block
// and its content are two widgets and the caller puts them together:
//
// ```
// TUI_widget.Block block = TUI_widget.Block(title: "Logs");
// block.render(buffer, area);
// para.render(buffer, block.inner(area));
// ```
//
// Two lines instead of one, and in exchange every widget stays independent
// of `Block`, `inner` is available on its own, and a widget a program writes
// is no harder to use than a widget shipped here.

import TUI_buffer;
import TUI_geometry;
import TUI_style;
import TUI_text;

/// Anything that can draw itself into a rectangle of a buffer.
pub interface Widget {
    void render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area);
}

/// The top edge.
pub const int TOP = 1;
/// The right edge.
pub const int RIGHT = 2;
/// The bottom edge.
pub const int BOTTOM = 4;
/// The left edge.
pub const int LEFT = 8;
/// All four edges: the default.
pub const int SIDES_ALL = 15;

/// Which line-drawing characters a block's border is made of.
pub enum Borders {
    /// No border at all. The block is then a background and a title.
    None;
    /// `┌─┐`
    Single;
    /// `╔═╗`
    Double;
    /// `╭─╮`
    Rounded;
    /// `┏━┓`
    Thick;
}

/// Which row of `BORDER` this set is, or -1 for `None`.
int Borders.row() {
    match (this) {
        case None: {
            return -1;
        }
        case Single: {
            return 0;
        }
        case Double: {
            return 1;
        }
        case Rounded: {
            return 2;
        }
        case Thick: {
            return 3;
        }
    }
}

// Six characters a set: horizontal, vertical, and the four corners.
const Array<str> BORDER = ["\u{2500}", "\u{2502}", "\u{250C}", "\u{2510}", "\u{2514}", "\u{2518}", "\u{2550}", "\u{2551}", "\u{2554}", "\u{2557}", "\u{255A}", "\u{255D}", "\u{2500}", "\u{2502}", "\u{256D}", "\u{256E}", "\u{2570}", "\u{256F}", "\u{2501}", "\u{2503}", "\u{250F}", "\u{2513}", "\u{2517}", "\u{251B}"];

/// A frame around a rectangle: a border, a title on the top edge, and
/// padding inside.
///
/// Every field has a default, so a plain single-line box is `Block()` and
/// everything else is named:
///
/// ```
/// TUI_widget.Block(title: "Files", borders: TUI_widget.Borders.Rounded, pad_x: 1)
/// ```
///
/// **Render the block before its content.** `render` fills its rectangle
/// with the block's style first, which is what makes a coloured panel one
/// call; content drawn into `inner(area)` afterwards sits on top of it.
pub type Block {
    pub Borders borders = Borders.Single;
    /// Which edges are drawn, as `TOP | RIGHT | BOTTOM | LEFT`.
    pub int sides = SIDES_ALL;
    pub str title = "";
    pub TUI_text.Align title_align = TUI_text.Align.Left;
    /// The border and the background.
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style title_style = TUI_style.Style();
    /// Blank columns between the border and the content.
    pub int pad_x = 0;
    /// Blank rows between the border and the content.
    pub int pad_y = 0;
}

bool Block.drawn(int side) {
    return borders.row() >= 0 && (sides & side) != 0;
}

/// The rectangle left for content: `area` less the edges that are drawn,
/// less the padding. A title with no top border still takes its row.
pub TUI_geometry.Rect Block.inner(TUI_geometry.Rect area) {
    int left = 0;
    int right = 0;
    int top = 0;
    int bottom = 0;
    if (drawn(LEFT)) {
        left = 1;
    }
    if (drawn(RIGHT)) {
        right = 1;
    }
    if (drawn(TOP)) {
        top = 1;
    }
    if (drawn(BOTTOM)) {
        bottom = 1;
    }
    if (top == 0 && title != "") {
        top = 1;
    }
    int inner_x = area.x + left;
    int inner_y = area.y + top;
    int inner_width = area.width - left - right;
    int inner_height = area.height - top - bottom;
    if (inner_width < 0) {
        inner_width = 0;
    }
    if (inner_height < 0) {
        inner_height = 0;
    }
    return TUI_geometry.Rect(inner_x, inner_y, inner_width, inner_height).inset_xy(pad_x, pad_y);
}

pub void Block.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    int row = borders.row();
    if (row >= 0) {
        int base = row * 6;
        str horizontal = BORDER[base];
        str vertical = BORDER[base + 1];
        if (drawn(TOP)) {
            buffer.fill(TUI_geometry.Rect(area.x, area.y, area.width, 1), horizontal, style);
        }
        if (drawn(BOTTOM) && area.height >= 2) {
            buffer.fill(TUI_geometry.Rect(area.x, area.bottom() - 1, area.width, 1), horizontal, style);
        }
        if (drawn(LEFT)) {
            buffer.fill(TUI_geometry.Rect(area.x, area.y, 1, area.height), vertical, style);
        }
        if (drawn(RIGHT) && area.width >= 2) {
            buffer.fill(TUI_geometry.Rect(area.right() - 1, area.y, 1, area.height), vertical, style);
        }
        if (drawn(TOP) && drawn(LEFT)) {
            buffer.set_str(area.x, area.y, BORDER[base + 2], style);
        }
        if (drawn(TOP) && drawn(RIGHT) && area.width >= 2) {
            buffer.set_str(area.right() - 1, area.y, BORDER[base + 3], style);
        }
        if (drawn(BOTTOM) && drawn(LEFT) && area.height >= 2) {
            buffer.set_str(area.x, area.bottom() - 1, BORDER[base + 4], style);
        }
        if (drawn(BOTTOM) && drawn(RIGHT) && area.width >= 2 && area.height >= 2) {
            buffer.set_str(area.right() - 1, area.bottom() - 1, BORDER[base + 5], style);
        }
    }
    if (title == "") {
        return;
    }
    int left = 0;
    int right = 0;
    if (drawn(LEFT)) {
        left = 1;
    }
    if (drawn(RIGHT)) {
        right = 1;
    }
    int room = area.width - left - right;
    if (room <= 0) {
        return;
    }
    str title_text = TUI_text.truncate(title, room);
    int title_x = area.x + left + TUI_text.offset(title_text, room, title_align);
    buffer.set_str(title_x, area.y, title_text, title_style, max: room);
}

/// Text in a rectangle: wrapped or not, aligned, and scrolled vertically.
///
/// `text` is mandatory and positional; everything else is named.
///
/// ```
/// TUI_widget.Paragraph(body, align: TUI_text.Align.Center, scroll: 4)
/// ```
pub type Paragraph {
    pub str text;
    /// Break long lines to the width of the rectangle. With this off, a long
    /// line is truncated instead.
    pub bool wrap = true;
    pub TUI_text.Align align = TUI_text.Align.Left;
    /// How many wrapped lines to skip at the top.
    pub int scroll = 0;
    pub TUI_style.Style style = TUI_style.Style();
    /// Put on the end of a line that had to be cut. Only used when `wrap` is
    /// off.
    pub str ellipsis = TUI_text.ELLIPSIS;
}

/// The lines this paragraph would draw in a rectangle `room` columns wide --
/// what a scrollbar needs to know, and what `scroll` counts.
pub List<str> Paragraph.lines(int room) {
    if (wrap) {
        return TUI_text.wrap(text, room);
    }
    List<str> out = [];
    for (str line in text.split("\n")) {
        if (line.ends_with("\r")) {
            out.push(line.substr(0, line.size() - 1));
        } else {
            out.push(line);
        }
    }
    return out;
}

pub void Paragraph.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    List<str> wrapped = lines(area.width);
    int from = scroll;
    if (from < 0) {
        from = 0;
    }
    int screen_row = 0;
    while (screen_row < area.height) {
        int line_index = from + screen_row;
        if (line_index >= wrapped.size()) {
            return;
        }
        str line = TUI_text.truncate(wrapped[line_index], area.width, ellipsis: ellipsis);
        int x = area.x + TUI_text.offset(line, area.width, align);
        buffer.set_str(x, area.y + screen_row, line, style, max: area.width - (x - area.x));
        screen_row = screen_row + 1;
    }
}

// --- styled spans -------------------------------------------------------------
//
// A `Style` already carries everything a cell needs (TUI_style.m31); what was
// missing is a way to put more than one of them on the same row without a
// caller hand-rolling the column arithmetic. `Span` and `Line` are that:
// ratatui's `Span`/`Line` *concept*, through this library's own idiom rather
// than its API -- `Line` is a `List<Span>` with a `render` method, so it is a
// `Widget` exactly like `Block` and `Paragraph`, composes with `TUI_geometry` the
// same way, and needs no separate "text buffer" type of its own.

/// A run of text in one style -- the smallest styled unit a `Line` is built
/// from. `"a" + Span("b") ` is not a thing; build a `Line` of both instead.
pub type Span {
    pub str text;
    pub TUI_style.Style style = TUI_style.Style();
}

/// A plain, unstyled span. `Span.of("x")` and `Span("x")` mean the same
/// thing; this spelling reads better in a list literal of otherwise-styled
/// spans: `[Span.of("["), Span("staged", style: accent), Span.of("]")]`.
pub static Span Span.of(str text) {
    return Span(text);
}

/// How many columns this span takes, by `TUI_text.width`.
pub int Span.width() {
    return TUI_text.width(text);
}

/// A row of spans, drawn left to right: `apps/tui`'s answer to ratatui's
/// `Line`. Like any other widget it does not know where it is drawn; unlike
/// `Paragraph` it never wraps -- a `Line` is one row, by construction, and a
/// caller that wants more builds more of them.
///
/// ```
/// TUI_widget.Line([TUI_widget.Span("staged: ", style: dim),
///     TUI_widget.Span("3 files", style: accent)])
/// ```
pub type Line {
    pub List<Span> spans;
    pub TUI_text.Align align = TUI_text.Align.Left;
    /// Fills the rectangle first, so a span that does not reach the edge
    /// still sits on a deliberate background rather than whatever was
    /// already in the buffer -- the same reason `Paragraph.style` exists.
    pub TUI_style.Style style = TUI_style.Style();
}

/// A `Line` of one span in one style -- the common case, and what a caller
/// reaches for before building a `List<Span>` by hand.
pub static Line Line.of(str text, TUI_style.Style style = TUI_style.Style()) {
    return Line([Span(text, style: style)], style: style);
}

/// The line's total width: the sum of its spans', by `TUI_text.width`.
pub int Line.width() {
    int total = 0;
    for (Span span in spans) {
        total = total + span.width();
    }
    return total;
}

/// The spans' text, concatenated with no separator -- what the line reads as
/// with every style stripped off.
pub str Line.plain() {
    List<str> out = [];
    for (Span span in spans) {
        out.push(span.text);
    }
    return out.join("");
}

pub void Line.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    int total = width();
    int start = area.x;
    if (total < area.width) {
        match (align) {
            case Left: {
            }
            case Right: {
                start = area.x + area.width - total;
            }
            case Center: {
                start = area.x + (area.width - total) / 2;
            }
        }
    }
    int x = start;
    int budget = area.right() - start;
    for (Span span in spans) {
        if (budget <= 0) {
            return;
        }
        int used = buffer.set_str(x, area.y, span.text, span.style, max: budget);
        x = x + used;
        budget = budget - used;
    }
}
