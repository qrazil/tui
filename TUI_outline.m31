// A collapsible outline: nested sections that expand and collapse in place --
// the primary-view primitive `apps/git/design.md` builds the whole
// interactive client around, generalised past that one client. A log, a
// status listing, a diff summary: anything that is "sections, and sections
// inside them, some of which you want folded away" is this widget.
//
// API
// ---
//   TUI_outline.Node.leaf(id, label)              a row with no children
//   TUI_outline.Node.section(id, label, children)  a row that can fold
//   TUI_outline.Outline(roots)                     the widget itself
//   outline.rows()             -> List<Row>       the FLATTENED, visible rows
//   outline.count()            -> int             how many of them, without building them
//   outline.current()          -> Option<Row>     the row under the cursor
//   outline.move(delta)                           step the cursor
//   outline.toggle() / .expand() / .collapse()    fold the row under the cursor
//   outline.did_select_id(id)  -> bool            move the cursor to a row by id
//   outline.scroll_h(delta)                       pan every row sideways
//   outline.handle_mouse(gesture, area)           press selects, double click folds, wheel moves
//   outline.render(buf, area)
//
// --- what "visible" means ----------------------------------------------------
//
// A node's children are rows only when every ancestor down to it is
// expanded. Collapsing a section removes its whole subtree from the
// flattened list in one step, which is what makes folding a thousand-line
// diff one keystroke rather than one per line.
//
// `rows()` is recomputed on demand rather than cached -- `roots` and every
// `Node.is_expanded` are public fields a caller may change directly, so there
// is nothing a cache could be keyed on -- but the widget's OWN operations
// do not go through it: a 200-commit log with its files unfolded is five
// thousand rows, a keystroke on it is a move, a `current()` and a redraw,
// and materialising five thousand `Row`s three times per keystroke was the
// whole cost of scrolling it. `move` counts, `current`/`toggle`/
// `did_select_id` walk to one row, and `render` walks to the first row on screen
// and stops after the last -- the same tree walk `rows()` makes, allocating
// only what each caller actually reads.
//
// --- why every node has an id ------------------------------------------------
//
// A jump list (`TUI_jump_list`) and a "put the cursor back where it was" both need
// to name a row that SURVIVES a fold changing every row number below it --
// position is not a stable address, and `id` is the caller's own one: a
// commit hash, a file path, a hunk index, blank for a row nothing else needs
// to address by name.

import TUI_buffer;
import TUI_geometry;
import TUI_mouse;
import TUI_scroll;
import TUI_style;
import TUI_text;

/// One entry in the outline, and the subtree rooted at it.
pub type Node {
    /// The caller's own key for this row. See the header on why it exists.
    pub str id;
    pub str label;
    pub List<Node> children;
    pub TUI_style.Style style = TUI_style.Style();
    pub bool is_expanded = true;
}

/// A row with no children: nothing to fold, so `toggle` on it does nothing.
pub static Node Node.leaf(str id, str label) {
    return Node(id, label, []);
}

/// A row that can fold, expanded by default.
pub static Node Node.section(str id, str label, List<Node> children, bool is_expanded = true) {
    return Node(id, label, children, is_expanded: is_expanded);
}

pub bool Node.has_children() {
    return children.size() > 0;
}

/// One row of the flattened, currently visible outline: the node it came
/// from, and how deep it is -- what `render` indents by and what a caller
/// asking "what is the cursor on" reads `node` off of.
pub type Row {
    pub Node node;
    pub int depth;
}

/// The widget: a forest of `Node`s, a cursor into the flattened visible
/// rows, and the scroll that follows it.
///
/// ```
/// TUI_outline.Outline([TUI_outline.Node.section("wip", "Unstaged changes",
///     [TUI_outline.Node.leaf("a.txt", "modified: a.txt")])])
/// ```
pub type Outline {
    pub List<Node> roots;
    /// An index into `rows()`, not into `roots` -- see the header.
    pub int cursor = 0;
    pub TUI_scroll.Viewport view = TUI_scroll.Viewport();
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    /// Columns of indent per level of nesting.
    pub int indent = 2;
    pub str expanded_mark = "\u{25BE} ";
    pub str collapsed_mark = "\u{25B8} ";
    pub str leaf_mark = "  ";
    /// Columns scrolled off the left of every row, uniformly -- content
    /// wider than the terminal (a long commit message, an author's email, a
    /// deep file path) is reachable by scrolling sideways rather than lost
    /// to truncation with no way back. Applies to a whole row, mark
    /// included, not just its label -- a fold marker that vanished while
    /// scrolled would be worse than one that scrolls with everything else.
    pub int hscroll = 0;
}

/// Scroll every row left or right by `delta` columns (negative scrolls
/// left), clamped so it never goes negative -- there is nothing to reveal
/// scrolling further left than the unscrolled view.
pub void Outline.scroll_h(int delta) {
    hscroll = hscroll + delta;
    if (hscroll < 0) {
        hscroll = 0;
    }
}

/// The flattened list of rows the tree currently shows, in order, skipping
/// the children of anything collapsed.
pub List<Row> Outline.rows() {
    List<Row> out = [];
    for (Node node in roots) {
        collect(out, node, 0);
    }
    return out;
}

void Outline.collect(List<Row> out, Node node, int depth) {
    out.push(Row(node, depth));
    if (node.is_expanded) {
        for (Node child in node.children) {
            collect(out, child, depth + 1);
        }
    }
}

/// How many rows `rows()` would answer, without building them.
pub int Outline.count() {
    int row_count = 0;
    for (Node root in roots) {
        row_count = row_count + visible(root);
    }
    return row_count;
}

/// Rows `from` up to `from + want` of the flattened, visible list -- what
/// `render` draws, and nothing past the bottom of the screen.
List<Row> Outline.window(int from, int want) {
    Walk walk = Walk(from, want, []);
    for (Node root in roots) {
        if (walk.did_finish(root, 0)) {
            return walk.out;
        }
    }
    return walk.out;
}

/// The row at index `index` of the flattened, visible list, or `None`.
Option<Row> Outline.row_at(int index) {
    if (index < 0) {
        return Option<Row>.None;
    }
    List<Row> one = window(index, 1);
    if (one.size() == 0) {
        return Option<Row>.None;
    }
    return Option<Row>.Some(one[0]);
}

/// The row the cursor is on, or `None` when the outline has none.
pub Option<Row> Outline.current() {
    return row_at(cursor);
}

/// Move the cursor by `delta` rows of the flattened, visible list, stopping
/// at the ends -- `TUI_list_table.ListView.step`'s own rule.
pub void Outline.move(int delta) {
    int row_count = count();
    if (row_count == 0) {
        cursor = 0;
        return;
    }
    int target = cursor + delta;
    if (target < 0) {
        target = 0;
    }
    if (target >= row_count) {
        target = row_count - 1;
    }
    cursor = target;
}

/// Fold or unfold the row under the cursor. A leaf does nothing -- there is
/// nothing under it to hide.
pub void Outline.toggle() {
    match (current()) {
        case Some(Row row): {
            if (row.node.has_children()) {
                row.node.is_expanded = !row.node.is_expanded;
            }
        }
        case None: {
        }
    }
}

/// Unfold the row under the cursor, if it has children.
pub void Outline.expand() {
    match (current()) {
        case Some(Row row): {
            row.node.is_expanded = true;
        }
        case None: {
        }
    }
}

/// Fold the row under the cursor, if it has children.
pub void Outline.collapse() {
    match (current()) {
        case Some(Row row): {
            row.node.is_expanded = false;
        }
        case None: {
        }
    }
}

/// Move the cursor to the visible row whose `id` is `id`. Answers whether one
/// was found -- a row hidden inside a folded section is not, which is
/// correct: there is nothing on screen yet to put the cursor on.
pub bool Outline.did_select_id(str id) {
    Seek seek = Seek(id);
    for (Node root in roots) {
        if (seek.did_find(root)) {
            cursor = seek.index;
            return true;
        }
    }
    return false;
}

/// A mouse gesture over the outline, drawn in `area` (the rectangle the last
/// `render` was given): a Press moves the cursor to the row under it, and
/// folds that row when it is on its fold mark; a double click folds the row;
/// the wheel moves the cursor by `WHEEL_ROWS`. Answers `Changed` when the
/// cursor or a fold moved, `Activated` when a fold changed, else `Ignored`.
pub TUI_mouse.Response Outline.handle_mouse(TUI_mouse.Gesture gesture, TUI_geometry.Rect area) {
    match (gesture.kind) {
        case Press: {
            int index = view.offset + gesture.y - area.y;
            if (area.is_empty() || !area.has_point(gesture.x, gesture.y) || index >= count()) {
                return TUI_mouse.Response.Ignored;
            }
            cursor = index;
            match (current()) {
                case Some(Row row): {
                    int mark_x = area.x + row.depth * indent;
                    if (row.node.has_children() && gesture.x >= mark_x && gesture.x < mark_x + 2 && gesture.clicks <= 1) {
                        toggle();
                        return TUI_mouse.Response.Activated;
                    }
                }
                case None: {
                }
            }
            return TUI_mouse.Response.Changed;
        }
        case Click: {
            if (gesture.clicks >= 2) {
                match (current()) {
                    case Some(Row row): {
                        if (row.node.has_children()) {
                            toggle();
                            return TUI_mouse.Response.Activated;
                        }
                    }
                    case None: {
                    }
                }
            }
            return TUI_mouse.Response.Ignored;
        }
        case ScrollUp: {
            return step_by(0 - WHEEL_ROWS);
        }
        case ScrollDown: {
            return step_by(WHEEL_ROWS);
        }
        case Drag: {
            return TUI_mouse.Response.Ignored;
        }
        case Release: {
            return TUI_mouse.Response.Ignored;
        }
        case Hover: {
            return TUI_mouse.Response.Ignored;
        }
        case Leave: {
            return TUI_mouse.Response.Ignored;
        }
        case ScrollLeft: {
            scroll_h(0 - 4);
            return TUI_mouse.Response.Changed;
        }
        case ScrollRight: {
            scroll_h(4);
            return TUI_mouse.Response.Changed;
        }
    }
}

TUI_mouse.Response Outline.step_by(int delta) {
    int before = cursor;
    move(delta);
    if (cursor == before) {
        return TUI_mouse.Response.Ignored;
    }
    return TUI_mouse.Response.Changed;
}

pub void Outline.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    int total = count();
    if (cursor >= total) {
        cursor = total - 1;
    }
    if (cursor < 0) {
        cursor = 0;
    }
    view.reveal(cursor, total, area.height);
    view.offset = view.clamped(total, area.height);
    int off = view.offset;
    List<Row> visible_rows = window(off, area.height);
    int screen_row = 0;
    while (screen_row < area.height) {
        if (screen_row >= visible_rows.size()) {
            return;
        }
        int row_index = off + screen_row;
        Row row = visible_rows[screen_row];
        int y = area.y + screen_row;
        TUI_style.Style row_style = style.merged(row.node.style);
        if (row_index == cursor) {
            row_style = row_style.merged(highlight_style);
            buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", row_style);
        }
        str mark = leaf_mark;
        if (row.node.has_children()) {
            if (row.node.is_expanded) {
                mark = expanded_mark;
            } else {
                mark = collapsed_mark;
            }
        }
        int x = area.x + row.depth * indent;
        int room = area.right() - x;
        if (room > 0) {
            str content = TUI_text.drop_columns(mark + row.node.label, hscroll);
            buffer.set_str(x, y, content, row_style, max: room);
        }
        screen_row = screen_row + 1;
    }
}

/// How many rows a wheel notch moves the cursor.
pub const int WHEEL_ROWS = 3;

int visible(Node node) {
    int row_count = 1;
    if (node.is_expanded) {
        for (Node child in node.children) {
            row_count = row_count + visible(child);
        }
    }
    return row_count;
}

/// A walk that stops at one row, or collects a window of them: `skip` rows
/// are passed over, then `want` are collected into `out` (a negative `want`
/// means "no limit", which is what `rows()` is). Shared by every operation
/// below that used to flatten the whole tree to read one row of it.
type Walk {
    int skip;
    int want;
    List<Row> out;
}

/// Answers whether the walk is finished, so a caller stops descending.
bool Walk.did_finish(Node node, int depth) {
    if (skip > 0) {
        skip = skip - 1;
    } else {
        out.push(Row(node, depth));
        if (want >= 0 && out.size() >= want) {
            return true;
        }
    }
    if (node.is_expanded) {
        for (Node child in node.children) {
            if (did_finish(child, depth + 1)) {
                return true;
            }
        }
    }
    return false;
}

/// The id-matching walk `did_select_id` makes: counts visible rows until one's
/// `id` is `id`, allocating nothing on the way.
type Seek {
    str id;
    int index = 0;
}

bool Seek.did_find(Node node) {
    if (node.id == id) {
        return true;
    }
    index = index + 1;
    if (node.is_expanded) {
        for (Node child in node.children) {
            if (did_find(child)) {
                return true;
            }
        }
    }
    return false;
}
