// The cross-library benchmark: the scenarios bench/ratatui/src/main.rs runs, line for line, so the two
// can be compared. A frame's cost as an application pays it (clear, lay the frame into a buffer, diff it
// against the last one, serialise to bytes), not what a terminal does with the bytes.
//
//   bench <scenario>  runs one scenario only (what a profile wants)
//   bash bench/run.sh              builds both, runs both alternately, writes bench/results/*.txt
//
// Output, one line per scenario: `RESULT <name> <median_us> <p95_us> <min_us> <bytes>`. A sample is the mean of
// `reps` frames (reps chosen so a sample lasts ~10 ms); 5 samples are thrown away and 40 are kept, so the
// median and p95 are over 40 samples. `bytes` is the mean output of one frame over the last sample.

import date;
import os;
import core.TUI_buffer;
import app.TUI_diff;
import core.TUI_style;
import core.TUI_geometry;
import core.TUI_widget;

const int W = 200;
const int H = 50;
const int WARMUP = 5;
const int SAMPLES = 40;
const int TARGET_NS = 10000000;

str pad(int value, int width) {
    str text = str(value);
    while (text.size() < width) {
        text = "0" + text;
    }
    return text;
}

str seg_text(int row, int first_column, int count) {
    bytes letters = [];
    for (int offset in 0 .. count) {
        int column = first_column + offset;
        if (column % 8 == 7) {
            letters.push(' ');
        } else {
            letters.push('a' + (column * 7 + row * 13) % 26);
        }
    }
    match (letters.utf8()) {
        case Some(str text): {
            return text;
        }
        case None: {
            return "";
        }
    }
}

void paint_grid(TUI_buffer.Buffer buffer, int width, int height) {
    for (int y in 0 .. height) {
        for (int seg in 0 .. width / 25) {
            buffer.set_str(seg * 25, y, seg_text(y, seg * 25, 25), TUI_style.Style(foreground: TUI_style.Colour.Indexed(1 + seg % 8)));
        }
    }
}

str name_of(int kind, int number) {
    str id = pad(number, 4);
    if (kind == 0) {
        return "src/ui/widget_" + id + ".rs";
    }
    return "\u{6587}\u{6863}/\u{65E5}\u{672C}\u{8A9E}_" + id + ".txt";
}

List<str> matches_of(int kind, str query) {
    List<str> names = [];
    for (int number in 0 .. 4000) {
        if (names.size() >= 40) {
            break;
        }
        if (pad(number, 4).contains(query)) {
            names.push(name_of(kind, number));
        }
    }
    return names;
}

void paint_finder(TUI_buffer.Buffer buffer, List<str> names, str query) {
    TUI_style.Style faint = TUI_style.Style(foreground: TUI_style.Colour.Indexed(8));
    TUI_style.Style plain = TUI_style.Style();
    TUI_style.Style sel = TUI_style.Style(foreground: TUI_style.Colour.Indexed(15), background: TUI_style.Colour.Indexed(4));
    TUI_widget.Block(borders: TUI_widget.Borders.Rounded, style: faint).render(buffer, TUI_geometry.Rect(0, 0, W, 44));
    buffer.set_str(2, 1, "> " + query, plain);
    buffer.fill(TUI_geometry.Rect(0, 2, W, 1), "\u{2500}", faint);
    buffer.set_str(0, 2, "\u{251C}", faint);
    buffer.set_str(W - 1, 2, "\u{2524}", faint);
    int row = 0;
    for (str name in names) {
        int y = 3 + row;
        if (row == 0) {
            buffer.fill(TUI_geometry.Rect(1, y, W - 2, 1), " ", sel);
            buffer.set_str(1, y, "> " + name, sel);
        } else {
            buffer.set_str(1, y, "  " + name, plain);
        }
        row = row + 1;
    }
}

str scroll_line(int number) {
    return " the quick brown fox jumps over the lazy dog, " + str(number * 7919 % 100003) + " and then some more text to fill";
}

void paint_scroll(TUI_buffer.Buffer buffer, int top) {
    TUI_style.Style number_style = TUI_style.Style(foreground: TUI_style.Colour.Indexed(3));
    TUI_style.Style plain = TUI_style.Style();
    for (int y in 0 .. H) {
        int number = top + y;
        buffer.set_str(0, y, pad(number, 5), number_style);
        buffer.set_str(5, y, scroll_line(number), plain);
    }
}

/// Rows of CJK, emoji and ASCII; row 10 carries `tick` (so one row can change).
void paint_wide(TUI_buffer.Buffer buffer, int tick) {
    TUI_style.Style a = TUI_style.Style(foreground: TUI_style.Colour.Indexed(2));
    TUI_style.Style b = TUI_style.Style(foreground: TUI_style.Colour.Indexed(5));
    for (int y in 0 .. H) {
        buffer.set_str(0, y, pad(y, 2) + " \u{65E5}\u{672C}\u{8A9E}\u{306E}\u{30C6}\u{30AD}\u{30B9}\u{30C8} \u{4E2D}\u{6587}\u{6587}\u{5B57}", a);
        buffer.set_str(30, y, "\u{1F680} launch \u{1F525} fire \u{2728} sparkle \u{1F468}\u{200D}\u{1F469}\u{200D}\u{1F467} family \u{2764}\u{FE0F} love", b);
        buffer.set_str(100, y, "\u{D55C}\u{AD6D}\u{C5B4} \u{D14C}\u{C2A4}\u{D2B8} \u{1F600}\u{1F601}\u{1F602}\u{1F923} ascii tail", a);
    }
    buffer.set_str(0, 10, pad(tick % 100, 2), b);
}

type Scene {
    pub TUI_style.Depth depth = TUI_style.Depth.Ansi256;
    pub List<int> resize_w = [80, 120, 200, 132, 250, 100, 160, 90];
    pub List<int> resize_h = [24, 40, 50, 43, 70, 30, 50, 24];
    pub int id = 0;
    pub TUI_buffer.Buffer shown = TUI_buffer.Buffer.sized(W, H);
    pub TUI_buffer.Buffer next = TUI_buffer.Buffer.sized(W, H);
    pub int counter = 0;
    pub List<List<str>> lists = [];
    pub List<str> queries = ["", "1", "12", "123", "1230", "123", "12", "1"];
    pub List<TUI_buffer.Buffer> sized_buffers = [];
}


/// One frame of scenario `id`; answers the bytes written.
int Scene.step() {
    counter = counter + 1;
    if (id == 0) {
        next.clear();
        paint_grid(next, W, H);
        return TUI_diff.full(next, depth).size();
    }
    if (id == 1 || id == 2) {
        next.clear();
        paint_grid(next, W, H);
        if (id == 1 && counter % 2 == 0) {
            next.set_str(100, 25, "#", TUI_style.Style(foreground: TUI_style.Colour.Indexed(9)));
        }
        int n = TUI_diff.diff(shown, next, depth).size();
        TUI_buffer.Buffer swap = shown;
        shown = next;
        next = swap;
        return n;
    }
    if (id == 3) {
        int k = counter % 8;
        next.clear();
        paint_finder(next, lists[k], queries[k]);
        int n = TUI_diff.diff(shown, next, depth).size();
        TUI_buffer.Buffer swap = shown;
        shown = next;
        next = swap;
        return n;
    }
    if (id == 4 || id == 5 || id == 6) {
        int top = counter % 9900;
        next.clear();
        paint_scroll(next, top);
        int n = 0;
        if (id == 4) {
            n = TUI_diff.diff(shown, next, depth).size();
        } else if (id == 5) {
            n = TUI_diff.diff_scrolled_in_place(shown, next, depth).size();
        }
        TUI_buffer.Buffer swap = shown;
        shown = next;
        next = swap;
        return n;
    }
    if (id == 7) {
        next.clear();
        paint_wide(next, counter);
        return TUI_diff.full(next, depth).size();
    }
    if (id == 8) {
        next.clear();
        paint_wide(next, counter);
        int n = TUI_diff.diff(shown, next, depth).size();
        TUI_buffer.Buffer swap = shown;
        shown = next;
        next = swap;
        return n;
    }
    if (id == 9) {
        int k = counter % 8;
        TUI_buffer.Buffer fresh = TUI_buffer.Buffer.sized(resize_w[k], resize_h[k]);
        paint_grid(fresh, resize_w[k], resize_h[k]);
        return TUI_diff.full(fresh, depth).size();
    }
    if (id == 12 || id == 13) {
        next.clear();
        paint_grid(next, W, H);
        next.link(TUI_geometry.Rect(10, 25, 20, 1), "https://example.com/some/long/path/to/a/page?query=1");
        if (id == 12 && counter % 2 == 0) {
            next.set_str(100, 25, "#", TUI_style.Style(foreground: TUI_style.Colour.Indexed(9)));
        }
        int n = 0;
        if (id == 12) {
            n = TUI_diff.diff(shown, next, depth).size();
        } else {
            n = TUI_diff.full(next, depth).size();
        }
        TUI_buffer.Buffer swap = shown;
        shown = next;
        next = swap;
        return n;
    }
    if (id == 10) {
        next.clear();
        paint_grid(next, W, H);
        return 0;
    }
    if (id == 11) {
        int k = counter % 8;
        next.clear();
        paint_finder(next, lists[k], queries[k]);
        return 0;
    }
    return 0;
}

void run(str pick, str name, int id, int kind) {
    if (pick != "" && pick != name) {
        return;
    }
    Scene scene = Scene();
    scene.id = id;
    for (int k in 0 .. 8) {
        scene.lists.push(matches_of(kind, scene.queries[k]));
    }
    // prime: the first frames fill `shown`
    for (int i in 0 .. 3) {
        scene.step();
    }
    int started = date.now_ns();
    scene.step();
    int one = date.now_ns() - started;
    int reps = TARGET_NS / (one + 1);
    if (reps < 1) {
        reps = 1;
    }
    List<int> times = [];
    int bytes_n = 0;
    for (int sample in 0 .. WARMUP + SAMPLES) {
        int total_bytes = 0;
        started = date.now_ns();
        for (int r in 0 .. reps) {
            total_bytes = total_bytes + scene.step();
        }
        int ns = (date.now_ns() - started) / reps;
        if (sample >= WARMUP) {
            times.push(ns);
        }
        bytes_n = total_bytes / reps;
    }
    // insertion sort
    for (int i in 1 .. times.size()) {
        int v = times[i];
        int j = i - 1;
        while (j >= 0 && times[j] > v) {
            times[j + 1] = times[j];
            j = j - 1;
        }
        times[j + 1] = v;
    }
    print("RESULT " + name + " " + str(times[times.size() / 2] / 1000) + "." + pad(times[times.size() / 2] % 1000 / 10, 2) + " " + str(times[times.size() * 95 / 100] / 1000) + "." + pad(times[times.size() * 95 / 100] % 1000 / 10, 2) + " " + str(times[0] / 1000) + "." + pad(times[0] % 1000 / 10, 2) + " " + str(bytes_n));
}

List<str> arguments = os.arguments();
str pick = "";
if (arguments.size() > 1) {
    pick = arguments[1];
}
run(pick, "full-200x50", 0, 0);
run(pick, "diff-1cell", 1, 0);
run(pick, "diff-0", 2, 0);
run(pick, "finder-ascii-key", 3, 0);
run(pick, "scroll10k-diff", 4, 0);
run(pick, "scroll10k-diff_scrolled", 5, 0);
run(pick, "wide-full", 7, 0);
run(pick, "wide-diff-1row", 8, 0);
run(pick, "resize-storm-full", 9, 0);
run(pick, "paint-grid", 10, 0);
run(pick, "paint-finder", 11, 0);
run(pick, "links-diff-1cell", 12, 0);
run(pick, "links-full", 13, 0);
