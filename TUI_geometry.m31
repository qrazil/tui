// Rectangles, and the constraint solver that cuts them up.
//
// API
// ---
//   TUI_geometry.Point(x, y)                     a cell: where a cursor is
//   TUI_geometry.Rect(x, y, width, height)      a rectangle in terminal cells
//   r.right(), r.bottom()           one past the last column / row
//   r.is_empty(), r.has_point(point_x, point_y), r.intersect(other)
//   r.inset(margin), r.inset_xy(margin_x, margin_y)  a margin taken off every side
//   TUI_geometry.Constraint              Length | Percentage | Ratio | Min | Max | Fill
//   TUI_geometry.rows(area, constraints) cut top to bottom
//   TUI_geometry.columns(area, constraints) cut left to right
//   TUI_geometry.Layout(direction, parts, ...) the same with margins and spacing
//   TUI_geometry.resolve(total, constraints)      the solver alone, on one dimension
//
// --- the resolution rules ---------------------------------------------------
//
// `resolve(total, constraints)` answers one size per constraint. **The sizes always
// sum to exactly `total`, and none is negative** -- that is the invariant the
// property test checks, and it is what makes the parts tile the whole with no
// overlap and no gap.
//
// Each constraint first states a **preferred** size, clamped into `0..total`:
//
//   | `Length(cells)`                | `cells`                           | rigid                |
//   | `Percentage(percent)`          | `total * percent / 100`           | rigid                |
//   | `Ratio(numerator, denominator)`| `total * numerator / denominator` | rigid                |
//   | `Min(cells)`                   | `cells`                           | may grow             |
//   | `Max(cells)`                   | `cells`                           | may shrink           |
//   | `Fill(weight)`                 | `0`                               | grows, by `weight`   |
//
// Division truncates, as it does everywhere in this language: `Percentage(33)`
// of 10 is 3, not 3.3 rounded.
//
// If the preferred sizes come to **less** than `total`, the surplus is shared
// out in this order, and the first rule that applies takes all of it:
//
//   1. the `Fill` constraints, in proportion to their weights -- or equally
//      if every one of them has weight zero, since a layout whose fills are
//      all `Fill(0)` still means "the rest goes here";
//   2. otherwise the `Min` constraints, equally;
//   3. otherwise the **last** constraint.
//
// Rule 3 is what keeps the promise that the parts tile the whole. A layout
// of nothing but `Length`s that does not add up has to put the difference
// somewhere, and the end is the least surprising place. It is also the one
// place a constraint is overrun rather than underrun: `[Max(30), Max(30)]`
// in 100 cells gives 30 and 70, because there is no honest home for the
// other 40. A program that cares says where with a `Fill`.
//
// If the preferred sizes come to **more** than `total`, the deficit is taken
// back in five rounds, each stopping as soon as the books balance:
//
//   1. `Fill`, down to 0;
//   2. `Max`, down to 0;
//   3. `Percentage` and `Ratio`, down to 0;
//   4. `Min`, down to 0;
//   5. `Length`, down to 0.
//
// So the flexible ones give way first and `Length` is the last promise
// broken. **Within a round the loss is shared in proportion to what each
// segment has to give**, so two equal columns lose equally rather than the
// rightmost losing everything.
//
// Both the sharing and the taking use the largest-remainder method: whole
// cells, summing exactly, and where two segments have an equal claim on the
// last cell the earlier one gets it. Nothing here is floating point -- a
// terminal has no half columns, and a rule that rounds twice tiles wrongly.

/// A cell of the screen: a column and a row, 0-based, in the same absolute
/// coordinates a `Rect` uses. What a widget answers when asked where its
/// cursor is.
pub type Point {
    pub int x;
    pub int y;
}

/// A rectangle of terminal cells: `width` columns and `height` rows, with its
/// top-left corner at `x`, `y`. Coordinates are absolute in the buffer, so a
/// widget handed a sub-rectangle writes at the coordinates it was given.
///
/// A negative `width` or `height` is meaningless; every function here treats one as
/// zero rather than trapping, so a layout that runs out of room degrades
/// into empty rectangles instead of stopping the program.
pub type Rect {
    pub int x;
    pub int y;
    pub int width;
    pub int height;
}

/// The column one past the last: `x + width`.
pub int Rect.right() {
    return x + width;
}

/// The row one past the last: `y + height`.
pub int Rect.bottom() {
    return y + height;
}

/// No cells at all.
pub bool Rect.is_empty() {
    return width <= 0 || height <= 0;
}

/// How many cells the rectangle holds.
pub int Rect.cells() {
    if (is_empty()) {
        return 0;
    }
    return width * height;
}

/// Is the cell at `point_x`, `point_y` inside?
pub bool Rect.has_point(int point_x, int point_y) {
    return point_x >= x && point_x < right() && point_y >= y && point_y < bottom();
}

/// The rectangle both cover, which is empty when they do not overlap.
pub Rect Rect.intersect(Rect other) {
    int new_left = x;
    if (other.x > new_left) {
        new_left = other.x;
    }
    int new_top = y;
    if (other.y > new_top) {
        new_top = other.y;
    }
    int new_right = right();
    if (other.right() < new_right) {
        new_right = other.right();
    }
    int new_bottom = bottom();
    if (other.bottom() < new_bottom) {
        new_bottom = other.bottom();
    }
    if (new_right < new_left) {
        new_right = new_left;
    }
    if (new_bottom < new_top) {
        new_bottom = new_top;
    }
    return Rect(new_left, new_top, new_right - new_left, new_bottom - new_top);
}

/// The same rectangle with `margin` cells taken off every side. A margin bigger
/// than the rectangle leaves it empty, in the middle of where it was.
pub Rect Rect.inset(int margin) {
    return inset_xy(margin, margin);
}

/// A margin off the left and right, and off the top and bottom.
pub Rect Rect.inset_xy(int margin_x, int margin_y) {
    int inset_x = margin_x;
    if (inset_x < 0) {
        inset_x = 0;
    }
    if (inset_x > width / 2) {
        inset_x = width / 2;
    }
    int inset_y = margin_y;
    if (inset_y < 0) {
        inset_y = 0;
    }
    if (inset_y > height / 2) {
        inset_y = height / 2;
    }
    int new_width = width - 2 * inset_x;
    int new_height = height - 2 * inset_y;
    if (new_width < 0) {
        new_width = 0;
    }
    if (new_height < 0) {
        new_height = 0;
    }
    return Rect(x + inset_x, y + inset_y, new_width, new_height);
}

pub bool Rect.eq(Rect other) {
    return x == other.x && y == other.y && width == other.width && height == other.height;
}

pub str Rect.to_str() {
    return str(x) + "," + str(y) + " " + str(width) + "x" + str(height);
}

/// Which way a layout cuts.
pub enum Direction {
    Horizontal;
    Vertical;
}

/// How much of a dimension one part asks for. See the rules at the top of
/// this file for what happens when the asks do not add up.
pub enum Constraint {
    /// Exactly this many cells.
    Length(int);
    /// This percentage of the whole, truncated.
    Percentage(int);
    /// This fraction of the whole: `Ratio(1, 3)` is a third, truncated.
    Ratio(int, int);
    /// At least this many, and more if there is room going spare.
    Min(int);
    /// At most this many, and fewer if there is not enough room.
    Max(int);
    /// Whatever is left, shared with the other `Fill`s in proportion to the
    /// weights. `Fill(0)` asks for nothing.
    Fill(int);
}

pub str Constraint.to_str() {
    match (this) {
        case Length(int cells): {
            return "Length(" + str(cells) + ")";
        }
        case Percentage(int percent): {
            return "Percentage(" + str(percent) + ")";
        }
        case Ratio(int numerator, int denominator): {
            return "Ratio(" + str(numerator) + "," + str(denominator) + ")";
        }
        case Min(int cells): {
            return "Min(" + str(cells) + ")";
        }
        case Max(int cells): {
            return "Max(" + str(cells) + ")";
        }
        case Fill(int weight): {
            return "Fill(" + str(weight) + ")";
        }
    }
}

int Constraint.kind() {
    match (this) {
        case Length: {
            return C_LENGTH;
        }
        case Percentage: {
            return C_PERCENT;
        }
        case Ratio: {
            return C_RATIO;
        }
        case Min: {
            return C_MIN;
        }
        case Max: {
            return C_MAX;
        }
        case Fill: {
            return C_FILL;
        }
    }
}

/// The weight of a `Fill`, and zero for anything else.
int Constraint.weight() {
    match (this) {
        case Length: {
            return 0;
        }
        case Percentage: {
            return 0;
        }
        case Ratio: {
            return 0;
        }
        case Min: {
            return 0;
        }
        case Max: {
            return 0;
        }
        case Fill(int weight): {
            if (weight < 0) {
                return 0;
            }
            if (weight > 1_000_000) {
                return 1_000_000;
            }
            return weight;
        }
    }
}

/// The size this constraint would like, out of `total`, clamped to it.
int Constraint.preferred(int total) {
    match (this) {
        case Length(int cells): {
            return clamp(cells, total);
        }
        case Percentage(int percent): {
            return clamp(scaled(total, percent, 100), total);
        }
        case Ratio(int numerator, int denominator): {
            if (denominator <= 0) {
                return 0;
            }
            return clamp(scaled(total, numerator, denominator), total);
        }
        case Min(int cells): {
            return clamp(cells, total);
        }
        case Max(int cells): {
            return clamp(cells, total);
        }
        case Fill: {
            return 0;
        }
    }
}

const int C_FILL = 0;
const int C_MAX = 1;
const int C_PERCENT = 2;
const int C_RATIO = 3;
const int C_MIN = 4;
const int C_LENGTH = 5;

int clamp(int value, int limit) {
    if (value < 0) {
        return 0;
    }
    if (value > limit) {
        return limit;
    }
    return value;
}

/// `total * a / b`, without overflowing on a large total.
int scaled(int total, int numerator, int denominator) {
    if (numerator <= 0 || denominator <= 0) {
        return 0;
    }
    if (numerator > denominator) {
        return total;
    }
    return total / denominator * numerator + total % denominator * numerator / denominator;
}

/// One size per constraint, summing to exactly `total`. See the rules at the
/// top of this file.
pub List<int> resolve(int total, List<Constraint> constraints) {
    List<int> size = [];
    int count = constraints.size();
    if (count == 0) {
        return size;
    }
    int room = total;
    if (room < 0) {
        room = 0;
    }
    int sum = 0;
    for (int i in 0 .. count) {
        int preferred_size = constraints[i].preferred(room);
        size.push(preferred_size);
        sum = sum + preferred_size;
    }
    if (sum < room) {
        grow(size, constraints, room - sum);
    }
    if (sum > room) {
        shrink(size, constraints, sum - room);
    }
    return size;
}

/// Hand out `extra` cells: to the weighted `Fill`s, else to the `Min`s, else
/// to the last constraint.
void grow(List<int> size, List<Constraint> constraints, int extra) {
    int count = constraints.size();
    List<int> target_indexes = [];
    List<int> target_weights = [];
    int weighed = 0;
    int index = 0;
    while (index < count) {
        if (constraints[index].kind() == C_FILL) {
            int weight = constraints[index].weight();
            target_indexes.push(index);
            target_weights.push(weight);
            weighed = weighed + weight;
        }
        index = index + 1;
    }
    // `Fill(0)` asks for no share of a contested surplus, but a layout whose
    // fills are ALL zero still means "the rest goes here", so they share it
    // equally rather than nobody taking it.
    if (target_indexes.size() > 0 && weighed == 0) {
        index = 0;
        while (index < target_weights.size()) {
            target_weights[index] = 1;
            index = index + 1;
        }
    }
    if (target_indexes.size() == 0) {
        index = 0;
        while (index < count) {
            if (constraints[index].kind() == C_MIN) {
                target_indexes.push(index);
                target_weights.push(1);
            }
            index = index + 1;
        }
    }
    if (target_indexes.size() == 0) {
        size[count - 1] = size[count - 1] + extra;
        return;
    }
    List<int> share = apportion(extra, target_weights);
    index = 0;
    while (index < target_indexes.size()) {
        size[target_indexes[index]] = size[target_indexes[index]] + share[index];
        index = index + 1;
    }
}

/// Take `deficit` cells back, in the five rounds the header describes.
void shrink(List<int> size, List<Constraint> constraints, int deficit) {
    int left = deficit;
    left = take(size, constraints, left, C_FILL);
    left = take(size, constraints, left, C_MAX);
    left = take(size, constraints, left, C_PERCENT);
    left = take(size, constraints, left, C_RATIO);
    left = take(size, constraints, left, C_MIN);
    left = take(size, constraints, left, C_LENGTH);
}

/// Take up to `need` cells from the segments of one kind, in proportion to
/// what each has to give. Answers what is still owed.
int take(List<int> size, List<Constraint> constraints, int need, int kind) {
    if (need <= 0) {
        return 0;
    }
    List<int> kind_indexes = [];
    List<int> cap = [];
    int pool = 0;
    int index = 0;
    while (index < constraints.size()) {
        if (constraints[index].kind() == kind && size[index] > 0) {
            kind_indexes.push(index);
            cap.push(size[index]);
            pool = pool + size[index];
        }
        index = index + 1;
    }
    if (kind_indexes.size() == 0) {
        return need;
    }
    if (pool <= need) {
        index = 0;
        while (index < kind_indexes.size()) {
            size[kind_indexes[index]] = 0;
            index = index + 1;
        }
        return need - pool;
    }
    List<int> share = apportion(need, cap);
    index = 0;
    while (index < kind_indexes.size()) {
        size[kind_indexes[index]] = size[kind_indexes[index]] - share[index];
        index = index + 1;
    }
    return 0;
}

/// Split `amount` in proportion to `weights`, in whole cells, summing to exactly
/// `amount`. Largest remainder; a tie goes to the earlier entry.
///
/// `amount` must not exceed the sum of `weights` when the weights are capacities,
/// which is how `take` uses it; no share then exceeds its weight.
pub List<int> apportion(int amount, List<int> weights) {
    List<int> out = [];
    int count = weights.size();
    if (count == 0) {
        return out;
    }
    int w_all = 0;
    for (int weight in weights) {
        w_all = w_all + weight;
    }
    if (w_all <= 0 || amount <= 0) {
        int index = 0;
        while (index < count) {
            out.push(0);
            index = index + 1;
        }
        return out;
    }
    List<int> rem = [];
    int given = 0;
    int index = 0;
    while (index < count) {
        int exact = amount * weights[index];
        int base = exact / w_all;
        out.push(base);
        rem.push(exact - base * w_all);
        given = given + base;
        index = index + 1;
    }
    int leftover = amount - given;
    while (leftover > 0) {
        int best = -1;
        int bestrem = 0;
        index = 0;
        while (index < count) {
            if (rem[index] > bestrem) {
                bestrem = rem[index];
                best = index;
            }
            index = index + 1;
        }
        if (best < 0) {
            best = 0;
        }
        out[best] = out[best] + 1;
        rem[best] = 0;
        leftover = leftover - 1;
    }
    return out;
}

/// A cut of a rectangle: which way, into what, with what margins and what
/// gap between the parts.
///
/// `direction` and `parts` are mandatory and positional; the rest are named:
///
/// ```
/// TUI_geometry.Layout(TUI_geometry.Direction.Vertical, [TUI_geometry.Constraint.Length(3),
///     TUI_geometry.Constraint.Fill(1)], margin_y: 1)
/// ```
pub type Layout {
    pub Direction direction;
    pub List<Constraint> parts;
    /// Cells taken off the left and the right before cutting.
    pub int margin_x = 0;
    /// Cells taken off the top and the bottom before cutting.
    pub int margin_y = 0;
    /// Cells left empty between one part and the next.
    pub int spacing = 0;
}

/// The parts, in order, one per constraint. With `spacing` at zero they tile
/// `area` exactly; with a gap they tile what is left of it. A part is never
/// outside `area`, however large the margins or the gap.
pub List<Rect> Layout.split(Rect area) {
    Rect box = area.inset_xy(margin_x, margin_y);
    List<Rect> out = [];
    int part_count = parts.size();
    if (part_count == 0) {
        return out;
    }
    int gap = spacing;
    if (gap < 0) {
        gap = 0;
    }
    int along = box.width;
    match (direction) {
        case Horizontal: {
        }
        case Vertical: {
            along = box.height;
        }
    }
    int gaps = gap * (part_count - 1);
    int room = along - gaps;
    if (room < 0) {
        room = 0;
    }
    List<int> sizes = resolve(room, parts);
    int position = box.x;
    int edge = box.right();
    match (direction) {
        case Horizontal: {
        }
        case Vertical: {
            position = box.y;
            edge = box.bottom();
        }
    }
    for (int i in 0 .. part_count) {
        // A gap wide enough to push a part past the end of the area puts it
        // at the end instead, empty: every part is inside `area`, always.
        if (position > edge) {
            position = edge;
        }
        Rect part = Rect(position, box.y, sizes[i], box.height);
        match (direction) {
            case Horizontal: {
            }
            case Vertical: {
                part = Rect(box.x, position, box.width, sizes[i]);
            }
        }
        out.push(part.intersect(box));
        position = position + sizes[i] + gap;
    }
    return out;
}

/// Cut `area` top to bottom. The short spelling of a vertical `Layout`.
pub List<Rect> rows(Rect area, List<Constraint> constraints) {
    return Layout(Direction.Vertical, constraints).split(area);
}

/// Cut `area` left to right. The short spelling of a horizontal `Layout`.
pub List<Rect> columns(Rect area, List<Constraint> constraints) {
    return Layout(Direction.Horizontal, constraints).split(area);
}
