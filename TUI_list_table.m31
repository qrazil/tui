// The two widgets that show more rows than they have room for.
//
// API
// ---
//   TUI_list_table.ListView(items)              a scrolling list with a selection
//   TUI_list_table.Table(header, rows, widths)  columns cut by `TUI_geometry.Constraint`
//
// Both keep their own `offset`, and both **move it when they draw**: a
// selection outside the visible window scrolls the window to it, because the
// widget is the only thing that knows how many rows fit. That is a field
// store on the widget's own struct, so the caller sees the new offset
// afterwards and can save it. Nothing else here changes anything.
//
// The type is `ListView` rather than `List` because `List` is a predeclared
// type name and nothing may shadow one (reference §4.1).

import TUI_buffer;
import TUI_geometry;
import TUI_style;
import TUI_text;

/// A vertical list of single-line items, with one of them selected.
///
/// ```
/// TUI_list_table.ListView(names, selected: 3, highlight_symbol: "> ")
/// ```
pub type ListView {
    pub List<str> items;
    /// Which item is selected, or -1 for none.
    pub int selected = -1;
    /// The first item shown. `render` moves it to keep the selection in view.
    pub int offset = 0;
    pub TUI_style.Style style = TUI_style.Style();
    /// Laid over `style` on the selected row.
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    /// Written before the selected item; its width is left blank before
    /// every other item, so the text lines up.
    pub str highlight_symbol = "";
    pub TUI_text.Align align = TUI_text.Align.Left;
}

/// Select item `i`, or nothing with -1. The offset follows at the next
/// `render`, which is the only place the height is known.
pub void ListView.select(int i) {
    selected = i;
}

/// Move the selection by `delta`, stopping at the ends.
pub void ListView.step(int delta) {
    int n = items.size();
    if (n == 0) {
        selected = -1;
        return;
    }
    int at = selected + delta;
    if (selected < 0 && delta > 0) {
        at = 0;
    }
    if (at < 0) {
        at = 0;
    }
    if (at >= n) {
        at = n - 1;
    }
    selected = at;
}

/// The offset that shows `selected` in a window `h` rows tall, clamped to
/// the list. `render` assigns this to `offset`.
pub int ListView.scrolled(int h) {
    int n = items.size();
    int top = offset;
    if (h <= 0 || n == 0) {
        return 0;
    }
    if (selected >= 0) {
        if (selected < top) {
            top = selected;
        }
        if (selected >= top + h) {
            top = selected - h + 1;
        }
    }
    int most = n - h;
    if (most < 0) {
        most = 0;
    }
    if (top > most) {
        top = most;
    }
    if (top < 0) {
        top = 0;
    }
    return top;
}

pub void ListView.render(TUI_buffer.Buffer buf, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buf.fill(area, " ", style);
    offset = scrolled(area.h);
    int pre = TUI_text.width(highlight_symbol);
    if (pre > area.w) {
        pre = area.w;
    }
    int i = 0;
    while (i < area.h) {
        int k = offset + i;
        if (k >= items.size()) {
            return;
        }
        int y = area.y + i;
        TUI_style.Style st = style;
        if (k == selected) {
            st = style.merged(highlight_style);
            buf.fill(TUI_geometry.Rect(area.x, y, area.w, 1), " ", st);
            buf.set_str(area.x, y, TUI_text.cut(highlight_symbol, pre), st);
        }
        int room = area.w - pre;
        if (room > 0) {
            str cell = TUI_text.fit(items[k], room, align);
            buf.set_str(area.x + pre, y, cell, st, max: room);
        }
        i = i + 1;
    }
}

/// A grid of text with a header row and column widths given as layout
/// constraints.
///
/// ```
/// TUI_list_table.Table(["name", "size"], rows,
///     [TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(8)])
/// ```
///
/// The columns are cut by `TUI_geometry.cols`, so every constraint and every rule
/// in `TUI_geometry` applies: a table whose columns do not fit shrinks them by
/// the documented order, and a cell too wide for its column is truncated
/// with an ellipsis rather than spilling into the next one.
///
/// An empty `header` means no header row. An empty `widths` divides the
/// space equally between as many columns as the widest row has.
pub type Table {
    pub List<str> header;
    pub List<List<str>> rows;
    pub List<TUI_geometry.Constraint> widths;
    /// Which row is selected, or -1 for none. The header is not a row.
    pub int selected = -1;
    pub int offset = 0;
    /// Blank columns between one column and the next.
    pub int col_spacing = 1;
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style header_style = TUI_style.Style(attrs: TUI_style.BOLD);
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    pub str highlight_symbol = "";
    /// One entry per column, or empty for all-left.
    pub List<TUI_text.Align> aligns = [];
}

/// How many columns the table has: as many as its widths, or as many as its
/// widest row.
pub int Table.columns() {
    if (widths.size() > 0) {
        return widths.size();
    }
    int n = header.size();
    for (List<str> r in rows) {
        if (r.size() > n) {
            n = r.size();
        }
    }
    return n;
}

/// Move the selection by `delta`, stopping at the ends.
pub void Table.step(int delta) {
    int n = rows.size();
    if (n == 0) {
        selected = -1;
        return;
    }
    int at = selected + delta;
    if (selected < 0 && delta > 0) {
        at = 0;
    }
    if (at < 0) {
        at = 0;
    }
    if (at >= n) {
        at = n - 1;
    }
    selected = at;
}

int Table.scrolled(int h) {
    int n = rows.size();
    int top = offset;
    if (h <= 0 || n == 0) {
        return 0;
    }
    if (selected >= 0) {
        if (selected < top) {
            top = selected;
        }
        if (selected >= top + h) {
            top = selected - h + 1;
        }
    }
    int most = n - h;
    if (most < 0) {
        most = 0;
    }
    if (top > most) {
        top = most;
    }
    if (top < 0) {
        top = 0;
    }
    return top;
}

TUI_text.Align Table.align_of(int c) {
    if (c < aligns.size()) {
        return aligns[c];
    }
    return TUI_text.Align.Left;
}

pub void Table.render(TUI_buffer.Buffer buf, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buf.fill(area, " ", style);
    int ncol = columns();
    if (ncol == 0) {
        return;
    }
    int pre = TUI_text.width(highlight_symbol);
    if (pre > area.w) {
        pre = area.w;
    }
    TUI_geometry.Rect grid = TUI_geometry.Rect(area.x + pre, area.y, area.w - pre, area.h);
    List<TUI_geometry.Constraint> cs = widths;
    if (cs.size() == 0) {
        cs = [];
        for (int c in 0 .. ncol) {
            cs.push(TUI_geometry.Constraint.Fill(1));
        }
    }
    List<TUI_geometry.Rect> cells = TUI_geometry.Layout(TUI_geometry.Direction.Horizontal, cs, spacing: col_spacing).split(TUI_geometry.Rect(grid.x, grid.y, grid.w, 1));
    int y = area.y;
    if (header.size() > 0) {
        draw_row(buf, cells, header, y, style.merged(header_style));
        y = y + 1;
    }
    int h = area.bottom() - y;
    if (h <= 0) {
        return;
    }
    offset = scrolled(h);
    for (int i in 0 .. h) {
        int k = offset + i;
        if (k >= rows.size()) {
            return;
        }
        TUI_style.Style st = style;
        if (k == selected) {
            st = style.merged(highlight_style);
            buf.fill(TUI_geometry.Rect(area.x, y, area.w, 1), " ", st);
            buf.set_str(area.x, y, TUI_text.cut(highlight_symbol, pre), st);
        }
        draw_row(buf, cells, rows[k], y, st);
        y = y + 1;
    }
}

void Table.draw_row(TUI_buffer.Buffer buf, List<TUI_geometry.Rect> cells, List<str> row, int y, TUI_style.Style st) {
    int c = 0;
    while (c < cells.size() && c < row.size()) {
        TUI_geometry.Rect box = cells[c];
        if (box.w > 0) {
            buf.set_str(box.x, y, TUI_text.fit(row[c], box.w, align_of(c)), st, max: box.w);
        }
        c = c + 1;
    }
}
