// The two widgets that show more rows than they have room for.
//
// API
// ---
//   TUI_list_table.ListView(items)              a scrolling list with a selection
//   TUI_list_table.Table(header, rows, widths)  columns cut by `TUI_geometry.Constraint`
//
// Both keep their own `offset`, and both **move it when they draw**: a
// selection outside the visible window scrolls the window to it, because the
// widget is the only thing that knows how many rows fit. That is a field
// store on the widget's own struct, so the caller sees the new offset
// afterwards and can save it. Nothing else here changes anything.
//
// The type is `ListView` rather than `List` because `List` is a predeclared
// type name and nothing may shadow one (reference §4.1).

import TUI_buffer;
import TUI_geometry;
import TUI_style;
import TUI_text;

/// A vertical list of single-line items, with one of them selected.
///
/// ```
/// TUI_list_table.ListView(names, selected: 3, highlight_symbol: "> ")
/// ```
pub type ListView {
    pub List<str> items;
    /// Which item is selected, or -1 for none.
    pub int selected = -1;
    /// The first item shown. `render` moves it to keep the selection in view.
    pub int offset = 0;
    pub TUI_style.Style style = TUI_style.Style();
    /// Laid over `style` on the selected row.
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    /// Written before the selected item; its width is left blank before
    /// every other item, so the text lines up.
    pub str highlight_symbol = "";
    pub TUI_text.Align align = TUI_text.Align.Left;
}

/// Select item `index`, or nothing with -1. The offset follows at the next
/// `render`, which is the only place the height is known.
pub void ListView.select(int index) {
    selected = index;
}

/// Move the selection by `delta`, stopping at the ends.
pub void ListView.step(int delta) {
    int item_count = items.size();
    if (item_count == 0) {
        selected = -1;
        return;
    }
    int target = selected + delta;
    if (selected < 0 && delta > 0) {
        target = 0;
    }
    if (target < 0) {
        target = 0;
    }
    if (target >= item_count) {
        target = item_count - 1;
    }
    selected = target;
}

/// The offset that shows `selected` in a window `height` rows tall, clamped to
/// the list. `render` assigns this to `offset`.
pub int ListView.scrolled(int height) {
    int item_count = items.size();
    int top = offset;
    if (height <= 0 || item_count == 0) {
        return 0;
    }
    if (selected >= 0) {
        if (selected < top) {
            top = selected;
        }
        if (selected >= top + height) {
            top = selected - height + 1;
        }
    }
    int most = item_count - height;
    if (most < 0) {
        most = 0;
    }
    if (top > most) {
        top = most;
    }
    if (top < 0) {
        top = 0;
    }
    return top;
}

pub void ListView.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    offset = scrolled(area.height);
    int pre = TUI_text.width(highlight_symbol);
    if (pre > area.width) {
        pre = area.width;
    }
    int screen_row = 0;
    while (screen_row < area.height) {
        int item_index = offset + screen_row;
        if (item_index >= items.size()) {
            return;
        }
        int y = area.y + screen_row;
        TUI_style.Style row_style = style;
        if (item_index == selected) {
            row_style = style.merged(highlight_style);
            buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", row_style);
            buffer.set_str(area.x, y, TUI_text.cut(highlight_symbol, pre), row_style);
        }
        int room = area.width - pre;
        if (room > 0) {
            str cell = TUI_text.fit(items[item_index], room, align);
            buffer.set_str(area.x + pre, y, cell, row_style, max: room);
        }
        screen_row = screen_row + 1;
    }
}

/// A grid of text with a header row and column widths given as layout
/// constraints.
///
/// ```
/// TUI_list_table.Table(["name", "size"], rows,
///     [TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(8)])
/// ```
///
/// The columns are cut by `TUI_geometry.columns`, so every constraint and every rule
/// in `TUI_geometry` applies: a table whose columns do not fit shrinks them by
/// the documented order, and a cell too wide for its column is truncated
/// with an ellipsis rather than spilling into the next one.
///
/// An empty `header` means no header row. An empty `widths` divides the
/// space equally between as many columns as the widest row has.
pub type Table {
    pub List<str> header;
    pub List<List<str>> rows;
    pub List<TUI_geometry.Constraint> widths;
    /// Which row is selected, or -1 for none. The header is not a row.
    pub int selected = -1;
    pub int offset = 0;
    /// Blank columns between one column and the next.
    pub int col_spacing = 1;
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style header_style = TUI_style.Style(attrs: TUI_style.BOLD);
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
    pub str highlight_symbol = "";
    /// One entry per column, or empty for all-left.
    pub List<TUI_text.Align> aligns = [];
}

/// How many columns the table has: as many as its widths, or as many as its
/// widest row.
pub int Table.columns() {
    if (widths.size() > 0) {
        return widths.size();
    }
    int widest = header.size();
    for (List<str> row in rows) {
        if (row.size() > widest) {
            widest = row.size();
        }
    }
    return widest;
}

/// Move the selection by `delta`, stopping at the ends.
pub void Table.step(int delta) {
    int row_count = rows.size();
    if (row_count == 0) {
        selected = -1;
        return;
    }
    int target = selected + delta;
    if (selected < 0 && delta > 0) {
        target = 0;
    }
    if (target < 0) {
        target = 0;
    }
    if (target >= row_count) {
        target = row_count - 1;
    }
    selected = target;
}

int Table.scrolled(int height) {
    int row_count = rows.size();
    int top = offset;
    if (height <= 0 || row_count == 0) {
        return 0;
    }
    if (selected >= 0) {
        if (selected < top) {
            top = selected;
        }
        if (selected >= top + height) {
            top = selected - height + 1;
        }
    }
    int most = row_count - height;
    if (most < 0) {
        most = 0;
    }
    if (top > most) {
        top = most;
    }
    if (top < 0) {
        top = 0;
    }
    return top;
}

TUI_text.Align Table.align_of(int column) {
    if (column < aligns.size()) {
        return aligns[column];
    }
    return TUI_text.Align.Left;
}

pub void Table.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", style);
    int ncol = columns();
    if (ncol == 0) {
        return;
    }
    int pre = TUI_text.width(highlight_symbol);
    if (pre > area.width) {
        pre = area.width;
    }
    TUI_geometry.Rect grid = TUI_geometry.Rect(area.x + pre, area.y, area.width - pre, area.height);
    List<TUI_geometry.Constraint> constraints = widths;
    if (constraints.size() == 0) {
        constraints = [];
        for (int column in 0 .. ncol) {
            constraints.push(TUI_geometry.Constraint.Fill(1));
        }
    }
    List<TUI_geometry.Rect> cells = TUI_geometry.Layout(TUI_geometry.Direction.Horizontal, constraints, spacing: col_spacing).split(TUI_geometry.Rect(grid.x, grid.y, grid.width, 1));
    int y = area.y;
    if (header.size() > 0) {
        draw_row(buffer, cells, header, y, style.merged(header_style));
        y = y + 1;
    }
    int body_height = area.bottom() - y;
    if (body_height <= 0) {
        return;
    }
    offset = scrolled(body_height);
    for (int i in 0 .. body_height) {
        int row_index = offset + i;
        if (row_index >= rows.size()) {
            return;
        }
        TUI_style.Style row_style = style;
        if (row_index == selected) {
            row_style = style.merged(highlight_style);
            buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", row_style);
            buffer.set_str(area.x, y, TUI_text.cut(highlight_symbol, pre), row_style);
        }
        draw_row(buffer, cells, rows[row_index], y, row_style);
        y = y + 1;
    }
}

void Table.draw_row(TUI_buffer.Buffer buffer, List<TUI_geometry.Rect> cells, List<str> row, int y, TUI_style.Style row_style) {
    int column = 0;
    while (column < cells.size() && column < row.size()) {
        TUI_geometry.Rect box = cells[column];
        if (box.width > 0) {
            buffer.set_str(box.x, y, TUI_text.fit(row[column], box.width, align_of(column)), row_style, max: box.width);
        }
        column = column + 1;
    }
}
