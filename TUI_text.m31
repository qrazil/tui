// Text measured in terminal columns: wrapping, alignment, truncation.
//
// API
// ---
//   TUI_text.Align                      Left | Center | Right
//   TUI_text.wrap(text, cols)              -> List<str>, greedy, width-aware
//   TUI_text.truncate(text, cols, ellipsis:) -> str, with an ellipsis
//   TUI_text.pad(text, cols, align)        -> str, to exactly `cols` if it is short
//   TUI_text.fit(text, cols, align)        -> str, truncated AND padded
//
// Everything here counts **terminal columns**, by `unicode.width`: a CJK
// ideograph is two, a combining mark is none, and an emoji sequence is one
// grapheme of two. `str.size()` counts bytes and `str.chars().size()` counts
// code points, and both are the wrong number for a grid.
//
// Nothing here ever splits a grapheme cluster. A line break, a truncation
// and a pad all land between two clusters, so `é` written as `e` + U+0301
// cannot come apart and an emoji cannot lose its skin tone.
//
// --- how wrapping breaks ----------------------------------------------------
//
// Greedy, left to right, and a line is broken:
//
//   - at a run of spaces, which is dropped;
//   - between two clusters when either is **two columns wide**, so Chinese,
//     Japanese and Korean text wraps although it has no spaces in it -- this
//     is the part a byte-counting wrapper gets wrong;
//   - inside a word that is longer than the whole line, which is cut at the
//     last cluster that fits. A URL is not made shorter by refusing to break
//     it.
//
// A cluster wider than the line -- a two-column character in a one-column
// space -- is put on a line of its own and overflows it, because there is no
// answer that both fits and keeps the text.
//
// `\n` in the input starts a new line, and an empty line stays an empty
// line: `wrap` answers one entry per output row, and a caller that joins the
// answer with `\n` gets its paragraph back with the same number of blank
// lines in it.

import unicode;

/// Where text sits in a space wider than it is.
pub enum Align {
    Left;
    Center;
    Right;
}

/// The default ellipsis: one column, and every terminal has it.
pub const str ELLIPSIS = "\u{2026}";

// --- measuring, with the fast path every UI needs ---------------------------
//
// `unicode.width` runs UAX #29 over the text: a state machine per code point
// and a binary search per cluster. That is the right answer and it is not
// cheap, and a terminal program asks it thousands of times a frame -- of
// strings that are almost always printable ASCII, where the answer is the
// byte count and every cluster is one byte.
//
// So both questions are asked here first as a byte scan, and only text with
// a byte outside 0x20..0x7E goes to `unicode`. The two agree by
// construction: in that range one byte is one code point, one code point is
// one grapheme cluster (no combining mark, no joiner is ASCII), and every
// cluster is one column wide.

/// Is every byte of `text` printable ASCII?
bool plain(str text) {
    int length = text.size();
    for (int i in 0 .. length) {
        int byte_value = text.byte_at(i);
        if (byte_value < ' ' || byte_value > '~') {
            return false;
        }
    }
    return true;
}

/// How many columns `text` takes: `unicode.width`, with the ASCII fast path.
pub int width(str text) {
    if (plain(text)) {
        return text.size();
    }
    return unicode.width(text);
}

/// The grapheme clusters of `text`: `unicode.graphemes`, with the same fast
/// path.
List<str> clusters(str text) {
    if (!plain(text)) {
        return unicode.graphemes(text);
    }
    List<str> out = [];
    int length = text.size();
    for (int i in 0 .. length) {
        out.push(text.substr(i, i + 1));
    }
    return out;
}

/// `text` broken into lines of at most `cols` columns. See the header for the
/// rules. `cols` below 1 is treated as 1.
pub List<str> wrap(str text, int cols) {
    int room = cols;
    if (room < 1) {
        room = 1;
    }
    List<str> out = [];
    for (str line in text.split("\n")) {
        str clean_line = line;
        if (clean_line.ends_with("\r")) {
            clean_line = clean_line.substr(0, clean_line.size() - 1);
        }
        wrap_line(out, clean_line, room);
    }
    return out;
}

void wrap_line(List<str> out, str line, int cols) {
    if (plain(line)) {
        wrap_plain(out, line, cols);
        return;
    }
    List<str> current = [];
    int cur_w = 0;
    List<str> word = [];
    int word_w = 0;
    int gap = 0;
    for (str cluster in clusters(line)) {
        int cluster_width = width(cluster);
        if (cluster == " " || cluster == "\t") {
            bool had = word.size() > 0;
            cur_w = flush(out, current, cur_w, word, word_w, gap, cols);
            if (had) {
                gap = 0;
            }
            word = [];
            word_w = 0;
            gap = gap + 1;
            if (cluster == "\t") {
                gap = gap + 3;
            }
            continue;
        }
        if (cluster_width >= 2) {
            // A wide cluster is a word of its own: CJK breaks anywhere.
            bool had = word.size() > 0;
            cur_w = flush(out, current, cur_w, word, word_w, gap, cols);
            if (had) {
                gap = 0;
            }
            word = [];
            word_w = 0;
            List<str> one = [cluster];
            cur_w = flush(out, current, cur_w, one, cluster_width, gap, cols);
            gap = 0;
            continue;
        }
        word.push(cluster);
        word_w = word_w + cluster_width;
    }
    cur_w = flush(out, current, cur_w, word, word_w, gap, cols);
    out.push(current.join(""));
}

/// `wrap_line` for a line that is all printable ASCII -- the usual case for
/// a commit message, a file path, a log line -- where a cluster is a byte
/// and a column, so there is no need to cut the line into one string per
/// character to find its words. A word is one substring (`flush` joins
/// whatever it is handed, so a line of words comes out the same as a line of
/// characters), except a word longer than the whole line, which `flush` cuts
/// cluster by cluster and so is handed to it that way. Only a space is a
/// separator here: a tab is not printable ASCII, so a line with one in it
/// never reaches this. The same breaks, in the same places, as the general
/// path above -- `tests.m31`'s wrapping cases are the proof.
void wrap_plain(List<str> out, str line, int cols) {
    List<str> current = [];
    int cur_w = 0;
    int gap = 0;
    int length = line.size();
    int index = 0;
    int start = 0;
    while (index <= length) {
        bool at_space = index < length && line.byte_at(index) == ' ';
        if (index == length || at_space) {
            int word_w = index - start;
            if (word_w > 0) {
                cur_w = flush(out, current, cur_w, plain_word(line, start, index, cols), word_w, gap, cols);
                gap = 0;
            }
            if (at_space) {
                gap = gap + 1;
            }
            start = index + 1;
        }
        index = index + 1;
    }
    out.push(current.join(""));
}

/// `line[from .. end]` as the list `flush` takes: one string, or -- when it
/// is wider than a whole line and `flush` will have to cut it -- one string
/// per character, which is what `clusters` would have made of it.
List<str> plain_word(str line, int from, int end, int cols) {
    if (end - from <= cols) {
        return [line.substr(from, end)];
    }
    List<str> out = [];
    for (int index in from .. end) {
        out.push(line.substr(index, index + 1));
    }
    return out;
}

/// Put `word` on `cur`, breaking the line first if it does not fit and
/// breaking the word itself if it is longer than a whole line. Answers the
/// new width of `cur`, which it changes in place.
int flush(List<str> out, List<str> current, int cur_w, List<str> word, int word_w, int gap, int cols) {
    if (word.size() == 0) {
        return cur_w;
    }
    int used = cur_w;
    int spaces = gap;
    if (used == 0) {
        spaces = 0;
    }
    if (used + spaces + word_w <= cols) {
        for (int i in 0 .. spaces) {
            current.push(" ");
        }
        for (str cluster in word) {
            current.push(cluster);
        }
        return used + spaces + word_w;
    }
    // It does not fit after what is already there. Start a new line, unless
    // the line is empty already -- then the word alone is too long.
    if (used > 0) {
        out.push(current.join(""));
        current.clear();
        used = 0;
    }
    if (word_w <= cols) {
        for (str cluster in word) {
            current.push(cluster);
        }
        return word_w;
    }
    // An unbreakable run longer than the line: cut it where it stops fitting.
    int line_w = 0;
    for (str cluster in word) {
        int cluster_width = width(cluster);
        if (line_w > 0 && line_w + cluster_width > cols) {
            out.push(current.join(""));
            current.clear();
            line_w = 0;
        }
        current.push(cluster);
        line_w = line_w + cluster_width;
    }
    return line_w;
}

/// `text` cut to at most `cols` columns, with `ellipsis` on the end to say it was.
///
/// Nothing is cut when it already fits. When even the ellipsis does not fit,
/// the text is cut to `cols` with no ellipsis -- one column of `...` says
/// nothing a bare cut does not.
pub str truncate(str text, int cols, str ellipsis = ELLIPSIS) {
    if (cols <= 0) {
        return "";
    }
    if (width(text) <= cols) {
        return text;
    }
    int ellipsis_width = width(ellipsis);
    if (ellipsis_width >= cols) {
        return cut(text, cols);
    }
    return cut(text, cols - ellipsis_width) + ellipsis;
}

/// The longest prefix of `text` that is at most `cols` columns, cut between
/// grapheme clusters.
pub str cut(str text, int cols) {
    if (cols <= 0) {
        return "";
    }
    // No encoding is narrower than one byte a column -- an East Asian wide
    // character is three bytes or four -- so fewer bytes than columns is
    // already the whole answer.
    if (text.size() <= cols) {
        return text;
    }
    if (plain(text)) {
        return text.substr(0, cols);
    }
    List<str> out = [];
    int used = 0;
    for (str cluster in clusters(text)) {
        int cluster_width = width(cluster);
        if (used + cluster_width > cols) {
            return out.join("");
        }
        out.push(cluster);
        used = used + cluster_width;
    }
    return out.join("");
}

/// `text` with its first `cols` columns removed, cut between grapheme
/// clusters -- `cut`'s complement, for a horizontally scrolled window into
/// text wider than the room for it. Dropping partway through a wide cluster
/// drops the whole cluster, the same "never split a cluster" rule `cut`
/// follows, rather than showing half of one.
pub str drop_columns(str text, int cols) {
    if (cols <= 0) {
        return text;
    }
    if (text.size() <= cols) {
        return "";
    }
    if (plain(text)) {
        return text.substr(cols, text.size());
    }
    List<str> out = [];
    int used = 0;
    for (str cluster in clusters(text)) {
        if (used < cols) {
            used = used + width(cluster);
            continue;
        }
        out.push(cluster);
    }
    return out.join("");
}

/// `text` padded with spaces to `cols` columns. Text already that wide or wider
/// is returned as it is -- padding never truncates, so that the two
/// decisions stay separate.
pub str pad(str text, int cols, Align align) {
    int text_width = width(text);
    if (text_width >= cols) {
        return text;
    }
    int room = cols - text_width;
    match (align) {
        case Left: {
            return text + " ".repeat(room);
        }
        case Right: {
            return " ".repeat(room) + text;
        }
        case Center: {
            int left = room / 2;
            return " ".repeat(left) + text + " ".repeat(room - left);
        }
    }
}

/// `text` in exactly `cols` columns: truncated if it is too long, padded if it
/// is too short. This is what a table cell wants.
pub str fit(str text, int cols, Align align, str ellipsis = ELLIPSIS) {
    return pad(truncate(text, cols, ellipsis: ellipsis), cols, align);
}

/// Where `text` starts, in columns, when it is placed in `cols` columns.
pub int offset(str text, int cols, Align align) {
    int text_width = width(text);
    if (text_width >= cols) {
        return 0;
    }
    match (align) {
        case Left: {
            return 0;
        }
        case Right: {
            return cols - text_width;
        }
        case Center: {
            return (cols - text_width) / 2;
        }
    }
}
