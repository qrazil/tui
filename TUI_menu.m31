// A popup keyed by "what does the next keypress do" -- the which-key
// overlay -- and its sibling, the transient menu, built on the SAME
// underlying primitive rather than as two unrelated components. See
// `apps/git/design.md`: "a follow-up with flags opens the transient... built
// on top of the same overlay primitive".
//
// API
// ---
//   TUI_menu.Item(key, label)                  one (key, label) pair
//   TUI_menu.WhichKey(title, items)             the popup alone
//   TUI_menu.Switch(key, label, flag)           one togglable flag
//   TUI_menu.Transient(title, base, switches)   WhichKey's sibling: switches
//                                              plus a live command preview
//   transient.toggle(key)                      flip the switch bound to `key`
//   transient.preview()          -> str        the literal command line, as
//                                              it would run right now
//
// --- the shared base ---------------------------------------------------------
//
// Both are a `Popup`: a titled box, sized to its content and centred in
// whatever area it is given, drawn as plain text rows. `WhichKey` fills it
// with `key  label` rows; `Transient` fills it with `[x] key  label` rows for
// each switch, a blank line, and the rendered command -- but the box, the
// title, the centring and the border are one piece of code, not two.

import TUI_buffer;
import TUI_geometry;
import TUI_style;
import TUI_text;
import TUI_widget;

/// One `(key, label)` pair -- one row of a `WhichKey` overlay.
pub type Item {
    pub str key;
    pub str label;
}

/// The shared base: a titled box, sized to its widest row and its title,
/// drawn centred in whatever area it is handed.
type Popup {
    str title;
    List<str> rows;
    TUI_style.Style style = TUI_style.Style();
    TUI_style.Style title_style = TUI_style.Style(attrs: TUI_style.BOLD);
    TUI_widget.Borders borders = TUI_widget.Borders.Rounded;
}

/// The box this popup needs, centred in `area` and never larger than it: as
/// wide as the title or the widest row plus the border and a column of
/// padding either side, as tall as the rows plus the border.
TUI_geometry.Rect Popup.sized(TUI_geometry.Rect area) {
    int box_width = TUI_text.width(title);
    for (str row in rows) {
        int row_width = TUI_text.width(row);
        if (row_width > box_width) {
            box_width = row_width;
        }
    }
    box_width = box_width + 4;
    if (box_width > area.width) {
        box_width = area.width;
    }
    int box_height = rows.size() + 2;
    if (box_height > area.height) {
        box_height = area.height;
    }
    int x = area.x + (area.width - box_width) / 2;
    int y = area.y + (area.height - box_height) / 2;
    return TUI_geometry.Rect(x, y, box_width, box_height);
}

void Popup.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    TUI_geometry.Rect box = sized(area);
    if (box.is_empty()) {
        return;
    }
    TUI_widget.Block block = TUI_widget.Block(title: title, borders: borders, style: style, title_style: title_style, pad_x: 1);
    block.render(buffer, box);
    TUI_geometry.Rect inner = block.inner(box);
    int row_index = 0;
    while (row_index < inner.height && row_index < rows.size()) {
        buffer.set_str(inner.x, inner.y + row_index, TUI_text.truncate(rows[row_index], inner.width), style, max: inner.width);
        row_index = row_index + 1;
    }
}

/// `key`, padded to `key_width` columns, two spaces, then `label` -- the row
/// layout both overlays use.
str keyed_row(str key, str label, int key_width) {
    return TUI_text.pad(key, key_width, TUI_text.Align.Left) + "  " + label;
}

int widest(List<str> keys) {
    int longest = 0;
    for (str key in keys) {
        int key_width = TUI_text.width(key);
        if (key_width > longest) {
            longest = key_width;
        }
    }
    return longest;
}

/// A popup of "what does the next keypress do" -- a list of `(key, label)`
/// pairs, sized and centred by the shared `Popup`.
///
/// ```
/// TUI_menu.WhichKey("commit", [TUI_menu.Item("c", "commit"),
///     TUI_menu.Item("a", "amend"), TUI_menu.Item("f", "fixup")])
/// ```
pub type WhichKey {
    pub str title;
    pub List<Item> items;
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style title_style = TUI_style.Style(attrs: TUI_style.BOLD);
}

Popup WhichKey.popup() {
    List<str> keys = [];
    for (Item item in items) {
        keys.push(item.key);
    }
    int key_width = widest(keys);
    List<str> popup_rows = [];
    for (Item item in items) {
        popup_rows.push(keyed_row(item.key, item.label, key_width));
    }
    return Popup(title, popup_rows, style: style, title_style: title_style);
}

pub void WhichKey.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    popup().render(buffer, area);
}

/// One togglable flag of a `Transient`: a key, a label to show for it, and
/// the literal command-line flag it contributes when it is on.
pub type Switch {
    pub str key;
    pub str label;
    pub str flag;
    pub bool is_on = false;
}

/// The which-key overlay's sibling: the same `Popup`, filled with togglable
/// switches instead of plain rows, plus a line showing the command exactly as
/// it would run right now.
///
/// `base` is the command with no flags -- `"commit"`, `"push"` -- and
/// `preview()` is `base` followed by the flag of every switch currently on,
/// in the order given. That string is both what is shown and what is meant
/// to actually run; there is deliberately no second copy of the logic that
/// decides which flags are active.
pub type Transient {
    pub str title;
    pub str base;
    pub List<Switch> switches;
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style title_style = TUI_style.Style(attrs: TUI_style.BOLD);
    pub TUI_style.Style preview_style = TUI_style.Style(attrs: TUI_style.DIM);
}

/// Flip the switch bound to `key`. Does nothing if no switch has that key.
pub void Transient.toggle(str key) {
    int index = 0;
    while (index < switches.size()) {
        if (switches[index].key == key) {
            switches[index].is_on = !switches[index].is_on;
            return;
        }
        index = index + 1;
    }
}

/// Is the switch bound to `key` currently on? False for a key with no switch.
pub bool Transient.is_on(str key) {
    for (Switch switch in switches) {
        if (switch.key == key) {
            return switch.is_on;
        }
    }
    return false;
}

/// The literal command line this transient would run right now.
pub str Transient.preview() {
    str command = base;
    for (Switch switch in switches) {
        if (switch.is_on) {
            command = command + " " + switch.flag;
        }
    }
    return command;
}

Popup Transient.popup() {
    List<str> keys = [];
    for (Switch switch in switches) {
        keys.push(switch.key);
    }
    int key_width = widest(keys);
    List<str> popup_rows = [];
    for (Switch switch in switches) {
        str mark = "[ ] ";
        if (switch.is_on) {
            mark = "[x] ";
        }
        popup_rows.push(mark + keyed_row(switch.key, switch.label, key_width));
    }
    popup_rows.push("");
    popup_rows.push(preview());
    return Popup(title, popup_rows, style: style, title_style: title_style);
}

pub void Transient.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    popup().render(buffer, area);
}
