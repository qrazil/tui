// The v0.3.0 widgets, run for real: tabs, a chart you can hover, an outline and
// a diff you can click and scroll, a text field, a gauge, a sparkline and a
// spinner, all through `TUI_app.Loop` with the mouse on.
//
//   ./build.sh examples/widgets.m31 -o /tmp/widgets && /tmp/widgets
//
// Keyboard first: Tab moves focus between the panels on screen, Left/Right
// change tabs when the tab row has focus, Up/Down and Enter work the outline
// and the diff, and typing goes to the text field when it has focus (Enter
// submits, Escape leaves it). q quits from anywhere but the text field, and
// Ctrl-Q from there too.
//
// The mouse does the same and more: click a tab, click a tab's x to close it,
// click or wheel the outline and the diff, double click a section to fold it,
// click in the text field to put the cursor there, and move the pointer over
// the chart to read a value (the terminal must report motion; most do).
//
// Like `browse.m31` this needs a terminal and a person, so it is not in the
// test corpus; check.sh checks that it compiles clean. What it drives is
// tested in tests/widgets.m31 against synthetic events, buffers and clocks.

import io;
import term;
import TUI_app;
import TUI_buffer;
import TUI_chart;
import TUI_diff_view;
import TUI_gauge;
import TUI_geometry;
import TUI_input;
import TUI_mouse;
import TUI_outline;
import TUI_sparkline;
import TUI_spinner;
import TUI_style;
import TUI_tabs;
import TUI_widget;

/// Everything on screen, and what the last event did. One object, reached by
/// the lambdas below that close over it: m31 has no mutable module state.
type State {
    TUI_mouse.Router router = TUI_mouse.Router();
    TUI_tabs.Tabs tabs = TUI_tabs.Tabs([TUI_tabs.Tab("Metrics"), TUI_tabs.Tab("Files"), TUI_tabs.Tab("Input"), TUI_tabs.Tab("Locked", is_disabled: true), TUI_tabs.Tab("Scratch", is_closable: true), TUI_tabs.Tab("Notes", is_closable: true)]);
    TUI_chart.Chart chart = TUI_chart.Chart([], x_axis: TUI_chart.Axis(title: "seconds"), y_axis: TUI_chart.Axis(title: "load"));
    TUI_outline.Outline outline = TUI_outline.Outline([TUI_outline.Node.section("wip", "Unstaged changes", [TUI_outline.Node.leaf("a", "modified: a.txt"), TUI_outline.Node.leaf("b", "modified: b.txt")]), TUI_outline.Node.section("staged", "Staged changes", [TUI_outline.Node.leaf("c", "new file: c.txt")]), TUI_outline.Node.leaf("stash", "stash@{0}: on main: wip")]);
    TUI_diff_view.DiffView diff = TUI_diff_view.DiffView([TUI_diff_view.Hunk("@@ -1,3 +1,4 @@", [TUI_diff_view.Line.context("fn main() {"), TUI_diff_view.Line.removed("    print(\"hello\");"), TUI_diff_view.Line.added("    print(\"hello, \u{4E16}\u{754C}\");"), TUI_diff_view.Line.added("    print(\"bye\");"), TUI_diff_view.Line.context("}")]), TUI_diff_view.Hunk("@@ -20,2 +21,2 @@", [TUI_diff_view.Line.context("// end"), TUI_diff_view.Line.removed("// old"), TUI_diff_view.Line.added("// new")])]);
    TUI_input.TextInput input = TUI_input.TextInput(placeholder: "type here; Enter submits", is_focused: false);
    TUI_spinner.Spinner spinner = TUI_spinner.Spinner(label: "working");
    List<str> lines = [];
    List<int> samples = [];
    int seed = 7;
    int ticks = 0;
    str status = "";
}

/// The next pseudo-random sample, 0 .. 99: the demo's stand-in for a load.
int State.next_sample() {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return (seed / 65536) % 100;
}

/// What the tab row is showing: its title, or "" with none.
str State.tab_title() {
    match (tabs.current()) {
        case Some(TUI_tabs.Tab tab): {
            return tab.title;
        }
        case None: {
            return "";
        }
    }
}

/// The datasets for the chart: the samples so far, and their running mean.
void State.refresh_chart() {
    List<float> raw = [];
    List<float> mean = [];
    int total = 0;
    for (int index in 0 .. samples.size()) {
        total = total + samples[index];
        raw.push(float(samples[index]));
        mean.push(float(total) / float(index + 1));
    }
    chart.datasets = [TUI_chart.Dataset.of_values("load", raw), TUI_chart.Dataset.of_values("mean", mean, style: TUI_style.Style(attrs: TUI_style.BOLD))];
}

/// A rectangle's registration on the router, and its draw.
void State.place(str id, TUI_geometry.Rect area, bool is_focusable = true) {
    router.add(id, area, is_focusable: is_focusable);
}

/// The frame. The router forgets last frame's regions, and each panel drawn
/// registers itself again, so a click is always matched against what the user
/// was looking at.
void State.draw(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    router.begin_frame();
    List<TUI_geometry.Rect> band = TUI_geometry.rows(area, [TUI_geometry.Constraint.Length(1), TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(1)]);
    tabs.render(buffer, band[0]);
    place("tabs", band[0]);
    str title = tab_title();
    if (title == "Metrics") {
        draw_metrics(buffer, band[1]);
    } else if (title == "Files") {
        draw_files(buffer, band[1]);
    } else if (title == "Input") {
        draw_input(buffer, band[1]);
    } else {
        TUI_widget.Paragraph("Nothing here: " + title + ".").render(buffer, band[1]);
    }
    TUI_style.Style rev = TUI_style.Style(attrs: TUI_style.REVERSE);
    buffer.fill(band[2], " ", rev);
    TUI_geometry.Rect spin_area = TUI_geometry.Rect(band[2].right() - 12, band[2].y, 12, 1);
    spinner.render(buffer, spin_area);
    buffer.set_str(band[2].x + 1, band[2].y, "Tab focus  q quit  " + status, rev);
}

void State.draw_metrics(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    List<TUI_geometry.Rect> parts = TUI_geometry.columns(area, [TUI_geometry.Constraint.Fill(1), TUI_geometry.Constraint.Length(28)]);
    TUI_widget.Block frame = TUI_widget.Block(title: "load (hover)", borders: TUI_widget.Borders.Rounded);
    frame.render(buffer, parts[0]);
    chart.render(buffer, frame.inner(parts[0]));
    place("chart", frame.inner(parts[0]));
    List<TUI_geometry.Rect> side = TUI_geometry.rows(parts[1], [TUI_geometry.Constraint.Length(3), TUI_geometry.Constraint.Length(3), TUI_geometry.Constraint.Fill(1)]);
    TUI_widget.Block gauge_frame = TUI_widget.Block(title: "progress", borders: TUI_widget.Borders.Single);
    gauge_frame.render(buffer, side[0]);
    TUI_gauge.Gauge.of_percent(ticks % 101).render(buffer, gauge_frame.inner(side[0]));
    TUI_widget.Block spark_frame = TUI_widget.Block(title: "recent", borders: TUI_widget.Borders.Single);
    spark_frame.render(buffer, side[1]);
    TUI_sparkline.Sparkline.of_ints(samples).render(buffer, spark_frame.inner(side[1]));
}

void State.draw_files(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    List<TUI_geometry.Rect> parts = TUI_geometry.columns(area, [TUI_geometry.Constraint.Percentage(40), TUI_geometry.Constraint.Fill(1)]);
    TUI_widget.Block left = TUI_widget.Block(title: "changes", borders: TUI_widget.Borders.Rounded);
    left.render(buffer, parts[0]);
    outline.render(buffer, left.inner(parts[0]));
    place("outline", left.inner(parts[0]));
    TUI_widget.Block right = TUI_widget.Block(title: "diff", borders: TUI_widget.Borders.Single);
    right.render(buffer, parts[1]);
    diff.render(buffer, right.inner(parts[1]));
    place("diff", right.inner(parts[1]));
}

void State.draw_input(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    List<TUI_geometry.Rect> parts = TUI_geometry.rows(area, [TUI_geometry.Constraint.Length(3), TUI_geometry.Constraint.Fill(1)]);
    TUI_widget.Block frame = TUI_widget.Block(title: "name", borders: TUI_widget.Borders.Rounded);
    frame.render(buffer, parts[0]);
    input.is_focused = router.is_focused("input");
    input.render(buffer, frame.inner(parts[0]));
    place("input", frame.inner(parts[0]));
    TUI_widget.Paragraph(lines.join("\n")).render(buffer, parts[1]);
}

/// Time passing: the spinner and the gauge move, the chart gets a sample.
TUI_app.Action State.tick(int elapsed_ms) {
    bool did_change = spinner.did_advance(elapsed_ms);
    ticks = ticks + 1;
    samples.push(next_sample());
    if (samples.size() > 60) {
        samples.remove_at(0);
    }
    refresh_chart();
    if (did_change || tab_title() == "Metrics") {
        return TUI_app.Action.Redraw;
    }
    return TUI_app.Action.Continue;
}

/// One routed gesture, to the panel it is for.
TUI_app.Action State.mouse(TUI_mouse.Routed routed) {
    status = routed.gesture.to_str();
    if (routed.id == "tabs") {
        match (tabs.handle_mouse(routed.gesture, routed.area)) {
            case Ignored: {
                return TUI_app.Action.Continue;
            }
            case Changed: {
                return TUI_app.Action.Redraw;
            }
            case Selected(int index): {
                return TUI_app.Action.Redraw;
            }
            case CloseRequested(int index): {
                tabs.close(index);
                return TUI_app.Action.Redraw;
            }
        }
    }
    if (routed.id == "outline") {
        return redraw_if_changed(outline.handle_mouse(routed.gesture, routed.area));
    }
    if (routed.id == "diff") {
        return redraw_if_changed(diff.handle_mouse(routed.gesture, routed.area));
    }
    if (routed.id == "input") {
        return redraw_if_changed(input.handle_mouse(routed.gesture, routed.area));
    }
    if (routed.id == "chart") {
        return redraw_if_changed(chart.handle_mouse(routed.gesture, routed.area));
    }
    return TUI_app.Action.Redraw;
}

TUI_app.Action State.key(term.Event event, term.Key key) {
    int which = classify(key);
    if (which == -2) {
        router.focus_next();
        return TUI_app.Action.Redraw;
    }
    if (which == -3) {
        router.focus_previous();
        return TUI_app.Action.Redraw;
    }
    if (router.is_focused("input")) {
        if (which == 'q' && (key.mods & term.CTRL) != 0) {
            return TUI_app.Action.Quit;
        }
        match (input.handle(event)) {
            case Ignored: {
                return TUI_app.Action.Continue;
            }
            case Changed: {
                return TUI_app.Action.Redraw;
            }
            case Submitted: {
                lines.push("hello, " + input.take());
                return TUI_app.Action.Redraw;
            }
            case Cancelled: {
                router.focus("tabs");
                return TUI_app.Action.Redraw;
            }
            case Rejected(str why): {
                return TUI_app.Action.Redraw;
            }
        }
    }
    if (which == 'q') {
        return TUI_app.Action.Quit;
    }
    if (router.is_focused("tabs")) {
        if (which == -7) {
            tabs.did_select_previous();
            return TUI_app.Action.Redraw;
        }
        if (which == -8) {
            tabs.did_select_next();
            return TUI_app.Action.Redraw;
        }
    }
    if (router.is_focused("outline")) {
        if (which == -4) {
            outline.move(-1);
            return TUI_app.Action.Redraw;
        }
        if (which == -5) {
            outline.move(1);
            return TUI_app.Action.Redraw;
        }
        if (which == -6) {
            outline.toggle();
            return TUI_app.Action.Redraw;
        }
    }
    if (router.is_focused("diff")) {
        if (which == -4) {
            diff.move(-1);
            return TUI_app.Action.Redraw;
        }
        if (which == -5) {
            diff.move(1);
            return TUI_app.Action.Redraw;
        }
    }
    return TUI_app.Action.Continue;
}

TUI_app.Action State.handle(term.Event event) {
    match (event) {
        case Key(term.Key pressed): {
            return key(event, pressed);
        }
        case Paste(str pasted): {
            if (router.is_focused("input")) {
                input.paste(pasted);
                return TUI_app.Action.Redraw;
            }
            return TUI_app.Action.Continue;
        }
        case Mouse(term.Mouse reported): {
            return TUI_app.Action.Continue;
        }
        case Unknown(bytes raw_bytes): {
            return TUI_app.Action.Continue;
        }
    }
}

/// What a widget's answer to a gesture means for the loop.
TUI_app.Action redraw_if_changed(TUI_mouse.Response response) {
    match (response) {
        case Ignored: {
            return TUI_app.Action.Continue;
        }
        case Changed: {
            return TUI_app.Action.Redraw;
        }
        case Activated: {
            return TUI_app.Action.Redraw;
        }
    }
}

/// What a key is, for the few the demo cares about: a character's code point
/// (0 and up), or a negative number for Tab, Back-tab, Up, Down, Enter, Left,
/// Right, Escape; -1 for any other key.
int classify(term.Key key) {
    match (key.code) {
        case Char(int character): {
            return character;
        }
        case Tab: {
            return -2;
        }
        case BackTab: {
            return -3;
        }
        case Up: {
            return -4;
        }
        case Down: {
            return -5;
        }
        case Enter: {
            return -6;
        }
        case Left: {
            return -7;
        }
        case Right: {
            return -8;
        }
        case Escape: {
            return -9;
        }
        case Backspace: {
            return -1;
        }
        case Home: {
            return -1;
        }
        case End: {
            return -1;
        }
        case PageUp: {
            return -1;
        }
        case PageDown: {
            return -1;
        }
        case Insert: {
            return -1;
        }
        case Delete: {
            return -1;
        }
        case F(int number): {
            return -1;
        }
    }
}

if (!term.is_terminal(0)) {
    io.eprint("widgets: standard input is not a terminal");
    return;
}
State state = State();
state.router.focus("tabs");
TUI_app.Loop loop = TUI_app.Loop(should_report_mouse: true, should_report_hover: true, should_report_paste: true, animate_ms: 100, router: state.router);
match (loop.run_with((TUI_buffer.Buffer buffer, TUI_geometry.Rect area) => state.draw(buffer, area), (term.Event event) => state.handle(event), (int elapsed_ms) => state.tick(elapsed_ms), (TUI_mouse.Routed routed) => state.mouse(routed))) {
    case Ok(int frame_count): {
    }
    case Err(term.Error error): {
        io.eprint("widgets: " + error.to_str());
    }
}
print("bye");
