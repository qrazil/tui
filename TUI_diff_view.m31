// A diff, rendered with a cursor addressable down to the hunk and the line.
// See `apps/git/design.md`: "cursor-addressable staging... whatever is under
// the cursor is what gets staged" -- which means a client needs to ask,
// precisely, "what is under the cursor right now", and this is what answers
// that question at the granularity staging actually needs.
//
// API
// ---
//   TUI_diff_view.Kind          Context | Add | Remove -- what one line is
//   TUI_diff_view.Line(kind, text)     one line of a hunk's body
//   TUI_diff_view.Hunk(header, lines)  one `@@ ... @@` block
//   TUI_diff_view.DiffView(hunks)      the widget: cursor, scroll, render
//   view.at()           -> Option<Row>   what the cursor is on, right now
//   view.count()        -> int           how many rows, without building them
//   view.move(delta), view.render(buf, area)
//
// --- what a `Row` addresses ---------------------------------------------------
//
// The flattened view is a hunk's header, then its lines, then the next
// hunk's header, and so on. `at()` answers which of those the cursor sits
// on: `RowKind.Header` with the hunk's index, or `RowKind.Body` with the
// hunk's index AND the line's index inside it -- hunk and line, exactly the
// two numbers `apps/git/design.md` says staging depends on. A caller stages
// the hunk when it is a `Header`, or exactly that one line when it is a
// `Body`; deciding that is the caller's, not this widget's.

import TUI_buffer;
import TUI_geometry;
import TUI_scroll;
import TUI_style;
import TUI_text;

/// What one line of a hunk's body is.
pub enum Kind {
    Context;
    Add;
    Remove;
}

/// One line of a hunk's body, with the leading `+`/`-`/` ` already stripped --
/// `kind` is that marker, structured.
pub type Line {
    pub Kind kind;
    pub str text;
}

/// A line unchanged by the hunk.
pub static Line Line.context(str text) {
    return Line(Kind.Context, text);
}

/// A line the hunk adds.
pub static Line Line.added(str text) {
    return Line(Kind.Add, text);
}

/// A line the hunk removes.
pub static Line Line.removed(str text) {
    return Line(Kind.Remove, text);
}

/// One `@@ ... @@` block: its header text, as a diff prints it, and the
/// lines under it.
pub type Hunk {
    pub str header;
    pub List<Line> lines;
}

/// Which kind of row the flattened view holds: a hunk's own header line, or
/// one line of its body.
pub enum RowKind {
    Header;
    Body;
}

/// One row of the flattened view, and the addressing `at()` answers: `hunk`
/// is always meaningful, `line` only when `kind` is `Body`.
pub type Row {
    pub RowKind kind;
    pub int hunk;
    pub int line;
}

/// The widget: a list of `Hunk`s, a cursor into the flattened rows (headers
/// and lines together), and the scroll that follows it.
pub type DiffView {
    pub List<Hunk> hunks;
    pub int cursor = 0;
    pub TUI_scroll.Viewport view = TUI_scroll.Viewport();
    pub TUI_style.Style header_style = TUI_style.Style(attrs: TUI_style.BOLD);
    pub TUI_style.Style add_style = TUI_style.Style(foreground: TUI_style.Colour.Indexed(2));
    pub TUI_style.Style remove_style = TUI_style.Style(foreground: TUI_style.Colour.Indexed(1));
    pub TUI_style.Style context_style = TUI_style.Style();
    pub TUI_style.Style highlight_style = TUI_style.Style(attrs: TUI_style.REVERSE);
}

/// The flattened rows: every hunk's header, followed by its lines, in order.
pub List<Row> DiffView.rows() {
    List<Row> out = [];
    int hunk_index = 0;
    while (hunk_index < hunks.size()) {
        out.push(Row(RowKind.Header, hunk_index, -1));
        int line_index = 0;
        while (line_index < hunks[hunk_index].lines.size()) {
            out.push(Row(RowKind.Body, hunk_index, line_index));
            line_index = line_index + 1;
        }
        hunk_index = hunk_index + 1;
    }
    return out;
}

/// How many rows `rows()` would answer, without building them: one per
/// hunk header, plus every hunk's lines. A diff of thousands of lines is
/// moved through, asked about and redrawn once per keystroke, and each of
/// those used to flatten the whole thing to read one row of it -- so the
/// three operations below walk the hunks (a few dozen) rather than the
/// rows (a few thousand), the same way `TUI_outline` does.
pub int DiffView.count() {
    int row_count = 0;
    for (Hunk hunk in hunks) {
        row_count = row_count + 1 + hunk.lines.size();
    }
    return row_count;
}

/// The row at index `index` of the flattened view, or `None` -- by walking the
/// hunks' sizes, not by building the rows.
Option<Row> DiffView.row_at(int index) {
    if (index < 0) {
        return Option<Row>.None;
    }
    int left = index;
    int hunk_index = 0;
    while (hunk_index < hunks.size()) {
        if (left == 0) {
            return Option<Row>.Some(Row(RowKind.Header, hunk_index, -1));
        }
        left = left - 1;
        int line_count = hunks[hunk_index].lines.size();
        if (left < line_count) {
            return Option<Row>.Some(Row(RowKind.Body, hunk_index, left));
        }
        left = left - line_count;
        hunk_index = hunk_index + 1;
    }
    return Option<Row>.None;
}

/// What is under the cursor right now -- a hunk header, or a particular
/// line of a particular hunk -- or `None` when the diff is empty.
pub Option<Row> DiffView.at() {
    return row_at(cursor);
}

/// Move the cursor by `delta` rows of the flattened view, stopping at the
/// ends.
pub void DiffView.move(int delta) {
    int row_count = count();
    if (row_count == 0) {
        cursor = 0;
        return;
    }
    int target = cursor + delta;
    if (target < 0) {
        target = 0;
    }
    if (target >= row_count) {
        target = row_count - 1;
    }
    cursor = target;
}

TUI_style.Style DiffView.line_style(Line line) {
    match (line.kind) {
        case Context: {
            return context_style;
        }
        case Add: {
            return add_style;
        }
        case Remove: {
            return remove_style;
        }
    }
}

str DiffView.marker(Line line) {
    match (line.kind) {
        case Context: {
            return " ";
        }
        case Add: {
            return "+";
        }
        case Remove: {
            return "-";
        }
    }
}

pub void DiffView.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    buffer.fill(area, " ", context_style);
    int total = count();
    if (cursor >= total) {
        cursor = total - 1;
    }
    if (cursor < 0) {
        cursor = 0;
    }
    view.reveal(cursor, total, area.height);
    view.offset = view.clamped(total, area.height);
    int off = view.offset;
    // Find the first row on screen once, then step through the hunks in
    // order: `hunk_index`/`line_index` are the row's hunk and line,
    // `line_index` of -1 being its header.
    int hunk_index = 0;
    int line_index = -1;
    match (row_at(off)) {
        case Some(Row first): {
            hunk_index = first.hunk;
            line_index = first.line;
        }
        case None: {
            return;
        }
    }
    int screen_row = 0;
    while (screen_row < area.height) {
        int row_index = off + screen_row;
        if (row_index >= total) {
            return;
        }
        int y = area.y + screen_row;
        str text = "";
        TUI_style.Style row_style = context_style;
        if (line_index < 0) {
            text = hunks[hunk_index].header;
            row_style = header_style;
        } else {
            Line line = hunks[hunk_index].lines[line_index];
            text = marker(line) + line.text;
            row_style = line_style(line);
        }
        if (row_index == cursor) {
            row_style = row_style.merged(highlight_style);
            buffer.fill(TUI_geometry.Rect(area.x, y, area.width, 1), " ", row_style);
        }
        buffer.set_str(area.x, y, TUI_text.truncate(text, area.width), row_style, max: area.width);
        if (line_index + 1 < hunks[hunk_index].lines.size()) {
            line_index = line_index + 1;
        } else {
            hunk_index = hunk_index + 1;
            line_index = -1;
        }
        screen_row = screen_row + 1;
    }
}
