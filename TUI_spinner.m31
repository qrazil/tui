// A spinner: a small animation that says "working", and nothing about how far.
//
// API
// ---
//   TUI_spinner.Spinner(set:, label:, style:, ...)    a Widget
//   TUI_spinner.Set  Braille | Line | Dots | Arc | Bounce | Ascii
//   spinner.start() / stop() / reset()                 is it animating?
//   spinner.did_advance(elapsed_ms) -> bool                feed it time; true if the frame changed
//   spinner.did_tick() -> bool                             one frame step, no clock
//   spinner.frame()                                    the glyph for now
//   spinner.interval_ms()                              how often it wants `did_advance` called
//   spinner.is_spinning()
//
// --- time, without a clock --------------------------------------------------
//
// A `Spinner` has no clock of its own and never sleeps. A program tells it how
// much time has gone by (`did_advance`) and it keeps the remainder, so a frame
// every 80 ms comes out right whether the caller ticks every 80 ms, every
// 250 ms (three frames at once, which is a skipped-forward animation and not a
// lag) or every 1 ms. `TUI_app.Loop.run_with` is the caller that matters: it
// computes how long until the next frame is due and gives that, no less than a
// millisecond, to the input read as its timeout, so an animating program wakes
// exactly when a frame is due and sleeps in the kernel the rest of the time.
// `did_advance` returns whether the frame changed, which is the answer to "do I
// redraw?".
//
// A stopped spinner draws `idle_symbol` (a space unless set) and `did_advance`
// ignores time, so a stopped spinner costs no redraws. `stop` keeps the
// phase and `start` carries on from it; `reset` returns to the first frame.
//
// --- the sets ---------------------------------------------------------------
//
//   Braille  ⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏   the usual one; needs a font with braille
//   Line     │ ╱ ─ ╲         box-drawing line that turns
//   Dots     ⣾⣽⣻⢿⡿⣟⣯⣷       eight braille dots circling
//   Arc      ◜◠◝◞◡◟          a quarter-circle chasing round
//   Bounce   ⠁⠂⠄⡀⢀⠠⠐⠈      one dot bouncing
//   Ascii    - \ | /         the fallback for a terminal with no Unicode: only
//                            characters from 0x20 to 0x7E
//
// `Ascii` is the one to pick when the fallback is the point; a test checks that
// its frames are plain ASCII.
//
// --- drawing ----------------------------------------------------------------
//
// The glyph goes in the first cell of the area, then a space, then the label,
// truncated to the width. A zero-sized area draws nothing. A 1-wide area draws
// the glyph alone.

import TUI_buffer;
import TUI_clip;
import TUI_geometry;
import TUI_style;
import TUI_text;

pub enum Set {
    Braille;
    Line;
    Dots;
    Arc;
    Bounce;
    Ascii;
}

/// The frames of a set, in order.
pub List<str> frames_of(Set set) {
    match (set) {
        case Braille: {
            return ["\u{280B}", "\u{2819}", "\u{2839}", "\u{2838}", "\u{283C}", "\u{2834}", "\u{2826}", "\u{2827}", "\u{2807}", "\u{280F}"];
        }
        case Line: {
            return ["\u{2502}", "\u{2571}", "\u{2500}", "\u{2572}"];
        }
        case Dots: {
            return ["\u{28FE}", "\u{28FD}", "\u{28FB}", "\u{28BF}", "\u{287F}", "\u{28DF}", "\u{28EF}", "\u{28F7}"];
        }
        case Arc: {
            return ["\u{25DC}", "\u{25E0}", "\u{25DD}", "\u{25DE}", "\u{25E1}", "\u{25DF}"];
        }
        case Bounce: {
            return ["\u{2801}", "\u{2802}", "\u{2804}", "\u{2840}", "\u{2880}", "\u{2820}", "\u{2810}", "\u{2808}"];
        }
        case Ascii: {
            return ["-", "\\", "|", "/"];
        }
    }
}

/// The time each frame of a set stays up, in milliseconds.
pub int default_interval_ms(Set set) {
    match (set) {
        case Braille: {
            return 80;
        }
        case Line: {
            return 100;
        }
        case Dots: {
            return 80;
        }
        case Arc: {
            return 100;
        }
        case Bounce: {
            return 120;
        }
        case Ascii: {
            return 100;
        }
    }
}

pub type Spinner {
    pub Set set = Set.Braille;
    pub str label = "";
    pub TUI_style.Style style = TUI_style.Style();
    pub TUI_style.Style label_style = TUI_style.Style();
    /// Drawn, in place of a frame, while stopped.
    pub str idle_symbol = " ";
    /// 0 takes the set's own pace.
    pub int frame_ms = 0;
    pub bool is_running = true;
    /// Which frame is up, and how much of the next one's time has gone.
    pub int step = 0;
    pub int carried_ms = 0;
}

pub bool Spinner.is_spinning() {
    return is_running;
}

pub void Spinner.start() {
    is_running = true;
}

pub void Spinner.stop() {
    is_running = false;
    carried_ms = 0;
}

pub void Spinner.reset() {
    step = 0;
    carried_ms = 0;
}

/// How long a frame stays up.
pub int Spinner.interval_ms() {
    if (frame_ms > 0) {
        return frame_ms;
    }
    return default_interval_ms(set);
}

/// How many milliseconds until the next frame is due: the whole interval minus
/// what has been carried over. 0 for a stopped spinner, which is never due.
pub int Spinner.due_in_ms() {
    if (!is_running) {
        return 0;
    }
    int left = interval_ms() - carried_ms;
    if (left < 1) {
        return 1;
    }
    return left;
}

/// Step to the next frame. Returns true when it moved (a stopped spinner does
/// not).
pub bool Spinner.did_tick() {
    if (!is_running) {
        return false;
    }
    step = (step + 1) % frames_of(set).size();
    return true;
}

/// Account for `elapsed_ms` having gone by; step one frame for each whole
/// interval in it. True when the frame on show is now different. A negative
/// `elapsed_ms` counts as none.
pub bool Spinner.did_advance(int elapsed_ms) {
    if (!is_running || elapsed_ms <= 0) {
        return false;
    }
    int interval = interval_ms();
    int total = carried_ms + elapsed_ms;
    int steps = total / interval;
    carried_ms = total % interval;
    if (steps == 0) {
        return false;
    }
    int count = frames_of(set).size();
    int before = step;
    step = (step + steps) % count;
    return step != before;
}

/// The glyph on show now: the current frame, or `idle_symbol` when stopped.
pub str Spinner.frame() {
    if (!is_running) {
        return idle_symbol;
    }
    List<str> all = frames_of(set);
    return all[step % all.size()];
}

pub void Spinner.render(TUI_buffer.Buffer buffer, TUI_geometry.Rect area) {
    if (area.is_empty()) {
        return;
    }
    TUI_clip.paint(buffer, area, area, " ", label_style);
    str glyph = frame();
    TUI_clip.put_str(buffer, area, area.x, area.y, glyph, style);
    if (label != "" && area.width > 2) {
        TUI_clip.put_str(buffer, area, area.x + 2, area.y, TUI_text.truncate(label, area.width - 2), label_style);
    }
}
